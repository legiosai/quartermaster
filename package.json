{
  "name": "@legios/quartermaster",
  "version": "0.1.1",
  "description": "Cuánta cuota te queda en TODOS los perfiles de Claude Code de la máquina, más Codex y los proveedores de opencode. Sin red y sin credenciales: el número sale del cache que Claude Code deja en disco.",
  "keywords": [
    "claude-code",
    "claude",
    "codex",
    "opencode",
    "quota",
    "rate-limit",
    "usage",
    "cli",
    "statusline",
    "gnome",
    "macos"
  ],
  "license": "MIT",
  "author": "Legios",
  "homepage": "https://github.com/legiosai/quartermaster#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/legiosai/quartermaster.git"
  },
  "bugs": {
    "url": "https://github.com/legiosai/quartermaster/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.6"
  },
  "bin": {
    "qm": "bin/qm"
  },
  "files": [
    "bin/",
    "src/",
    "scripts/",
    "extension/",
    "Makefile",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "node scripts/nodo.cjs && tsc --noEmit",
    "test": "node scripts/nodo.cjs && node --experimental-strip-types --test test/*.test.ts",
    "qm": "node scripts/nodo.cjs && node --experimental-strip-types src/cli/qm.ts",
    "demo-h0": "node scripts/nodo.cjs && node --experimental-strip-types src/cli/preflight.ts",
    "demo-h1": "node scripts/nodo.cjs && node --experimental-strip-types src/cli/demo-h1.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
