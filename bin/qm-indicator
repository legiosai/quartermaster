#!/usr/bin/env python3
"""qm en la barra de arriba de GNOME.

Es la parte de "renderizado" que SOUL.md dejaba para después de tener los
números bien. Dibuja y nada más: le pide el JSON a `qm` y no sabe qué es una
credencial ni habla HTTP.

Tres cosas que lo hacen algo más que un reloj:

  · Se entera solo. Vigila el .claude.json de cada perfil con Gio.FileMonitor,
    así que cuando Claude Code refresca la cuota el número cambia en el acto en
    vez de esperar al próximo minuto. El sondeo lento queda de red de seguridad.
  · Avisa sin que lo mires. Notifica al cruzar 80 % y 95 %, y cuando la
    proyección pasa a decir que tocás el techo ANTES del reinicio — que es el
    momento útil para enterarte, no cuando ya chocaste.
  · No repite. Cada aviso se recuerda por (perfil, barra, reinicio), así que
    una ventana avisa una vez y vuelve a avisar recién en la siguiente.

Requiere el soporte de AppIndicator en GNOME (la extensión
appindicatorsupport@rgcjonas.gmail.com), que es lo que convierte un
KStatusNotifierItem en un item de la barra.
"""

import json
import math
import os
import pathlib
import shutil
import subprocess
import sys
from datetime import datetime, timezone
from pathlib import Path

# El panel se abre pegado a la barra, y para eso hay que poder decir DÓNDE va la
# ventana. En Wayland un cliente no puede: la ubica el compositor, y un panel que
# aparece en el medio de la pantalla no es el panel que se está copiando. Sobre
# XWayland sí se puede, y al item de la barra no le cambia nada porque es DBus
# puro. Si no hay X11 a mano se sigue por Wayland y el panel cae donde caiga.
if os.environ.get("DISPLAY") and not os.environ.get("QM_SIN_X11"):
    os.environ.setdefault("GDK_BACKEND", "x11")

import cairo  # noqa: E402
import gi  # noqa: E402

gi.require_version("Gtk", "3.0")
gi.require_version("Pango", "1.0")
gi.require_version("PangoCairo", "1.0")
gi.require_version("AyatanaAppIndicator3", "0.1")
from gi.repository import AyatanaAppIndicator3 as AppIndicator  # noqa: E402
from gi.repository import Gdk, Gio, GLib, Gtk, Pango, PangoCairo  # noqa: E402


ID = "quartermaster"
# Red de seguridad: el FileMonitor es el que manda. Esto sólo cubre el caso de
# un monitor que se pierda un evento (montajes raros, archivos reemplazados).
SEGUNDOS_SONDEO = 300
# Piso para cualquier cadencia que salga a la RED. Claude Code pide la cuota del
# orden de una vez por sesión; un endpoint no documentado, que además puede
# desaparecer sin aviso, no es lugar para sondear más rápido que esto. Y la
# diferencia real es chica: a 1,6 puntos por minuto, 60 s son 1,6 puntos de
# atraso.
MINIMO_RED = 60
# Coalescer escrituras: Claude Code reescribe .claude.json varias veces seguidas.
DEBOUNCE_MS = 1500
UMBRALES = (80, 95)

# El directorio que comparten este proceso y la extensión de GNOME Shell.
CACHE = Path(os.environ.get("XDG_CACHE_HOME", str(Path.home() / ".cache"))) / "quartermaster"
# Lo que se acaba de dibujar, para que la extensión sepa qué mostrar y de qué tamaño.
ESTADO = CACHE / "estado.json"
# Mientras exista, la barra la maneja la extensión y este proceso esconde su
# propio item de AppIndicator: si no, quedan dos items diciendo lo mismo.
EXTENSION_VIVA = CACHE / "extension-viva"
# Donde la extensión deja el click.
PEDIDO = CACHE / "pedido"

ICONO_OK = "utilities-system-monitor-symbolic"
ICONO_AVISO = "dialog-warning-symbolic"
ICONO_GRAVE = "dialog-error-symbolic"


# ── formato ──────────────────────────────────────────────────────────────
def corto(nombre: str) -> str:
    """`.claude-teams` -> `teams`; el perfil por defecto -> `main`."""
    return nombre.removeprefix(".claude").lstrip("-") or "main"


def dur(segundos: int) -> str:
    if segundos < 0:
        return "ya"
    if segundos < 60:
        return f"{segundos}s"
    if segundos < 3600:
        return f"{segundos // 60}m"
    return f"{segundos // 3600}h{(segundos % 3600) // 60:02d}m"


def faltan(iso: str | None) -> int | None:
    if not iso:
        return None
    try:
        cuando = datetime.fromisoformat(iso.replace("Z", "+00:00"))
    except ValueError:
        return None
    return int((cuando - datetime.now(timezone.utc)).total_seconds())


def al_minuto(iso: str | None) -> str:
    """Un instante ISO recortado al minuto, para usar de clave estable."""
    if not iso:
        return "sin-reinicio"
    try:
        return datetime.fromisoformat(iso.replace("Z", "+00:00")).strftime("%Y-%m-%dT%H:%M")
    except ValueError:
        return iso


def nombre_ventana(v: dict) -> str:
    """El nombre ya viene resuelto; el fallback es por si el JSON es viejo."""
    return v.get("nombre") or (
        v["clave"] if not v.get("alcance") else f"{v['clave']} ({v['alcance']})"
    )


# Acá había un `peor()` y un `mostrables()` reimplementados. Eran la MISMA
# regla que vive en src/core/tipos.ts, copiada — y llegó a estar copiada tres
# veces, en Python, JavaScript y Swift. Una regla en tres lenguajes vale
# distinto en cuanto alguien toca uno solo, y justamente esta es la que evita
# que un 75 % con aviso quede tapado por un 8 % que se ve más lindo.
#
# Ahora `qm --json` manda `mostrar`, `frena`, `sesion` y `semanal` ya resueltas
# y esto sólo dibuja, que es lo que dice el docstring de arriba de todo.


# ── el panel ─────────────────────────────────────────────────────────────
# GNOME no deja dibujar adentro del menú de la barra: la extensión que convierte
# un KStatusNotifierItem en un item de arriba manda los renglones por DBus y del
# otro lado hace `label.set_text(...)` — texto pelado, sin markup — y los iconos
# los mete en un St.Icon de 16 px. O sea que ni colores ni medidores ni curvas
# entran ahí. Lo que sí se puede es abrir una ventana propia y dibujarla, que es
# lo que hace esto: las mismas dos vistas del panel de macOS (bin/qm-barra.swift,
# VistaResumen y VistaCuenta), con las mismas medidas y la misma paleta.
#
# Va por X11 (XWayland) a propósito: en Wayland un cliente no puede elegir dónde
# se pone su ventana, y un panel que aparece en el medio de la pantalla en vez de
# abajo del ícono no es el panel de macOS. Con GDK_BACKEND=x11 el move() manda.

# El panel es más ancho y más aireado que el de macOS: la tipografía de GNOME
# —Cantarell— es más grande de cuerpo que la del sistema de Apple, y con las
# medidas de allá los renglones quedaban apretados y el texto rozando el borde.
ANCHO_PANEL = 360
MARGEN = 12
# Cada cuenta va en una tarjeta redondeada, que es como GNOME agrupa cosas
# (la «boxed list» de libadwaita), en vez de la línea de pelo que separa las
# secciones en macOS.
PAD_TARJETA = 14
RADIO_TARJETA = 12
ENTRE_TARJETAS = 8
ALTO_CABECERA = 76
# El renglón de abajo de todo: cuándo vuelve a preguntar.
ALTO_PIE_LECTURA = 26
VIEJO_SEGUNDOS = 6 * 3600


def _hex(c: str, alfa: float = 1.0):
    return (int(c[1:3], 16) / 255, int(c[3:5], 16) / 255, int(c[5:7], 16) / 255, alfa)


# La paleta de estado es la de GNOME (Adwaita), no la de macOS: son los mismos
# cuatro estados, con los colores que el escritorio ya usa para decirlos, y con
# la variante que cada fondo pide — un verde que se lee sobre blanco se apaga
# sobre negro y al revés.
NIVELES_CLARO = {"ok": "#26a269", "atento": "#e5a50a", "aviso": "#ff7800", "critico": "#c01c28"}
NIVELES_OSCURO = {"ok": "#33d17a", "atento": "#f6d32d", "aviso": "#ffa348", "critico": "#f66151"}
# El color de cada cuenta, deliberadamente lejos de la paleta de estado: verde,
# ámbar y rojo ya significan algo y no pueden significar además «cuenta 2». Azul,
# violeta y rosa no se confunden con «vas bien» ni con «te frenaste».
CUENTAS_CLARO = ["#1c71d8", "#813d9c", "#c9208a"]
CUENTAS_OSCURO = ["#62a0ea", "#c061cb", "#ed67b0"]


def nivel_de(pct: float, preocupa: bool) -> str:
    if pct >= 95:
        return "critico"
    if preocupa or pct >= 80:
        return "aviso"
    if pct >= 60:
        return "atento"
    return "ok"


def dur_larga(segundos: int) -> str:
    """La misma duración que imprime el CLI (src/render/barras.ts).

    Si acá dijera otra cosa, el panel y la terminal contarían distinto el mismo
    reinicio y no habría manera de saber cuál de los dos miente.
    """
    if segundos < 0:
        return "vencido"
    h, m = segundos // 3600, (segundos % 3600) // 60
    if h >= 24:
        d = h // 24
        return f"{d}d" if h % 24 == 0 else f"{d}d{h % 24}h"
    if h > 0:
        return f"{h}h{m:02d}m"
    if m > 0:
        return f"{m}m"
    return f"{segundos}s"


def cuenta_regresiva(segundos: float) -> str:
    """Como dur_larga, pero sin tirar los segundos abajo de la hora.

    dur_larga habla de duraciones que se reportan —«reinicia en 2d14h»— y ahí
    los segundos son ruido. Esto es un reloj que baja a la vista: si dijera sólo
    los minutos cambiaría una vez por minuto, y una cuenta regresiva que no se
    mueve no parece una cuenta regresiva, parece un número roto.
    """
    seg = max(0, int(segundos))
    if seg >= 3600:
        return dur_larga(seg)
    if seg >= 60:
        return f"{seg // 60}m {seg % 60:02d}s"
    return f"{seg}s"


def cada_cuanto(historia: list) -> float | None:
    """Cada cuánto se lee la cuota de verdad, en segundos.

    No es la cadencia que este programa se propone: es la MEDIDA. El historial
    se indexa por `medidoEn` —el instante que informa el servidor, no el momento
    en que qm miró el disco— así que cada muestra es una lectura real y los
    huecos entre muestras son los intervalos entre lectura y lectura. Va la
    mediana y no el promedio: una sola pausa larga (la máquina suspendida, por
    ejemplo) desplaza el promedio y no dice nada del ritmo normal.
    """
    ts = sorted(t for t, _ in historia)
    huecos = sorted(b - a for a, b in zip(ts, ts[1:]) if b > a)
    if not huecos:
        return None
    return huecos[len(huecos) // 2] / 1000


def reinicio(segundos: int | None) -> str:
    """«reinicia en vencido» no es castellano. Cuando ya pasó, se dice que pasó."""
    if segundos is None:
        return ""
    return "reinicio vencido" if segundos < 0 else f"reinicia en {dur_larga(segundos)}"


class Tema:
    """Los dos fondos posibles, con los grises de GNOME.

    El panel vive adentro de un menú de GTK, así que el fondo y la sombra los
    pone el tema del escritorio: acá sólo se define lo que se dibuja encima.
    """

    def __init__(self, oscuro: bool) -> None:
        self.oscuro = oscuro
        if oscuro:
            self.etiqueta = _hex("#ffffff")
            self.secundario = _hex("#ffffff", 0.70)
            self.terciario = _hex("#ffffff", 0.45)
            self.tarjeta = _hex("#ffffff", 0.06)
            self.borde_tarjeta = _hex("#ffffff", 0.08)
            self.pista = _hex("#ffffff", 0.15)
        else:
            self.etiqueta = _hex("#000000", 0.87)
            self.secundario = _hex("#000000", 0.65)
            self.terciario = _hex("#000000", 0.45)
            self.tarjeta = _hex("#000000", 0.04)
            self.borde_tarjeta = _hex("#000000", 0.07)
            self.pista = _hex("#000000", 0.15)

    @staticmethod
    def desde(widget) -> "Tema":
        """El tema que de verdad tiene el widget que va abajo del dibujo.

        Preguntarle a un ajuste y dibujar sobre otra cosa es exactamente cómo el
        panel terminó blanco sobre blanco. El color de texto del propio menú no
        puede mentir: si es claro, el fondo es oscuro.
        """
        try:
            c = widget.get_style_context().get_color(Gtk.StateFlags.NORMAL)
            luz = 0.2126 * c.red + 0.7152 * c.green + 0.0722 * c.blue
            tema = Tema(luz > 0.5)
            # Y los grises salen de ESE color, no de un blanco o un negro
            # supuestos: así el contraste es el que el tema ya eligió.
            base = (c.red, c.green, c.blue)
            tema.etiqueta = base + (1.0,)
            tema.secundario = base + (0.72,)
            tema.terciario = base + (0.46,)
            tema.tarjeta = base + (0.06,)
            tema.borde_tarjeta = base + (0.10,)
            tema.pista = base + (0.16,)
            return tema
        except (AttributeError, TypeError):
            return tema_actual()

    def nivel(self, clave: str):
        return _hex((NIVELES_OSCURO if self.oscuro else NIVELES_CLARO)[clave])

    def color_cuenta(self, i: int):
        tabla = CUENTAS_OSCURO if self.oscuro else CUENTAS_CLARO
        return _hex(tabla[i % len(tabla)])


def prefiere_oscuro() -> bool | None:
    """Lo que dice GNOME, o None si no lo dice."""
    try:
        fuente = Gio.SettingsSchemaSource.get_default()
        esquema = fuente.lookup("org.gnome.desktop.interface", True) if fuente else None
        if esquema is not None and esquema.has_key("color-scheme"):
            v = Gio.Settings.new("org.gnome.desktop.interface").get_string("color-scheme")
            if v == "prefer-dark":
                return True
            if v == "prefer-light":
                return False
    except (GLib.Error, AttributeError, TypeError):
        pass
    return None


def alinear_tema_gtk() -> None:
    """Que GTK3 se entere de que GNOME está en oscuro.

    Esto no es cosmética, es el bug que dejaba el panel ilegible: GNOME dice
    `color-scheme = prefer-dark` y el dibujo se pintaba con letras blancas, pero
    una app GTK3 no se entera sola —su `gtk-application-prefer-dark-theme` sigue
    en False— así que el menú que hace de fondo se dibujaba CLARO. Blanco sobre
    blanco, y no se leía nada.
    """
    oscuro = prefiere_oscuro()
    if oscuro is None:
        return
    try:
        Gtk.Settings.get_default().set_property("gtk-application-prefer-dark-theme", oscuro)
    except (AttributeError, TypeError):
        pass


def tema_actual() -> Tema:
    oscuro = prefiere_oscuro()
    if oscuro is not None:
        return Tema(oscuro)
    try:
        cfg = Gtk.Settings.get_default()
        if cfg.get_property("gtk-application-prefer-dark-theme"):
            return Tema(True)
        return Tema("dark" in (cfg.get_property("gtk-theme-name") or "").lower())
    except (AttributeError, TypeError):
        return Tema(True)


def familia_del_sistema() -> str:
    """La tipografía de la interfaz, sin el cuerpo que trae pegado."""
    try:
        nombre = Gtk.Settings.get_default().get_property("gtk-font-name") or ""
    except (AttributeError, TypeError):
        nombre = ""
    fd = Pango.FontDescription(nombre) if nombre else Pango.FontDescription()
    return fd.get_family() or "Cantarell"


# Se resuelven en main(), cuando Gtk ya leyó los ajustes del escritorio.
TEMA = Tema(True)
FAMILIA = "Cantarell"


# ── dibujo ───────────────────────────────────────────────────────────────
def _color(cr, c) -> None:
    cr.set_source_rgba(c[0], c[1], c[2], c[3] if len(c) > 3 else 1.0)


def _redondeado(cr, x, y, w, h, r) -> None:
    r = min(r, w / 2, h / 2)
    cr.new_sub_path()
    cr.arc(x + w - r, y + r, r, -math.pi / 2, 0)
    cr.arc(x + w - r, y + h - r, r, 0, math.pi / 2)
    cr.arc(x + r, y + h - r, r, math.pi / 2, math.pi)
    cr.arc(x + r, y + r, r, math.pi, 3 * math.pi / 2)
    cr.close_path()


class Pluma:
    """Texto en píxeles, no en puntos.

    Las medidas del panel de macOS son píxeles a 1x. Pango, si le pasás un
    cuerpo en puntos, lo convierte a 96 dpi y un 13 se vuelve 17: el panel
    entero queda un tercio más grande y los renglones se pisan. Por eso todo
    va por set_absolute_size().
    """

    def __init__(self, cr, familia: str) -> None:
        self.cr = cr
        self.familia = familia

    def caja(self, texto: str, px: float, peso=Pango.Weight.NORMAL, ancho=None, tabular=False):
        lay = PangoCairo.create_layout(self.cr)
        fd = Pango.FontDescription()
        fd.set_family(self.familia)
        fd.set_weight(peso)
        fd.set_absolute_size(px * Pango.SCALE)
        lay.set_font_description(fd)
        if tabular:
            # Cifras de ancho fijo: sin esto el porcentaje, que va pegado al
            # borde derecho, baila un píxel cada vez que cambia un dígito.
            try:
                attrs = Pango.AttrList()
                attrs.insert(Pango.attr_font_features_new("tnum=1"))
                lay.set_attributes(attrs)
            except (AttributeError, TypeError):
                pass
        if ancho is not None:
            lay.set_width(int(ancho * Pango.SCALE))
            lay.set_wrap(Pango.WrapMode.WORD_CHAR)
        lay.set_text(texto, -1)
        return lay

    def alto(self, *a, **k) -> float:
        return self.caja(*a, **k).get_pixel_size()[1]

    def ancho(self, *a, **k) -> float:
        return self.caja(*a, **k).get_pixel_size()[0]

    def escribir(self, x, y, texto, px, color, peso=Pango.Weight.NORMAL,
                 derecha=None, ancho=None, tabular=False):
        lay = self.caja(texto, px, peso, ancho=ancho, tabular=tabular)
        w, h = lay.get_pixel_size()
        _color(self.cr, color)
        self.cr.move_to(derecha - w if derecha is not None else x, y)
        PangoCairo.show_layout(self.cr, lay)
        return h

    def linea_base(self, texto: str, px: float, peso=Pango.Weight.NORMAL) -> float:
        return self.caja(texto, px, peso).get_baseline() / Pango.SCALE


def glifo_producto(cr, producto: str, color, x: float, y: float, lado: float) -> None:
    """La marca de cada producto, dibujada: ni Claude ni Codex tienen ícono en
    ningún tema. El asterisco es la forma de la de Claude; los chevrones, código.
    """
    cx, cy = x + lado / 2, y + lado / 2
    cr.save()
    cr.set_line_width(1.3)
    cr.set_line_cap(cairo.LINE_CAP_ROUND)
    _color(cr, color)
    if producto == "opencode":
        r0 = lado * 0.34
        cr.move_to(cx, cy - r0)
        cr.line_to(cx + r0, cy)
        cr.line_to(cx, cy + r0)
        cr.line_to(cx - r0, cy)
        cr.close_path()
    elif producto == "codex":
        a, hueco = lado * 0.30, lado * 0.20
        cr.move_to(cx - hueco, cy - a)
        cr.line_to(cx - hueco - a * 0.85, cy)
        cr.line_to(cx - hueco, cy + a)
        cr.move_to(cx + hueco, cy - a)
        cr.line_to(cx + hueco + a * 0.85, cy)
        cr.line_to(cx + hueco, cy + a)
    else:
        r0 = lado * 0.36
        for k in range(3):
            ang = k * math.pi / 3
            cr.move_to(cx + r0 * math.cos(ang), cy + r0 * math.sin(ang))
            cr.line_to(cx - r0 * math.cos(ang), cy - r0 * math.sin(ang))
    cr.stroke()
    cr.restore()


# ── lo que se dibuja de cada cuenta ──────────────────────────────────────
class VistaCuenta:
    """Una cuenta del panel, en su tarjeta: cabecera, un renglón por barra, la
    curva pegada a la que frena, y el ritmo. Mide primero y dibuja después,
    porque el menú necesita el alto antes de que exista nada.
    """

    # Un renglón de barra = nombre (18) + medidor (11) + pie (16). Si esto no
    # coincide con lo que dibuja pintar(), los renglones se pisan.
    ALTO_BARRA = 45
    # 18 de curva + 16 de rótulos.
    ALTO_CURVA = 34

    def __init__(self, p: dict, indice_color: int) -> None:
        cuota = p.get("cuota") or {}
        self.producto = p.get("producto") or "claude"
        self.indice_color = indice_color
        self.titulo = corto(p.get("perfil") or "?")
        partes = [x for x in (p.get("cuenta"), p.get("plan")) if x]
        self.sub = "   ·   ".join(partes)
        self.hay_numero = cuota.get("estado") == "ok"
        self.frase = None if self.hay_numero else (cuota.get("frase") or "sin cuota")
        self.historia = [
            (m["t"], m["porcentaje"])
            for m in (cuota.get("historia") or [])
            if "t" in m and "porcentaje" in m
        ]
        frena = cuota.get("frena")
        self.clave_frena = frena.get("nombre") if frena else None
        proy = p.get("proyeccion")
        sube = bool(proy and proy.get("estado") == "sube")
        choca = bool(sube and proy.get("chocasAntesDelReinicio"))
        edad = cuota.get("edadSegundos")

        self.barras = []
        for v in (cuota.get("mostrar") or []) if self.hay_numero else []:
            pie = reinicio(faltan(v.get("reinicia")))
            es_la_que_frena = bool(frena and v.get("clave") == frena.get("clave"))
            self.barras.append({
                "nombre": nombre_ventana(v),
                "pct": v.get("porcentaje", 0),
                "nivel": nivel_de(v.get("porcentaje", 0),
                                  v.get("preocupa", False) or (choca and es_la_que_frena)),
                "activa": bool(v.get("activa")),
                "pie": pie,
            })

        self.ritmo = None
        if sube:
            seg = faltan(proy.get("techo"))
            # Una proyección con el techo en el pasado ya no proyecta nada: se
            # leía «100 % en vencido», que no quiere decir nada. Cuando ya
            # tocaste el techo la pregunta es cuándo te liberás, y ésa la
            # contesta la cabecera.
            if seg is not None and seg > 0:
                self.ritmo = (f"{proy.get('ritmoPuntosPorHora', 0):.1f} pts/h · 100 % en "
                              f"{dur_larga(seg)}"
                              + (" — antes del reinicio" if choca else ""))
        self.ritmo_rojo = choca

        # Cada cuánto se lee ESTA cuenta y cuándo fue la última: la pregunta
        # «¿este número de cuándo es?» no se contesta con un porcentaje.
        self.lecturas = None
        if self.hay_numero:
            partes = []
            cada = cada_cuanto(self.historia)
            if cada is not None:
                partes.append(f"cada ~{dur_larga(int(cada))}")
            if edad is not None:
                partes.append(f"última hace {dur_larga(edad)}"
                              + (" · viejo" if edad >= VIEJO_SEGUNDOS else ""))
            self.lecturas = "lecturas:  " + "   ·   ".join(partes) if partes else None

    @staticmethod
    def _ancho_contenido() -> float:
        return ANCHO_PANEL - 2 * MARGEN - 2 * PAD_TARJETA

    def medir(self, pluma: Pluma) -> float:
        alto = PAD_TARJETA + 20 + (17 if self.sub else 0) + 6
        if self.frase is not None:
            return alto + pluma.alto(self.frase, 11.5, ancho=self._ancho_contenido()) + PAD_TARJETA
        alto += len(self.barras) * self.ALTO_BARRA
        if self.clave_frena and len(self.historia) >= 3:
            alto += self.ALTO_CURVA
        if self.ritmo:
            alto += 20
        if self.lecturas:
            alto += 17
        return alto + PAD_TARJETA - 4

    def _curva(self, cr, pluma, caja, color) -> None:
        """Las muestras recientes, dibujadas. El eje Y va del mínimo al máximo
        de la serie y no de 0 a 100: lo que interesa acá es la PENDIENTE, y a
        escala completa una subida de tres puntos se ve plana."""
        x0, y0, w, h = caja
        ts = [m[0] for m in self.historia]
        ps = [float(m[1]) for m in self.historia]
        t_min, t_max = min(ts), max(ts)
        p_min, p_max = min(ps), max(ps)
        if t_max <= t_min:
            return
        rango = max(1.0, p_max - p_min)
        px = lambda t: x0 + w * (t - t_min) / (t_max - t_min)
        py = lambda p: y0 + h - h * (p - p_min) / rango

        cr.move_to(px(ts[0]), y0 + h)
        for t, p in zip(ts, ps):
            cr.line_to(px(t), py(p))
        cr.line_to(px(ts[-1]), y0 + h)
        cr.close_path()
        _color(cr, color[:3] + (0.16,))
        cr.fill()

        cr.set_line_width(1.5)
        cr.set_line_join(cairo.LINE_JOIN_ROUND)
        cr.move_to(px(ts[0]), py(ps[0]))
        for t, p in list(zip(ts, ps))[1:]:
            cr.line_to(px(t), py(p))
        _color(cr, color)
        cr.stroke()

        cr.arc(px(ts[-1]), py(ps[-1]), 2.5, 0, 2 * math.pi)
        _color(cr, color)
        cr.fill()

        horas = (t_max - t_min) / 3_600_000
        pluma.escribir(x0, y0 + h + 2, f"{p_min:.0f}%", 9.5, TEMA.terciario)
        pluma.escribir(0, y0 + h + 2,
                       f"últimas {horas:.1f} h" if horas >= 1 else "última hora",
                       9.5, TEMA.terciario, derecha=x0 + w)

    def pintar(self, cr, pluma: Pluma, arriba: float) -> float:
        alto = self.medir(pluma)
        # La tarjeta: así agrupa GNOME, con una caja redondeada y un fondo
        # apenas distinto, en vez de la línea de pelo de macOS.
        _redondeado(cr, MARGEN + 0.5, arriba + 0.5,
                    ANCHO_PANEL - 2 * MARGEN - 1, alto - 1, RADIO_TARJETA)
        _color(cr, TEMA.tarjeta)
        cr.fill_preserve()
        _color(cr, TEMA.borde_tarjeta)
        cr.set_line_width(1)
        cr.stroke()

        ix = MARGEN + PAD_TARJETA
        ancho = self._ancho_contenido()
        der = ix + ancho
        y = arriba + PAD_TARJETA

        glifo_producto(cr, self.producto, TEMA.color_cuenta(self.indice_color), ix, y + 2, 14)
        pluma.escribir(ix + 21, y, self.titulo, 13.5, TEMA.etiqueta, Pango.Weight.BOLD)
        y += 20
        if self.sub:
            pluma.escribir(ix + 21, y, self.sub, 11, TEMA.terciario)
            y += 17
        y += 6

        if self.frase is not None:
            pluma.escribir(ix, y, self.frase, 11.5, TEMA.secundario, ancho=ancho)
            return arriba + alto

        for b in self.barras:
            nombre = f"{b['nombre']}  ▸" if b["activa"] else b["nombre"]
            pluma.escribir(ix, y, nombre, 11.5,
                           TEMA.etiqueta if b["activa"] else TEMA.secundario,
                           Pango.Weight.MEDIUM if b["activa"] else Pango.Weight.NORMAL)
            pluma.escribir(0, y - 0.5, f"{b['pct']:.0f}%", 12, TEMA.etiqueta,
                           Pango.Weight.BOLD, derecha=der, tabular=True)
            y += 18
            # El medidor: pista tenue y relleno con el color del estado.
            _redondeado(cr, ix, y, ancho, 5, 2.5)
            _color(cr, TEMA.pista)
            cr.fill()
            lleno = max(5.0, ancho * max(0.0, min(100.0, b["pct"])) / 100.0)
            _redondeado(cr, ix, y, lleno, 5, 2.5)
            _color(cr, TEMA.nivel(b["nivel"]))
            cr.fill()
            y += 11
            if b["pie"]:
                pluma.escribir(ix, y, b["pie"], 10.5, TEMA.terciario)
            y += 16
            # La curva va pegada a la barra que frena: es de ella.
            if b["nombre"] == self.clave_frena and len(self.historia) >= 3:
                self._curva(cr, pluma, (ix, y - 2, ancho, 18), TEMA.nivel(b["nivel"]))
                y += self.ALTO_CURVA

        if self.ritmo:
            y += 4
            pluma.escribir(ix, y, self.ritmo, 11,
                           TEMA.nivel("critico") if self.ritmo_rojo else TEMA.terciario,
                           Pango.Weight.MEDIUM if self.ritmo_rojo else Pango.Weight.NORMAL)
            y += 16
        if self.lecturas:
            if not self.ritmo:
                y += 4
            pluma.escribir(ix, y, self.lecturas, 10.5, TEMA.terciario)
        return arriba + alto


class VistaSinCuota:
    """Las cuentas que todavía no tienen número, juntas en una tarjeta.

    Cada una ocupaba una tarjeta entera para decir la misma frase, y el panel
    —que en una pantalla de 768 px ya no entra— gastaba doscientos píxeles en
    repetirla. Juntas además se leen mejor: no son tres misterios distintos,
    es un hecho con varios nombres.
    """

    def __init__(self, cuentas: list[tuple[str, str]]) -> None:
        # Agrupadas por frase y en el orden en que aparecieron: dos cuentas
        # pueden estar calladas por motivos distintos, y ahí la frase importa.
        self.grupos: list[tuple[str, list[str]]] = []
        for nombre, frase in cuentas:
            for f, nombres in self.grupos:
                if f == frase:
                    nombres.append(nombre)
                    break
            else:
                self.grupos.append((frase, [nombre]))

    @staticmethod
    def _ancho_contenido() -> float:
        return ANCHO_PANEL - 2 * MARGEN - 2 * PAD_TARJETA

    def medir(self, pluma: Pluma) -> float:
        alto = PAD_TARJETA
        for frase, nombres in self.grupos:
            alto += 18 + pluma.alto(frase, 10.5, ancho=self._ancho_contenido()) + 8
        return alto + PAD_TARJETA - 8

    def pintar(self, cr, pluma: Pluma, arriba: float) -> float:
        alto = self.medir(pluma)
        _redondeado(cr, MARGEN + 0.5, arriba + 0.5,
                    ANCHO_PANEL - 2 * MARGEN - 1, alto - 1, RADIO_TARJETA)
        _color(cr, TEMA.tarjeta)
        cr.fill_preserve()
        _color(cr, TEMA.borde_tarjeta)
        cr.set_line_width(1)
        cr.stroke()

        ix = MARGEN + PAD_TARJETA
        y = arriba + PAD_TARJETA
        for frase, nombres in self.grupos:
            pluma.escribir(ix, y, "   ·   ".join(nombres), 11.5, TEMA.secundario,
                           Pango.Weight.MEDIUM)
            y += 18
            y += pluma.escribir(ix, y, frase, 10.5, TEMA.terciario,
                                ancho=self._ancho_contenido())
            y += 8
        return arriba + alto


class VistaResumen:
    """La cabecera: la respuesta de una línea. La misma pregunta que contesta el
    héroe del tablero —qué me frena primero, en toda la máquina— y que si no
    está acá hay que sacarla comparando las cuentas a ojo."""

    def __init__(self, cuenta: str, barra: str, pct: float, nivel: str, reinicia) -> None:
        self.cuenta, self.barra, self.pct = cuenta, barra, pct
        self.nivel, self.reinicia = nivel, reinicia

    @staticmethod
    def desde(perfiles: list) -> "VistaResumen | None":
        mejor = None
        for p in perfiles:
            cuota = p.get("cuota") or {}
            if cuota.get("estado") != "ok":
                continue
            v = cuota.get("frena")
            if v and (mejor is None or v["porcentaje"] > mejor[1]["porcentaje"]):
                mejor = (p, v)
        if mejor is None:
            return None
        p, v = mejor
        proy = p.get("proyeccion")
        choca = bool(proy and proy.get("estado") == "sube" and proy.get("chocasAntesDelReinicio"))
        return VistaResumen(corto(p.get("perfil") or "?"), nombre_ventana(v), v["porcentaje"],
                            nivel_de(v["porcentaje"], v.get("preocupa", False) or choca),
                            v.get("reinicia"))

    def pintar(self, cr, pluma: Pluma, arriba: float) -> float:
        color = TEMA.nivel(self.nivel)
        lado = 46.0
        izq = MARGEN + 6
        centro = (izq + lado / 2, arriba + ALTO_CABECERA / 2 - 2)
        radio = lado / 2 - 3

        cr.set_line_width(5.5)
        cr.set_line_cap(cairo.LINE_CAP_BUTT)
        cr.arc(centro[0], centro[1], radio, 0, 2 * math.pi)
        _color(cr, color[:3] + (0.20,))
        cr.stroke()

        frac = max(0.0, min(100.0, self.pct)) / 100.0
        if frac > 0:
            cr.set_line_cap(cairo.LINE_CAP_ROUND)
            cr.arc(centro[0], centro[1], radio, -math.pi / 2, -math.pi / 2 + 2 * math.pi * frac)
            _color(cr, color)
            cr.stroke()

        x = izq + lado + 14
        pluma.escribir(x, arriba + 12, "Lo primero que te frena", 10.5, TEMA.terciario,
                       Pango.Weight.SEMIBOLD)
        cifra = f"{self.pct:.0f}%"
        y_cifra = arriba + 26
        ancho_cifra = pluma.ancho(cifra, 22, Pango.Weight.BOLD, tabular=True)
        pluma.escribir(x, y_cifra, cifra, 22, TEMA.etiqueta, Pango.Weight.BOLD, tabular=True)
        # El nombre va a la derecha de la cifra, sobre su misma línea de base.
        corrimiento = (pluma.linea_base(cifra, 22, Pango.Weight.BOLD)
                       - pluma.linea_base("x", 12))
        pluma.escribir(x + ancho_cifra + 8, y_cifra + corrimiento,
                       f"{self.cuenta} · {self.barra}", 12, TEMA.secundario)

        seg = faltan(self.reinicia)
        if seg is None:
            texto, urgente = "sin reinicio informado", False
        elif self.pct >= 95:
            # Cuando ya te frenó, lo que importa no es cuándo «reinicia»: es
            # cuándo volvés a poder trabajar. Misma fecha, otra pregunta.
            texto, urgente = f"libre en {dur_larga(seg)}", True
        else:
            texto, urgente = reinicio(seg), False
        pluma.escribir(x, arriba + 54, texto, 11, color if urgente else TEMA.terciario,
                       Pango.Weight.MEDIUM if urgente else Pango.Weight.NORMAL)
        return arriba + ALTO_CABECERA


# ── el item de la barra, dibujado ────────────────────────────────────────
# Un medidor vertical por cuenta, en el orden del menú, lleno hasta la semanal
# que la frena antes y pintado por severidad. Es el mismo dibujo que el item de
# la barra de macOS (bin/qm-barra.swift, medidores()) y con las mismas medidas:
# tres cuentas entran en el ancho de una palabra.
#
# Entra en la barra de GNOME por una puerta que la extensión deja abierta sin
# documentar: si el nombre del ícono empieza con «/» lo toma como un archivo, y
# si esa imagen es ANCHA —`width >= height * 1.5`— la dibuja a lo ancho en vez
# de encajarla en el cuadrado de 16 px de un ícono. Abajo de esa proporción se
# vuelve un ícono cuadrado y los medidores quedan ilegibles, así que el ancho
# se rellena hasta cruzarla.
ALTO_ITEM = 22
ALTO_MEDIDOR = 15
ANCHO_MEDIDOR = 3
ENTRE_GRUPOS = 5
LADO_GLIFO = 9
AIRE_GLIFO = 2
AIRE_NUMERO = 3
# La proporción que separa «imagen ancha» de «ícono cuadrado», con un margen
# para no quedar justo en el filo.
PROPORCION_ANCHA = 1.6


def _numero_de(t: dict) -> str | None:
    """El número de cada cuenta es el de la SESIÓN de 5 h: es el que contesta
    «¿puedo seguir trabajando ahora?». La semanal se sigue viendo —es el
    medidor, con su color— sin gastar dígitos.

    Sin marca de cache viejo: un `~` pegado al número obliga a saber qué
    significa para poder leer el número, y la edad del cache ya está escrita con
    todas las letras en el panel, que es donde se la va a buscar.
    """
    if t["sesion"] is None:
        return None
    return f"{t['sesion']:.0f}"


def piezas_de(datos, avisar=None) -> list[dict]:
    """Una pieza por cuenta con número, en el orden del panel.

    Sólo entran las cuentas que tienen un número. Una cuenta sin cuota no se
    dibuja como un medidor vacío —eso se leería como «0 %, todo bien»—: su
    frase está en el panel.
    """
    piezas: list[dict] = []
    if not isinstance(datos, dict):
        return piezas
    for p in datos.get("perfiles", []):
        cuota = p.get("cuota") or {}
        frena = cuota.get("frena") if cuota.get("estado") == "ok" else None
        if frena is None:
            continue
        proy = p.get("proyeccion")
        chocas = bool(proy and proy["estado"] == "sube" and proy["chocasAntesDelReinicio"])

        def alerta(v, _frena=frena, _chocas=chocas) -> bool:
            if not v:
                return False
            return bool(v.get("preocupa")) or (_chocas and v.get("clave") == _frena.get("clave"))

        ses, sem = cuota.get("sesion"), cuota.get("semanal")
        nombre = corto(p["perfil"])
        piezas.append({
            "nombre": nombre,
            "perfil": p["perfil"],
            "producto": p.get("producto") or "claude",
            "indice": len(piezas),
            "sesion": ses.get("porcentaje") if ses else None,
            "sesion_alerta": alerta(ses),
            "semanal": sem.get("porcentaje") if sem else None,
            "semanal_alerta": alerta(sem),
            "viejo": (cuota.get("edadSegundos") or 0) >= VIEJO_SEGUNDOS,
        })
        if avisar is not None:
            # Todas las barras, no sólo la que frena: la semanal puede estar
            # tranquila mientras la de sesión te para, y al revés.
            avisar(nombre, cuota.get("mostrar") or [], frena, proy, chocas)
    return piezas


def dibujar_item(piezas: list[dict], destino: str) -> tuple[int, int, str]:
    """Deja el PNG en `destino` y devuelve (ancho, alto, descripción accesible)."""
    superficie = cairo.ImageSurface(cairo.FORMAT_ARGB32, 1, 1)
    pluma = Pluma(cairo.Context(superficie), FAMILIA)

    anchos = []
    for t in piezas:
        n = _numero_de(t)
        ancho = LADO_GLIFO + AIRE_GLIFO + ANCHO_MEDIDOR
        if n is not None:
            ancho += AIRE_NUMERO + math.ceil(pluma.ancho(n, 10, Pango.Weight.MEDIUM, tabular=True))
        anchos.append(ancho)
    # Un par de píxeles al final: sin eso el último dígito termina exactamente
    # en el borde de la imagen y el antialias se lo come.
    total = sum(anchos) + max(0, len(piezas) - 1) * ENTRE_GRUPOS + 2
    ancho_total = max(int(math.ceil(total)), int(ALTO_ITEM * PROPORCION_ANCHA))

    superficie = cairo.ImageSurface(cairo.FORMAT_ARGB32, ancho_total, ALTO_ITEM)
    cr = cairo.Context(superficie)
    pluma = Pluma(cr, FAMILIA)
    base = (ALTO_ITEM - ALTO_MEDIDOR) / 2
    radio = ANCHO_MEDIDOR / 2

    def medidor(x: float, pct, color) -> None:
        _redondeado(cr, x, base, ANCHO_MEDIDOR, ALTO_MEDIDOR, radio)
        _color(cr, TEMA.pista)
        cr.fill()
        if pct is None:
            return
        # Crece desde abajo, como el de macOS: lleno es «no te queda nada».
        alto = max(ANCHO_MEDIDOR, ALTO_MEDIDOR * max(0.0, min(100.0, pct)) / 100.0)
        _redondeado(cr, x, base + ALTO_MEDIDOR - alto, ANCHO_MEDIDOR, alto, radio)
        _color(cr, color)
        cr.fill()

    if not piezas:
        medidor((ancho_total - ANCHO_MEDIDOR) / 2, None, None)

    x = 0.0
    for i, t in enumerate(piezas):
        # El glifo dice QUÉ suscripción es: la forma, el producto; el color,
        # cuál de ellas. La identidad va acá y nunca en los medidores, que
        # están reservados para el estado.
        glifo_producto(cr, t["producto"], TEMA.color_cuenta(t["indice"]),
                       x, (ALTO_ITEM - LADO_GLIFO) / 2, LADO_GLIFO)
        xb = x + LADO_GLIFO + AIRE_GLIFO
        # El medidor es SIEMPRE la semanal. Si la cuenta no informa ninguna,
        # queda la pista vacía: mejor un hueco honesto que dibujar otra cosa.
        medidor(xb, t["semanal"],
                TEMA.nivel(nivel_de(t["semanal"], t["semanal_alerta"])) if t["semanal"] is not None else None)
        n = _numero_de(t)
        if n is not None:
            # El número es la sesión, así que lleva el estado DE LA SESIÓN. Se
            # tiñe recién cuando aprieta: si se pintara siempre, el color
            # dejaría de querer decir algo.
            nivel = nivel_de(t["sesion"], t["sesion_alerta"])
            color = TEMA.nivel(nivel) if nivel in ("aviso", "critico") else TEMA.etiqueta
            alto_n = pluma.alto(n, 10, Pango.Weight.MEDIUM, tabular=True)
            pluma.escribir(xb + ANCHO_MEDIDOR + AIRE_NUMERO, (ALTO_ITEM - alto_n) / 2,
                           n, 10, color, Pango.Weight.MEDIUM, tabular=True)
        x += anchos[i] + ENTRE_GRUPOS

    superficie.write_to_png(destino)
    return ancho_total, ALTO_ITEM, "; ".join(
        f"{t['nombre']}: "
        + (f"sesión {t['sesion']} por ciento" if t["sesion"] is not None else "sin sesión")
        + ", "
        + (f"semana {t['semanal']} por ciento" if t["semanal"] is not None else "sin semanal")
        + (", con aviso" if t["sesion_alerta"] or t["semanal_alerta"] else "")
        for t in piezas
    )


# ── el panel, dibujado ───────────────────────────────────────────────────
# Vive afuera del widget a propósito: `--captura` dibuja esto mismo sobre una
# superficie de archivo, así que lo que se ve en el PNG es lo que se ve en
# pantalla y no una segunda implementación que se parece.
def modelo_panel(datos):
    if not isinstance(datos, dict):
        return None, []
    perfiles = datos.get("perfiles", [])
    vistas, calladas, i = [], [], 0
    for p in perfiles:
        cuota = p.get("cuota") or {}
        if cuota.get("estado") != "ok":
            calladas.append((corto(p.get("perfil") or "?"), cuota.get("frase") or "sin cuota"))
            continue
        vistas.append(VistaCuenta(p, i))
        # El índice de color sólo avanza con las cuentas que tienen número, para
        # que dos cuentas con barras nunca compartan color.
        i += 1
    if calladas:
        vistas.append(VistaSinCuota(calladas))
    return VistaResumen.desde(perfiles), vistas


def _pluma_de_medir() -> Pluma:
    return Pluma(cairo.Context(cairo.ImageSurface(cairo.FORMAT_ARGB32, 1, 1)), FAMILIA)


def medir_panel(datos, pie: bool = False) -> int:
    pluma = _pluma_de_medir()
    if isinstance(datos, str):
        return int(MARGEN * 2 + pluma.alto(datos, 11.5, ancho=ANCHO_PANEL - 2 * MARGEN))
    cabecera, vistas = modelo_panel(datos)
    alto = ALTO_CABECERA if cabecera else MARGEN
    for v in vistas:
        alto += v.medir(pluma) + ENTRE_TARJETAS
    if vistas:
        alto -= ENTRE_TARJETAS
    return int(alto + MARGEN + (ALTO_PIE_LECTURA if pie else 0))


def dibujar_panel(cr, datos, alto: float, proxima: float | None = None) -> None:
    pluma = Pluma(cr, FAMILIA)
    if isinstance(datos, str):
        # Silencio es el bug: si no hay número, hay una frase.
        pluma.escribir(MARGEN, MARGEN, datos, 11.5, TEMA.secundario,
                       ancho=ANCHO_PANEL - 2 * MARGEN)
        return
    cabecera, vistas = modelo_panel(datos)
    y = cabecera.pintar(cr, pluma, 0.0) if cabecera else float(MARGEN)
    for v in vistas:
        y = v.pintar(cr, pluma, y) + ENTRE_TARJETAS
    if proxima is not None:
        # Cada cuenta dice de cuándo es su número; esto dice cuándo deja de
        # serlo. Es la otra mitad de la misma pregunta.
        y += 4
        pluma.escribir(MARGEN + PAD_TARJETA, y,
                       f"próxima lectura en {cuenta_regresiva(proxima)}",
                       10.5, TEMA.terciario)


def fondo_panel(cr, ancho: float, alto: float) -> None:
    """Sólo para la captura: en pantalla el fondo lo pone el menú de GTK."""
    cr.save()
    cr.set_operator(cairo.OPERATOR_SOURCE)
    cr.set_source_rgba(0, 0, 0, 0)
    cr.paint()
    cr.restore()
    _redondeado(cr, 0.5, 0.5, ancho - 1, alto - 1, 12)
    _color(cr, _hex("#242424") if TEMA.oscuro else _hex("#ffffff"))
    cr.fill_preserve()
    _color(cr, TEMA.borde_tarjeta)
    cr.set_line_width(1)
    cr.stroke()


def capturar(datos, ruta: str) -> None:
    """El panel a un PNG, sin abrir nada. Para mirarlo sin tener la barra
    adelante, y para que un cambio de dibujo se revise en una imagen."""
    alto = medir_panel(datos)
    superficie = cairo.ImageSurface(cairo.FORMAT_ARGB32, ANCHO_PANEL, alto)
    cr = cairo.Context(superficie)
    fondo_panel(cr, ANCHO_PANEL, alto)
    dibujar_panel(cr, datos, alto)
    superficie.write_to_png(ruta)


# ── el panel, en pantalla ────────────────────────────────────────────────
CSS_PANEL = b"""
menu.qm { padding: 6px 0; }
menuitem.qm-lienzo { padding: 0; background: none; background-color: transparent; }
menuitem.qm-lienzo:hover { background: none; background-color: transparent; }
"""


class Panel:
    """El panel adentro de un menú de GTK propio.

    No es una ventana suelta, y la razón se midió: en este escritorio ninguna
    ventana sostiene el foco. Se probaron los cuatro tipos —UTILITY, NORMAL,
    DIALOG, POPUP_MENU— y las cuatro lo pierden solas entre 0,15 s y 4,6 s
    después de abrir, sin que nadie toque nada: mutter se lo devuelve al lado
    Wayland. O sea que «cerrar al perder el foco» cerraba el panel solo, y
    agarrar el asiento a mano no alcanzaba porque un agarre de XWayland no ve
    los clicks que caen sobre una ventana Wayland.

    Un menú de GTK no tiene ninguno de esos problemas: agarra el puntero como lo
    agarra cualquier menú de cualquier app del escritorio, así que se cierra con
    un click afuera y con Escape sin que haya que programarlo. Y de yapa la caja
    redondeada, la sombra y el fondo los pone el tema, con lo cual el panel se ve
    como se ve todo lo demás en vez de como una ventana ajena.

    Sigue haciendo falta X11 para una sola cosa: `popup_at_rect()` contra la
    ventana raíz, que es lo que lo pega arriba a la derecha.
    """

    def __init__(self, al_actualizar, cuanto_falta=None) -> None:
        self.al_actualizar = al_actualizar
        # Una función y no un número: así la cuenta regresiva de abajo baja sola
        # mientras el panel está abierto, en vez de congelarse en el valor que
        # tenía cuando se abrió.
        self.cuanto_falta = cuanto_falta or (lambda: None)
        self.tictac: int | None = None
        self.datos: dict | str | None = None
        self.alto = 0
        self.cerrado = 0

        self.menu = Gtk.Menu()
        self.menu.get_style_context().add_class("qm")
        self.menu.set_reserve_toggle_size(False)

        self.lienzo = Gtk.DrawingArea()
        self.lienzo.connect("draw", self._dibujar)
        self.fila = Gtk.MenuItem()
        self.fila.get_style_context().add_class("qm-lienzo")
        self.fila.add(self.lienzo)
        self.menu.append(self.fila)

        css = Gtk.CssProvider()
        css.load_from_data(CSS_PANEL)
        for w in (self.menu, self.fila):
            w.get_style_context().add_provider(css, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

        self.menu.append(Gtk.SeparatorMenuItem())
        actualizar = Gtk.MenuItem(label="Actualizar ahora")
        actualizar.connect("activate", lambda _: self.al_actualizar())
        self.menu.append(actualizar)
        self.menu.show_all()

        self.menu.realize()
        # Si el compositor le rompe el agarre —pasa cuando el foco se va al lado
        # Wayland— el menú tiene que cerrarse, no quedarse colgado arriba de
        # todo sin forma de sacarlo.
        self.menu.connect("grab-broken-event", lambda *_: (self.menu.popdown(), False)[1])
        self.menu.connect("unmap", self._al_cerrar)

    @property
    def abierto(self) -> bool:
        """Si el menú está mapeado, y no lo que crea una bandera nuestra.

        Antes esto era un booleano que se prendía en «map» y se apagaba en
        «unmap», y se quedó pegado en True: el menú se cerró sin que llegara el
        unmap, así que cada click siguiente llamaba a popdown() sobre algo ya
        cerrado y el panel no volvía a abrir nunca. Preguntarle al widget no se
        puede desincronizar.
        """
        try:
            return bool(self.menu.get_mapped())
        except (AttributeError, TypeError):
            return False

    def _al_cerrar(self, *_) -> None:
        self.cerrado = GLib.get_monotonic_time()
        if self.tictac is not None:
            GLib.source_remove(self.tictac)
            self.tictac = None

    def _tic(self) -> bool:
        """Sólo redibuja: la medida no cambia, así que no hay que volver a
        medir ni a mover nada."""
        if not self.abierto:
            self.tictac = None
            return False
        self.lienzo.queue_draw()
        return True

    def _dibujar(self, _w, cr) -> bool:
        dibujar_panel(cr, self.datos, self.alto, self.cuanto_falta())
        return False

    @staticmethod
    def _area():
        disp = Gdk.Display.get_default()
        mon = None
        try:
            _, px, py = disp.get_default_seat().get_pointer().get_position()
            mon = disp.get_monitor_at_point(px, py)
        except (AttributeError, TypeError):
            pass
        mon = mon or disp.get_primary_monitor() or disp.get_monitor(0)
        return mon.get_workarea()

    @staticmethod
    def _disparo(raiz):
        """El evento que GTK pide para popear un menú.

        Acá no hay ninguno: el panel lo abre un mensaje de DBus, no un click que
        haya pasado por este proceso. Sin evento GTK avisa «no trigger event for
        menu popup» y el agarre que toma después se rompe solo a
        los pocos segundos: el menú se cerraba sin que nadie tocara nada.

        El tiempo va en CURRENT_TIME a propósito. Preguntarle la hora al
        servidor X con x11_get_server_time() sobre la ventana raíz **cuelga el
        proceso**: esa función escribe una propiedad y se queda esperando un
        PropertyNotify que la raíz nunca manda, y el bucle principal no vuelve.
        Para agarrar el puntero, CURRENT_TIME quiere decir «ahora» y alcanza.
        """
        ev = Gdk.Event.new(Gdk.EventType.BUTTON_PRESS)
        ev.window = raiz
        ev.send_event = True
        ev.button = 1
        asiento = Gdk.Display.get_default().get_default_seat()
        puntero = asiento.get_pointer()
        try:
            ev.set_device(puntero)
            _, x, y = puntero.get_position()
            ev.x_root, ev.y_root = float(x), float(y)
        except (AttributeError, TypeError):
            pass
        ev.time = Gdk.CURRENT_TIME
        return ev

    def mostrar(self, datos) -> None:
        """Abre —o redibuja, si ya estaba abierto— el panel con estos datos."""
        global TEMA
        # Cada vez, no una sola al arrancar: el tema del escritorio se cambia
        # mientras el programa corre y el dibujo tiene que seguirlo.
        TEMA = Tema.desde(self.menu)
        self.datos = datos
        self.alto = medir_panel(datos, self.cuanto_falta() is not None)
        self.lienzo.set_size_request(ANCHO_PANEL, self.alto)
        self.lienzo.queue_draw()
        if self.abierto:
            return
        # Arriba a la derecha del área útil, que ya excluye la barra.
        area = self._area()
        donde = Gdk.Rectangle()
        donde.x, donde.y, donde.width, donde.height = area.x + area.width - 6, area.y, 1, 1
        raiz = Gdk.get_default_root_window()
        if raiz is None:  # sin X11 no hay dónde anclarlo; que lo ubique GTK
            self.menu.popup_at_pointer(None)
            return
        self.menu.popup_at_rect(raiz, donde, Gdk.Gravity.NORTH_EAST,
                                Gdk.Gravity.NORTH_EAST, self._disparo(raiz))
        if self.tictac is None:
            self.tictac = GLib.timeout_add_seconds(1, self._tic)

    def alternar(self, datos) -> None:
        """Abre o cierra.

        El margen no es paranoia: el click del medio sobre la barra cierra el
        menú antes de que el evento llegue hasta acá, así que sin él el click
        que tenía que cerrarlo lo vuelve a abrir.
        """
        if self.abierto or (GLib.get_monotonic_time() - self.cerrado) < 300_000:
            self.menu.popdown()
        else:
            self.mostrar(datos)


# ── avisos ───────────────────────────────────────────────────────────────
class Avisos:
    """Notificaciones sin repetir.

    La clave incluye el instante de reinicio: cuando la ventana se reinicia,
    la clave cambia sola y el mismo umbral puede volver a avisar. Sin eso, o
    spameás cada minuto o avisás una sola vez en la vida.
    """

    def __init__(self) -> None:
        self.bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)
        self.ruta = Path(
            os.environ.get("XDG_CACHE_HOME", str(Path.home() / ".cache"))
        ) / "quartermaster" / "avisados.json"
        try:
            self.vistos = set(json.loads(self.ruta.read_text()))
        except (OSError, ValueError):
            self.vistos = set()

    def guardar(self) -> None:
        try:
            self.ruta.parent.mkdir(parents=True, exist_ok=True)
            self.ruta.write_text(json.dumps(sorted(self.vistos)))
        except OSError:
            pass  # sin memoria de avisos se avisa de más, no de menos

    def avisar(self, clave: str, titulo: str, cuerpo: str, urgente: bool) -> None:
        """Una vez por clave y nunca más."""
        if clave in self.vistos:
            return
        self.vistos.add(clave)
        self.guardar()
        self.notificar(titulo, cuerpo, urgente)

    def notificar(self, titulo: str, cuerpo: str, urgente: bool) -> None:
        """Sin memoria: para lo que sí tiene que volver a avisar cada vez que
        pasa, como un reinicio."""
        try:
            self.bus.call_sync(
                "org.freedesktop.Notifications",
                "/org/freedesktop/Notifications",
                "org.freedesktop.Notifications",
                "Notify",
                GLib.Variant(
                    "(susssasa{sv}i)",
                    (
                        "quartermaster",
                        0,
                        ICONO_GRAVE if urgente else ICONO_AVISO,
                        titulo,
                        cuerpo,
                        [],
                        {"urgency": GLib.Variant("y", 2 if urgente else 1)},
                        0 if urgente else 10_000,
                    ),
                ),
                GLib.VariantType("(u)"),
                Gio.DBusCallFlags.NONE,
                -1,
                None,
            )
        except GLib.Error:
            pass  # sin servidor de notificaciones el indicador igual funciona


# ── leer a qm ────────────────────────────────────────────────────────────
def leer_qm(qm: str) -> dict | str:
    """El JSON de qm, o la frase que explica por qué no hay JSON."""
    try:
        r = subprocess.run(
            [qm, "--json", "--breve"],
            capture_output=True,
            text=True,
            timeout=20,
            check=False,
        )
    except (OSError, subprocess.TimeoutExpired) as e:
        return f"no pude correr qm: {e}"
    # 3 es «alguna barra pasó el umbral», no un error.
    if r.returncode not in (0, 3):
        lineas = (r.stderr or r.stdout or "").strip().splitlines()
        return f"qm salió {r.returncode}: {lineas[0] if lineas else 'sin detalle'}"
    try:
        return json.loads(r.stdout)
    except json.JSONDecodeError:
        return "qm no devolvió JSON"


class Previos:
    """Cuánto valía cada barra la última vez, para poder ver que se reinició.

    Un porcentaje solo no dice nada de eso: 3 % puede ser «recién empezás» o
    «acabás de salir de estar contra el techo», y la diferencia es justo lo que
    hay que avisar. Se guarda el minuto de reinicio junto al número: cuando el
    minuto cambia, la ventana es otra.
    """

    def __init__(self) -> None:
        self.ruta = CACHE / "previos.json"
        try:
            self.mapa = json.loads(self.ruta.read_text())
        except (OSError, ValueError):
            self.mapa = {}

    def ver_y_guardar(self, clave: str, minuto: str, pct: float):
        """Devuelve lo anterior (minuto, pct) o None, y anota lo de ahora."""
        antes = self.mapa.get(clave)
        self.mapa[clave] = [minuto, pct]
        if not isinstance(antes, list) or len(antes) != 2:
            return None
        return antes[0], antes[1]

    def guardar(self) -> None:
        try:
            self.ruta.parent.mkdir(parents=True, exist_ok=True)
            self.ruta.write_text(json.dumps(self.mapa))
        except OSError:
            pass  # sin memoria se avisa de más, no de menos


# ── indicador ────────────────────────────────────────────────────────────
class Indicador:
    def __init__(self, qm: str):
        self.qm = qm
        self.avisos = Avisos()
        self.previos = Previos()
        self.pendiente: int | None = None
        self.pedido_pendiente: int | None = None
        self.menu = Gtk.Menu()
        self.ind = AppIndicator.Indicator.new(
            ID, ICONO_OK, AppIndicator.IndicatorCategory.SYSTEM_SERVICES
        )
        self.ind.set_status(AppIndicator.IndicatorStatus.ACTIVE)
        self.ind.set_title("quartermaster")
        self.ind.set_menu(self.menu)
        self.datos: dict | str | None = None
        self.piezas: list[dict] = []
        self.minutos_al_techo: float | None = None
        self.calentando = False
        self.reloj: int | None = None
        self.proxima_lectura: int | None = None
        self.turno = 0
        self.iconos = CACHE
        self.panel = Panel(self.refrescar, self.falta_para_lectura)
        self.monitores: list[Gio.FileMonitor] = []
        self.refrescar()
        self.vigilar()
        self.vigilar_extension()
        GLib.timeout_add_seconds(SEGUNDOS_SONDEO, self.refrescar)
        self.programar_calentado(5)

    # Vigilancia de archivos ------------------------------------------------
    def vigilar(self) -> None:
        """Un monitor por .claude.json. Es donde aparece la cuota nueva."""
        casa = Path.home()
        rutas = [casa / ".claude.json"]
        rutas += [d / ".claude.json" for d in casa.glob(".claude-*") if d.is_dir()]
        for r in rutas:
            try:
                mon = Gio.File.new_for_path(str(r)).monitor_file(
                    Gio.FileMonitorFlags.NONE, None
                )
            except GLib.Error:
                continue
            mon.connect("changed", self.cambio)
            self.monitores.append(mon)

    def vigilar_extension(self) -> None:
        """Los dos archivos que escribe la extensión: el click y su presencia."""
        for ruta, accion in ((PEDIDO, self.atender_pedido),
                             (EXTENSION_VIVA, self.mandar_en_la_barra)):
            try:
                mon = Gio.File.new_for_path(str(ruta)).monitor_file(
                    Gio.FileMonitorFlags.NONE, None)
            except GLib.Error:
                continue
            mon.connect("changed", lambda *a, f=accion: f())
            self.monitores.append(mon)
        self.mandar_en_la_barra()

    def atender_pedido(self) -> None:
        """Un click, una acción.

        Escribir un archivo son VARIOS eventos de inotify —se midieron tres por
        escritura: changed, changed, changes-done-hint— y sin juntarlos un solo
        click abría el panel y los dos eventos siguientes lo cerraban en el
        mismo instante. Desde afuera se veía como que el item no hacía nada.
        """
        if self.pedido_pendiente is not None:
            GLib.source_remove(self.pedido_pendiente)
        self.pedido_pendiente = GLib.timeout_add(120, self._pedido_listo)

    def _pedido_listo(self) -> bool:
        self.pedido_pendiente = None
        try:
            accion = PEDIDO.read_text().split(" ", 1)[0].strip()
        except OSError:
            return False
        if accion == "alternar":
            self.abrir_panel()
        elif accion == "actualizar":
            self.refrescar()
        return False

    def mandar_en_la_barra(self) -> None:
        """Si la extensión está puesta, el item de AppIndicator sobra.

        No se destruye, se pone en PASSIVE: la extensión se puede apagar en
        cualquier momento y entonces este item tiene que volver, sin reiniciar
        nada y sin dejar la barra vacía en el medio.
        """
        propia = not EXTENSION_VIVA.exists()
        self.ind.set_status(AppIndicator.IndicatorStatus.ACTIVE if propia
                            else AppIndicator.IndicatorStatus.PASSIVE)

    def cambio(self, _mon, _f, _o, evento) -> None:
        if evento not in (
            Gio.FileMonitorEvent.CHANGES_DONE_HINT,
            Gio.FileMonitorEvent.CREATED,
            Gio.FileMonitorEvent.RENAMED,
        ):
            return
        # Claude Code reescribe el archivo varias veces seguidas; una sola
        # relectura al final alcanza.
        if self.pendiente is not None:
            GLib.source_remove(self.pendiente)
        self.pendiente = GLib.timeout_add(DEBOUNCE_MS, self.disparar)

    # Calentado -------------------------------------------------------------
    # `qm --breve` lee del disco y no habla con nadie, que es lo que lo hace
    # instantáneo — pero entonces el número es tan fresco como la última vez que
    # ALGUIEN preguntó. Y Claude Code refresca su propio cache cuando quiere:
    # medido acá, 1 día y 11 horas sin tocarlo, con la semanal 14 puntos abajo
    # de la realidad. Así que el indicador pregunta él, igual que la barra de
    # macOS y la bandeja de Windows, y deja el número en el cache para que las
    # lecturas sigan siendo de disco.
    @staticmethod
    def _tope(t: dict) -> int:
        return max(t["sesion"] or 0, t["semanal"] or 0)

    def cadencia(self) -> int:
        # Una barra que ya está en 100 no puede subir: hasta el reinicio no hay
        # nada nuevo que leer, y el instante del reinicio ya lo sabemos sin
        # preguntar. Contarla como «alto» hacía que el sondeo se fuera al piso
        # de 60 s para mirar un número congelado — un pedido por minuto a un
        # endpoint que no es nuestro, para confirmar que seguís frenado.
        moviles = [self._tope(t) for t in self.piezas if self._tope(t) < 100]
        alto = max(moviles, default=0)
        seg = SEGUNDOS_SONDEO
        if alto >= 90:
            seg = MINIMO_RED
        elif alto >= 75:
            seg = 120
        elif alto >= 50:
            seg = 240
        # Si la proyección dice que el techo está cerca, el número viejo deja de
        # servir mucho antes que en el caso normal.
        m = self.minutos_al_techo
        if m is not None and m <= 30:
            seg = min(seg, MINIMO_RED)
        elif m is not None and m <= 90:
            seg = min(seg, 120)
        return max(MINIMO_RED, seg)

    def programar_calentado(self, segundos: int | None = None) -> None:
        if self.reloj is not None:
            GLib.source_remove(self.reloj)
        cuanto = self.cadencia() if segundos is None else segundos
        self.proxima_lectura = GLib.get_monotonic_time() + cuanto * 1_000_000
        self.reloj = GLib.timeout_add_seconds(cuanto, self.calentar)

    def falta_para_lectura(self) -> float | None:
        """Segundos hasta la próxima vez que se le pregunta al servidor."""
        if self.proxima_lectura is None:
            return None
        if self.calentando:
            return 0.0
        return max(0.0, (self.proxima_lectura - GLib.get_monotonic_time()) / 1_000_000)

    def calentar(self) -> bool:
        self.reloj = None
        if self.calentando:
            return False
        args = [self.qm, "--calentar"]
        # Sólo las cuentas que se mueven: refrescar una que va al 9 % es gastar
        # un pedido para confirmar que no pasó nada.
        mueven = [t["perfil"] for t in self.piezas if 40 <= self._tope(t) < 100]
        if mueven and len(mueven) != len(self.piezas):
            args.append("--cuentas=" + ",".join(mueven))
        try:
            proc = Gio.Subprocess.new(
                args, Gio.SubprocessFlags.STDOUT_SILENCE | Gio.SubprocessFlags.STDERR_SILENCE
            )
        except GLib.Error:
            self.programar_calentado()
            return False
        self.calentando = True
        proc.wait_async(None, self._fin_calentado)
        return False

    def _fin_calentado(self, proc, resultado) -> None:
        self.calentando = False
        try:
            proc.wait_finish(resultado)
        except GLib.Error:
            pass  # si el endpoint no contesta se sigue mostrando lo viejo, con su edad a la vista
        self.refrescar()

    def disparar(self) -> bool:
        self.pendiente = None
        self.refrescar()
        return False

    # Datos -----------------------------------------------------------------
    def leer(self) -> dict | str:
        return leer_qm(self.qm)

    # Dibujo ----------------------------------------------------------------
    def refrescar(self) -> bool:
        datos = self.leer()
        self.datos = datos
        for hijo in self.menu.get_children():
            self.menu.remove(hijo)

        # El menú es tres renglones y nada más. Antes repetía cada perfil con
        # cada barra en bloques `█░`, que es lo único que GNOME sabe dibujar
        # acá adentro —la extensión manda los items por DBus y del otro lado
        # hace label.set_text(), texto pelado— y era justamente lo que el panel
        # vino a reemplazar. Un muro de texto feo delante del dibujo bueno es
        # peor que no tener menú.
        abrir = Gtk.MenuItem(label="Panel de cuota      ·      click del medio")
        abrir.connect("activate", lambda _: self.abrir_panel())
        self.menu.append(abrir)
        # El click del medio abre el panel sin pasar por el menú, que es lo más
        # parecido al click único de macOS que deja hacer GNOME (el izquierdo se
        # lo queda la extensión para el menú, y el AboutToShow que manda ni
        # siquiera llega hasta acá).
        #
        # El objetivo tiene que ser un item que VIVA dentro del menú y esté
        # visible: con un widget suelto, libayatana descarta el evento sin decir
        # nada. Y como el menú se reconstruye en cada refresco, hay que volver a
        # apuntarlo cada vez o el click deja de hacer efecto en silencio.
        abrir.show()
        self.ind.set_secondary_activate_target(abrir)

        if isinstance(datos, str):
            # Un estado que no produce número tiene que producir una frase.
            self.ind.set_label("qm ?", "qm")
            self.ind.set_icon_full(ICONO_AVISO, "qm sin datos")
            self.item(datos)
        else:
            self.pintar(datos)

        # «Actualizar» ya está adentro del panel, que es donde se mira el
        # número: repetirlo acá sólo agrega un renglón que hay que saltear.
        self.menu.append(Gtk.SeparatorMenuItem())
        salir = Gtk.MenuItem(label="Salir")
        salir.connect("activate", lambda _: Gtk.main_quit())
        self.menu.append(salir)
        self.menu.show_all()
        if self.panel.abierto:
            self.panel.mostrar(datos)
        self.programar_calentado()
        return True

    def abrir_panel(self) -> None:
        self.panel.alternar(self.datos)

    def item(self, texto: str) -> None:
        it = Gtk.MenuItem(label=texto)
        it.set_sensitive(False)
        self.menu.append(it)

    def pintar(self, datos: dict) -> None:
        piezas = piezas_de(datos, self.revisar_avisos)
        self.piezas = piezas
        techos = []
        for p in datos.get("perfiles", []):
            proy = p.get("proyeccion") or {}
            if proy.get("estado") == "sube" and proy.get("chocasAntesDelReinicio"):
                seg = faltan(proy.get("techo"))
                if seg is not None:
                    techos.append(seg / 60)
        self.minutos_al_techo = min(techos) if techos else None
        if not piezas:
            # Sin una sola cuenta con número no hay nada que medir, y un dibujo
            # vacío sería un item mudo. Ahí sí sirve el ícono con nombre.
            self.ind.set_label("sin cuota", "qm")
            self.ind.set_icon_full(ICONO_AVISO, "sin cuota")
            return

        # Se alterna el nombre del archivo porque el shell cachea la textura por
        # ruta: reescribiendo siempre la misma, el item se queda con el dibujo
        # viejo y parece que la cuota no se mueve.
        self.turno = 1 - self.turno
        destino = self.iconos / f"barra-{self.turno}.png"
        try:
            self.iconos.mkdir(parents=True, exist_ok=True)
            ancho, alto, descripcion = dibujar_item(piezas, str(destino))
        except (OSError, MemoryError) as e:
            self.ind.set_icon_full(ICONO_AVISO, f"no pude dibujar el item: {e}")
            return
        # El dibujo ya dice todo lo que decía el texto. Dejar los dos es repetir
        # el mismo número en dos idiomas y ocupar el doble de barra.
        self.ind.set_label("", "")
        self.ind.set_icon_full(str(destino), descripcion)
        self.publicar(destino, ancho, alto, descripcion)

    def publicar(self, ruta: Path, ancho: int, alto: int, descripcion: str) -> None:
        """Deja escrito qué dibujó, para la extensión de GNOME Shell."""
        try:
            ESTADO.write_text(json.dumps({
                "icono": str(ruta), "ancho": ancho, "alto": alto,
                "descripcion": descripcion,
            }))
        except OSError:
            pass  # sin extensión instalada esto no le importa a nadie

    def revisar_avisos(self, perfil: str, ventanas: list, frena: dict | None,
                       proy: dict | None, chocas: bool) -> None:
        for v in ventanas:
            nombre = nombre_ventana(v)
            minuto = al_minuto(v.get("reinicia"))
            pct = v["porcentaje"]
            # El reinicio va en la clave: cuando la ventana se reinicia, el
            # mismo umbral vuelve a poder avisar. Va redondeado al minuto porque
            # el servidor manda microsegundos y no siempre los mismos entre
            # lecturas (se vieron .117894 y .118092 en la misma respuesta): con
            # el valor crudo, cada jitter estrena clave y vuelve a notificar lo
            # mismo.
            base = f"{perfil}|{nombre}|{minuto}"
            for u in UMBRALES:
                if pct >= u:
                    seg = faltan(v.get("reinicia"))
                    cola = f" Se reinicia en {dur_larga(seg)}." if seg is not None else ""
                    self.avisos.avisar(
                        f"{base}|{u}",
                        f"{perfil}: {pct:.0f}% de {nombre}",
                        f"Pasaste el {u}%.{cola}",
                        urgente=u >= 95,
                    )
            self.revisar_liberada(perfil, nombre, minuto, pct)

        if chocas and proy and frena:
            seg = faltan(proy["techo"])
            self.avisos.avisar(
                f"{perfil}|{nombre_ventana(frena)}|{al_minuto(frena.get('reinicia'))}|choque",
                f"{perfil}: a este ritmo llegás al 100%",
                f"{proy['ritmoPuntosPorHora']:.1f} pts/h — tocás el techo en "
                f"{dur_larga(faltan(proy['techo']) or 0)}, antes de que la ventana se reinicie.",
                urgente=True,
            )
        self.previos.guardar()

    def revisar_liberada(self, perfil: str, nombre: str, minuto: str, pct: float) -> None:
        """El aviso que faltaba: ya podés volver a trabajar.

        Todo lo demás avisa cuando subís. Este avisa cuando la ventana se
        reinicia habiendo estado contra el techo, que es el único momento en
        que la noticia sirve para hacer algo distinto ahora mismo — y es
        justamente cuando dejaste de mirar la barra, porque no había nada que
        mirar.
        """
        antes = self.previos.ver_y_guardar(f"{perfil}|{nombre}", minuto, pct)
        if antes is None:
            return
        minuto_antes, pct_antes = antes
        if minuto == minuto_antes or pct_antes < 80 or pct >= pct_antes:
            return
        self.avisos.notificar(
            f"{perfil}: se reinició {nombre}",
            f"Estabas {pct_antes:.0f} % y ahora vas {pct:.0f} %.",
            urgente=False,
        )


def buscar_qm() -> str | None:
    """qm en el PATH; si no, el hermano de este archivo.

    El arranque automático de la sesión no pasa por el .zshrc del usuario, así
    que ~/.local/bin puede no estar en el PATH ahí aunque sí lo esté en una
    terminal. El hermano siempre está donde este script.
    """
    encontrado = shutil.which("qm")
    if encontrado:
        return encontrado
    vecino = Path(__file__).resolve().parent / "qm"
    return str(vecino) if vecino.is_file() else None


def leer_desde(ruta: str) -> dict:
    """El JSON de un archivo en vez del de qm.

    Existe para el gate de dibujo: con una entrada fija, lo que sale es
    comparable entre corridas y entre máquinas. Si el archivo no se puede leer
    se levanta, no se devuelve una frase: una frase se dibujaría como un panel
    chiquito y perfectamente válido, y el gate lo daría por bueno.
    """
    return json.loads(pathlib.Path(ruta).read_text())


def main() -> int:
    fijo = None
    if "--desde" in sys.argv:
        i = sys.argv.index("--desde")
        if i + 1 >= len(sys.argv):
            print("--desde necesita una ruta", file=sys.stderr)
            return 1
        fijo = sys.argv[i + 1]

    qm = buscar_qm()
    if qm is None and fijo is None:
        print("qm no está en el PATH. Corré `make instalar` en el repo.", file=sys.stderr)
        return 1
    global TEMA, FAMILIA
    try:
        CACHE.mkdir(parents=True, exist_ok=True)
    except OSError:
        pass
    alinear_tema_gtk()
    TEMA = tema_actual()
    FAMILIA = familia_del_sistema()
    if "--claro" in sys.argv:
        TEMA = Tema(False)
    if "--oscuro" in sys.argv:
        TEMA = Tema(True)

    # `--captura ruta.png` dibuja el panel y sale. Es la forma de revisar un
    # cambio de dibujo sin tener que abrir la barra y sacar una foto.
    for bandera, dibujo in (("--captura", "panel"), ("--captura-item", "item")):
        if bandera not in sys.argv:
            continue
        i = sys.argv.index(bandera)
        if i + 1 >= len(sys.argv):
            print(f"{bandera} necesita una ruta", file=sys.stderr)
            return 1
        try:
            datos = leer_desde(fijo) if fijo is not None else leer_qm(qm)
        except (OSError, json.JSONDecodeError) as e:
            print(f"no pude leer {fijo}: {e}", file=sys.stderr)
            return 1
        if dibujo == "panel":
            capturar(datos, sys.argv[i + 1])
        else:
            dibujar_item(piezas_de(datos), sys.argv[i + 1])  # devuelve medidas, no se usan acá
        print(sys.argv[i + 1])
        return 0

    Indicador(qm)
    Gtk.main()
    return 0


if __name__ == "__main__":
    sys.exit(main())
