#!/usr/bin/env python3
"""qm en la barra de arriba de GNOME.

Es la parte de "renderizado" que SOUL.md dejaba para después de tener los
números bien. Dibuja y nada más: le pide el JSON a `qm` y no sabe qué es una
credencial ni habla HTTP.

Tres cosas que lo hacen algo más que un reloj:

  · Se entera solo. Vigila el .claude.json de cada perfil con Gio.FileMonitor,
    así que cuando Claude Code refresca la cuota el número cambia en el acto en
    vez de esperar al próximo minuto. El sondeo lento queda de red de seguridad.
  · Avisa sin que lo mires. Notifica al cruzar 80 % y 95 %, y cuando la
    proyección pasa a decir que tocás el techo ANTES del reinicio — que es el
    momento útil para enterarte, no cuando ya chocaste.
  · No repite. Cada aviso se recuerda por (perfil, barra, reinicio), así que
    una ventana avisa una vez y vuelve a avisar recién en la siguiente.

Requiere el soporte de AppIndicator en GNOME (la extensión
appindicatorsupport@rgcjonas.gmail.com), que es lo que convierte un
KStatusNotifierItem en un item de la barra.
"""

import json
import math
import os
import pathlib
import shutil
import py_compile
import subprocess
import sys
import tempfile
import time
from datetime import datetime, timezone
from pathlib import Path

# El panel se abre pegado a la barra, y para eso hay que poder decir DÓNDE va la
# ventana. En Wayland un cliente no puede: la ubica el compositor, y un panel que
# aparece en el medio de la pantalla no es el panel que se está copiando. Sobre
# XWayland sí se puede, y al item de la barra no le cambia nada porque es DBus
# puro. Si no hay X11 a mano se sigue por Wayland y el panel cae donde caiga.
if os.environ.get("DISPLAY") and not os.environ.get("QM_SIN_X11"):
    os.environ.setdefault("GDK_BACKEND", "x11")

import cairo  # noqa: E402
import gi  # noqa: E402

gi.require_version("Gtk", "3.0")
gi.require_version("Pango", "1.0")
gi.require_version("PangoCairo", "1.0")
gi.require_version("AyatanaAppIndicator3", "0.1")
from gi.repository import AyatanaAppIndicator3 as AppIndicator  # noqa: E402
from gi.repository import Gdk, Gio, GLib, Gtk, Pango, PangoCairo  # noqa: E402


ID = "quartermaster"
# Red de seguridad: el FileMonitor es el que manda. Esto sólo cubre el caso de
# un monitor que se pierda un evento (montajes raros, archivos reemplazados).
# Cuánto hace falta que una cuenta esté sin usarse para dejar de preguntarle.
# Diez minutos aguantan una pausa entre prompts sin seguir preguntando por una
# cuenta que ya cerraste.
ACTIVA_SEGUNDOS = 600
# Cuánto se le da a un calentado antes de darlo por colgado. `qm --calentar`
# tiene su propio timeout de red adentro, así que si en dos minutos no contestó
# es que su callback no va a llegar.
CALENTADO_PLAZO_US = 120 * 1_000_000
SEGUNDOS_SONDEO = 300
#: Cada cuánto mira el vigía, y a partir de qué atraso da la alarma. El plazo es
#: cuatro sondeos: con la cadencia en su techo de 300 s, un calentado que no
#: ocurrió en 20 minutos no es lentitud, es que el lazo se cortó.
VIGIA_SEGUNDOS = 60
VIGIA_PLAZO_US = 4 * SEGUNDOS_SONDEO * 1_000_000
# Piso para cualquier cadencia que salga a la RED. Claude Code pide la cuota del
# orden de una vez por sesión; un endpoint no documentado, que además puede
# desaparecer sin aviso, no es lugar para sondear más rápido que esto. Y la
# diferencia real es chica: a 1,6 puntos por minuto, 60 s son 1,6 puntos de
# atraso.
MINIMO_RED = 60
# Coalescer escrituras: Claude Code reescribe .claude.json varias veces seguidas.
DEBOUNCE_MS = 1500
UMBRALES = (80, 95)

# El directorio que comparten este proceso y la extensión de GNOME Shell.
CACHE = Path(os.environ.get("XDG_CACHE_HOME", str(Path.home() / ".cache"))) / "quartermaster"
# Lo que se acaba de dibujar, para que la extensión sepa qué mostrar y de qué tamaño.
ESTADO = CACHE / "estado.json"
# Mientras exista, la barra la maneja la extensión y este proceso esconde su
# propio item de AppIndicator: si no, quedan dos items diciendo lo mismo.
EXTENSION_VIVA = CACHE / "extension-viva"
# Donde la extensión deja el click.
PEDIDO = CACHE / "pedido"
# Cuántos dibujos viejos quedan sin borrar. El nombre de cada dibujo no se
# repite nunca (ver `pintar`), así que hay que barrerlos o el cache crece sin
# techo. Tres y no uno: uno es el que estado.json está señalando, y los otros
# cubren la lectura asíncrona del shell, que puede seguir cargando el anterior
# cuando éste ya se escribió. Borrar de más se ve como un item sin icono.
DIBUJOS_QUE_QUEDAN = 3
# El panel, dibujado a un PNG para que lo muestre la extensión.
#
# Por qué un PNG y no la ventana: un menú de GTK sobre XWayland no logra
# sostener su agarre contra la actividad real del escritorio. Aislado aguanta
# minutos; con alguien usando la máquina se cierra a los segundos, y tocarlo
# para rodarlo lo cierra. Medido tres veces, con tres arquitecturas (ventana con
# foco, ventana con agarre a mano, y menú de GTK). Adentro de la extensión el
# panel es un actor del compositor: no hay agarre que romper, no hay XWayland, y
# rueda y se cierra como cualquier menú del shell.
# Cuánto se le cree a `extension-viva` sin que lo renueven. La extensión lo
# toca cada 30 s; el triple da margen para una máquina cargada sin dejar el
# item escondido más de minuto y medio si del otro lado ya no hay nadie.
VIVA_SEGUNDOS = 90

# Este mismo archivo, resuelto: se instala enlazado desde ~/.local/bin y desde
# /usr/bin, y hay que vigilar el de verdad, no el enlace.
YO = pathlib.Path(__file__).resolve()

ICONO_OK = "utilities-system-monitor-symbolic"
ICONO_AVISO = "dialog-warning-symbolic"
ICONO_GRAVE = "dialog-error-symbolic"


_ULTIMO_SELLO = 0


def sello_nuevo() -> int:
    """Un número que no se repite NUNCA. De esto cuelga el nombre de cada dibujo.

    No alcanza con leer el reloj. `time_ns()` promete nanosegundos pero no
    promete resolución, y dos refrescos seguidos pueden caer en la misma
    lectura; y un ajuste de NTP mueve el reloj para atrás, que devolvería un
    sello ya usado. Las dos cosas terminan en el mismo lugar: dos dibujos
    distintos con el mismo nombre, que es exactamente lo que el sello existe
    para evitar (ver `pintar`). El máximo contra el anterior lo cierra.
    """
    global _ULTIMO_SELLO
    _ULTIMO_SELLO = max(time.time_ns(), _ULTIMO_SELLO + 1)
    return _ULTIMO_SELLO


# ── formato ──────────────────────────────────────────────────────────────
def tokens_corto(n: int) -> str:
    """1_234_567 -> «1,2M». Las mismas unidades y la misma coma decimal que usa
    el CLI en `render/barras.ts`: el panel y la terminal dicen el mismo número
    de la misma forma, o son dos implementaciones que se parecen."""
    if n >= 1_000_000_000:
        return f"{n / 1_000_000_000:.1f}".replace(".", ",") + "G"
    if n >= 1_000_000:
        return f"{n / 1_000_000:.1f}".replace(".", ",") + "M"
    if n >= 1_000:
        return f"{n / 1_000:.1f}".replace(".", ",") + "k"
    return str(n)


def corto(nombre: str) -> str:
    """`.claude-teams` -> `teams`; el perfil por defecto -> `main`."""
    return nombre.removeprefix(".claude").lstrip("-") or "main"


# ── el registro ──────────────────────────────────────────────────────────
#
# Este programa no anotaba NADA. Arrancado por el autostart queda como un scope
# de systemd, así que todo lo que escriba a stderr lo levanta el journal solo —
# pero en veinte horas de sesión el journal tenía dos renglones, los que pone
# systemd al abrir y cerrar el scope, porque el programa nunca dijo nada.
#
# Se notó reportando «toco Panel de cuota y se cierra al instante»: no había una
# sola línea que dijera si el panel había llegado a abrirse, ni cuánto había
# durado, ni por qué se había cerrado. Un monitor mudo es el bug que originó
# este repo; el monitor estaba mudo sobre sí mismo.
#
# Va a stderr y no a un archivo propio a propósito: el journal ya rota, ya
# fecha, ya lo sabe leer `journalctl --user`, y `qm --diagnostico` lo recoge de
# ahí. Un archivo nuestro sería una cosa más que mantener y que se llena sola.
#
# QM_SILENCIO=1 lo apaga. No hay nivel de detalle: son unos pocos eventos por
# apertura de panel, no una traza.
SILENCIO = os.environ.get("QM_SILENCIO") == "1"


def registrar(evento: str, **datos) -> None:
    """Un evento por renglón, con sus datos. Nunca puede tirar."""
    if SILENCIO:
        return
    try:
        extra = " ".join(f"{k}={v}" for k, v in datos.items() if v is not None)
        print(f"qm-indicator: {evento}{' ' + extra if extra else ''}", file=sys.stderr, flush=True)
    except Exception:  # noqa: BLE001 — registrar no puede romper al programa
        pass


def faltan(iso: str | None) -> int | None:
    if not iso:
        return None
    try:
        cuando = datetime.fromisoformat(iso.replace("Z", "+00:00"))
    except ValueError:
        return None
    return int((cuando - datetime.now(timezone.utc)).total_seconds())


def al_minuto(iso: str | None) -> str:
    """Un instante ISO recortado al minuto, para usar de clave estable."""
    if not iso:
        return "sin-reinicio"
    try:
        return datetime.fromisoformat(iso.replace("Z", "+00:00")).strftime("%Y-%m-%dT%H:%M")
    except ValueError:
        return iso


def hora_local(iso: str | None) -> str | None:
    """Un instante ISO en HH:MM local, que es la precisión que pide la frase."""
    if not iso:
        return None
    try:
        return datetime.fromisoformat(iso.replace("Z", "+00:00")).astimezone().strftime("%H:%M")
    except ValueError:
        return None


def pct_diario(pre: dict | None) -> float | None:
    """Qué parte del presupuesto de HOY ya se gastó, en porcentaje de ese
    presupuesto. Es lo que llena el medidor de cada cuenta en el item.

    La semanal contesta «cuánto va del período», que en un medidor de 15 px se
    mueve dos píxeles por día: a media semana estaba siempre por la mitad y no
    decía nada de la sesión de trabajo de hoy. El presupuesto diario sí: llega
    al tope cuando gastaste lo que te tocaba hoy, y eso pasa dentro del día.

    None es «no se pudo medir» —no hay dos lecturas de hoy, o no hay ventana
    larga que repartir— y deja la pista vacía: un hueco honesto, nunca un cero.
    """
    if not isinstance(pre, dict) or pre.get("estado") != "ok":
        return None
    gastado = pre.get("gastadoMedido")
    if gastado is None:
        return None
    # El presupuesto de HOY, fijado al arrancar la medición. `porDia` es el de
    # ahora en adelante y ya descontó lo gastado hoy: dividir por él contaba
    # cada punto dos veces. `porDia` queda sólo para un qm anterior.
    por_dia = pre.get("porDiaHoy", pre.get("porDia")) or 0
    # Sin presupuesto —la ventana ya está en 100 %— cualquier gasto es de más.
    if por_dia <= 0:
        return 100.0 if gastado > 0 else 0.0
    return max(0.0, min(100.0, gastado / por_dia * 100.0))


def renglones_presupuesto(pre: dict) -> list[str]:
    """Las mismas tres ramas que `frasePresupuesto` en el núcleo, en dos
    renglones: el del terminal entra en una línea de 100 y acá hay 308 px.

    «hoy te queda X %» se leía como una resta que no ocurría: era el reparto de
    las horas que faltaban del día y bajaba solo con el reloj, sin gastar nada.
    Lo que se resta de verdad es lo gastado; y cuando el historial no cubre la
    mañana se dice desde qué hora se midió, en vez de llamarlo «hoy».

    Partirla es lo contrario de recortarla: con la frase entera en un renglón,
    Pango cortaba justo la hora —«desde las 1…»— y el dato que hace honesto al
    número se perdía en los puntos suspensivos.
    """
    if pre.get("estado") != "ok":
        return [f"presupuesto: {pre['motivo']}"] if pre.get("motivo") else []
    # Con el nombre de la barra pegado, como en el terminal y en el tablero: la
    # tarjeta muestra tres ventanas y el número reparte UNA, y sin decir cuál
    # queda un 24.1 que no cierra con ninguno de los tres porcentajes de arriba.
    barra = pre.get("barra")
    # `porDiaHoy` y `restanteMedido`: el presupuesto fijado al arrancar la
    # medición y la resta ya hecha por el núcleo. Restar de `porDia` contaba dos
    # veces lo gastado hoy. Los de antes quedan para un qm anterior.
    por_dia_hoy = pre.get("porDiaHoy", pre.get("porDia")) or 0
    dia = f"podés gastar {por_dia_hoy:.1f} %/día" + (f" · {barra}" if barra else "")
    gastado, restante = pre.get("gastadoHoy"), pre.get("restanteHoy")
    if gastado is not None and restante is not None:
        return [dia, f"gastaste {gastado:.1f} % hoy · te queda {restante:.1f} %"]
    medido, desde = pre.get("gastadoMedido"), hora_local(pre.get("medidoDesde"))
    if medido is not None and desde is not None:
        queda = pre.get("restanteMedido")
        if queda is None:
            queda = max(0.0, por_dia_hoy - medido)
        return [dia, f"gastaste {medido:.1f} % desde las {desde} · te queda {queda:.1f} %"]
    return [dia, f"de acá a medianoche te toca {pre.get('quedaHoy', 0):.1f} %"]


def nombre_ventana(v: dict) -> str:
    """El nombre ya viene resuelto; el fallback es por si el JSON es viejo."""
    return v.get("nombre") or (
        v["clave"] if not v.get("alcance") else f"{v['clave']} ({v['alcance']})"
    )


# Acá había un `peor()` y un `mostrables()` reimplementados. Eran la MISMA
# regla que vive en src/core/tipos.ts, copiada — y llegó a estar copiada tres
# veces, en Python, JavaScript y Swift. Una regla en tres lenguajes vale
# distinto en cuanto alguien toca uno solo, y justamente esta es la que evita
# que un 75 % con aviso quede tapado por un 8 % que se ve más lindo.
#
# Ahora `qm --json` manda `mostrar`, `frena`, `sesion` y `semanal` ya resueltas
# y esto sólo dibuja, que es lo que dice el docstring de arriba de todo.


# ── el panel ─────────────────────────────────────────────────────────────
# GNOME no deja dibujar adentro del menú de la barra: la extensión que convierte
# un KStatusNotifierItem en un item de arriba manda los renglones por DBus y del
# otro lado hace `label.set_text(...)` — texto pelado, sin markup — y los iconos
# los mete en un St.Icon de 16 px. O sea que ni colores ni medidores ni curvas
# entran ahí. Lo que sí se puede es abrir una ventana propia y dibujarla, que es
# lo que hace esto: las mismas dos vistas del panel de macOS (bin/qm-barra.swift,
# VistaResumen y VistaCuenta), con las mismas medidas y la misma paleta.
#
# Va por X11 (XWayland) a propósito: en Wayland un cliente no puede elegir dónde
# se pone su ventana, y un panel que aparece en el medio de la pantalla en vez de
# abajo del ícono no es el panel de macOS. Con GDK_BACKEND=x11 el move() manda.

# El panel es más ancho y más aireado que el de macOS: la tipografía de GNOME
# —Cantarell— es más grande de cuerpo que la del sistema de Apple, y con las
# medidas de allá los renglones quedaban apretados y el texto rozando el borde.
ANCHO_PANEL = 360
MARGEN = 12
# Cada cuenta va en una tarjeta redondeada, que es como GNOME agrupa cosas
# (la «boxed list» de libadwaita), en vez de la línea de pelo que separa las
# secciones en macOS.
PAD_TARJETA = 14
RADIO_TARJETA = 12
ENTRE_TARJETAS = 8
ALTO_CABECERA = 76
# El renglón de abajo de todo: cuándo vuelve a preguntar.
ALTO_PIE_LECTURA = 26
VIEJO_SEGUNDOS = 6 * 3600


def _hex(c: str, alfa: float = 1.0):
    return (int(c[1:3], 16) / 255, int(c[3:5], 16) / 255, int(c[5:7], 16) / 255, alfa)


# La paleta de estado es la de GNOME (Adwaita), no la de macOS: son los mismos
# cuatro estados, con los colores que el escritorio ya usa para decirlos, y con
# la variante que cada fondo pide — un verde que se lee sobre blanco se apaga
# sobre negro y al revés.
NIVELES_CLARO = {"ok": "#26a269", "atento": "#e5a50a", "aviso": "#ff7800", "critico": "#c01c28"}
NIVELES_OSCURO = {"ok": "#33d17a", "atento": "#f6d32d", "aviso": "#ffa348", "critico": "#f66151"}
# El color de cada cuenta, deliberadamente lejos de la paleta de estado: verde,
# ámbar y rojo ya significan algo y no pueden significar además «cuenta 2». Azul,
# violeta y rosa no se confunden con «vas bien» ni con «te frenaste».
CUENTAS_CLARO = ["#1c71d8", "#813d9c", "#c9208a"]
CUENTAS_OSCURO = ["#62a0ea", "#c061cb", "#ed67b0"]


def nivel_de(pct: float, preocupa: bool) -> str:
    if pct >= 95:
        return "critico"
    if preocupa or pct >= 80:
        return "aviso"
    if pct >= 60:
        return "atento"
    return "ok"


def duracion(segundos: int) -> str:
    """La escalera de duración del proyecto.

    El canon es `duracion()` en src/render/barras.ts, que es por donde pasa todo
    lo que imprime el CLI, y está congelado en test/fixtures/duraciones.json.
    Las cuatro implementaciones —ésta, la de TypeScript, la de Swift y la de
    PowerShell— tienen que dar exactamente lo mismo, y `make gate-duraciones` lo
    comprueba corriéndolas, no leyéndolas.

    Había dos convenciones conviviendo: las tres GUIs decían `ya`, `1h` y `1d0h`
    donde el CLI decía `vencido`, `1h00m` y `1d`. Sobrevivió porque nadie había
    comparado una GUI contra el CLI. Ganó el CLI: es donde el propio repo dice
    que pasa todo lo que se imprime, y es la única con tests.
    """
    if segundos < 0:
        return "vencido"
    h, m = segundos // 3600, (segundos % 3600) // 60
    if h >= 24:
        d = h // 24
        return f"{d}d" if h % 24 == 0 else f"{d}d{h % 24}h"
    if h > 0:
        return f"{h}h{m:02d}m"
    if m > 0:
        return f"{m}m"
    return f"{segundos}s"


def cuenta_regresiva(segundos: float) -> str:
    """Como dur_larga, pero sin tirar los segundos abajo de la hora.

    dur_larga habla de duraciones que se reportan —«reinicia en 2d14h»— y ahí
    los segundos son ruido. Esto es un reloj que baja a la vista: si dijera sólo
    los minutos cambiaría una vez por minuto, y una cuenta regresiva que no se
    mueve no parece una cuenta regresiva, parece un número roto.
    """
    seg = max(0, int(segundos))
    if seg >= 3600:
        return duracion(seg)
    if seg >= 60:
        return f"{seg // 60}m {seg % 60:02d}s"
    return f"{seg}s"


def cada_cuanto(historia: list) -> float | None:
    """Cada cuánto se lee la cuota de verdad, en segundos.

    No es la cadencia que este programa se propone: es la MEDIDA. El historial
    se indexa por `medidoEn` —el instante que informa el servidor, no el momento
    en que qm miró el disco— así que cada muestra es una lectura real y los
    huecos entre muestras son los intervalos entre lectura y lectura. Va la
    mediana y no el promedio: una sola pausa larga (la máquina suspendida, por
    ejemplo) desplaza el promedio y no dice nada del ritmo normal.
    """
    ts = sorted(t for t, _ in historia)
    huecos = sorted(b - a for a, b in zip(ts, ts[1:]) if b > a)
    if not huecos:
        return None
    return huecos[len(huecos) // 2] / 1000


def reinicio(segundos: int | None) -> str:
    """«reinicia en vencido» no es castellano. Cuando ya pasó, se dice que pasó."""
    if segundos is None:
        return ""
    return "reinicio vencido" if segundos < 0 else f"reinicia en {duracion(segundos)}"


class Tema:
    """Los dos fondos posibles, con los grises de GNOME.

    El panel vive adentro de un menú de GTK, así que el fondo y la sombra los
    pone el tema del escritorio: acá sólo se define lo que se dibuja encima.
    """

    def __init__(self, oscuro: bool) -> None:
        self.oscuro = oscuro
        if oscuro:
            self.etiqueta = _hex("#ffffff")
            self.secundario = _hex("#ffffff", 0.70)
            self.terciario = _hex("#ffffff", 0.45)
            self.tarjeta = _hex("#ffffff", 0.06)
            self.borde_tarjeta = _hex("#ffffff", 0.08)
            self.pista = _hex("#ffffff", 0.15)
        else:
            self.etiqueta = _hex("#000000", 0.87)
            self.secundario = _hex("#000000", 0.65)
            self.terciario = _hex("#000000", 0.45)
            self.tarjeta = _hex("#000000", 0.04)
            self.borde_tarjeta = _hex("#000000", 0.07)
            self.pista = _hex("#000000", 0.15)

    @staticmethod
    def desde(widget) -> "Tema":
        """El tema que de verdad tiene el widget que va abajo del dibujo.

        Preguntarle a un ajuste y dibujar sobre otra cosa es exactamente cómo el
        panel terminó blanco sobre blanco. El color de texto del propio menú no
        puede mentir: si es claro, el fondo es oscuro.
        """
        try:
            c = widget.get_style_context().get_color(Gtk.StateFlags.NORMAL)
            luz = 0.2126 * c.red + 0.7152 * c.green + 0.0722 * c.blue
            tema = Tema(luz > 0.5)
            # Y los grises salen de ESE color, no de un blanco o un negro
            # supuestos: así el contraste es el que el tema ya eligió.
            base = (c.red, c.green, c.blue)
            tema.etiqueta = base + (1.0,)
            tema.secundario = base + (0.72,)
            tema.terciario = base + (0.46,)
            tema.tarjeta = base + (0.06,)
            tema.borde_tarjeta = base + (0.10,)
            tema.pista = base + (0.16,)
            return tema
        except (AttributeError, TypeError):
            return tema_actual()

    def nivel(self, clave: str):
        return _hex((NIVELES_OSCURO if self.oscuro else NIVELES_CLARO)[clave])

    def color_cuenta(self, i: int):
        tabla = CUENTAS_OSCURO if self.oscuro else CUENTAS_CLARO
        return _hex(tabla[i % len(tabla)])


def prefiere_oscuro() -> bool | None:
    """Lo que dice GNOME, o None si no lo dice."""
    try:
        fuente = Gio.SettingsSchemaSource.get_default()
        esquema = fuente.lookup("org.gnome.desktop.interface", True) if fuente else None
        if esquema is not None and esquema.has_key("color-scheme"):
            v = Gio.Settings.new("org.gnome.desktop.interface").get_string("color-scheme")
            if v == "prefer-dark":
                return True
            if v == "prefer-light":
                return False
    except (GLib.Error, AttributeError, TypeError):
        pass
    return None


def alinear_tema_gtk() -> None:
    """Que GTK3 se entere de que GNOME está en oscuro.

    Esto no es cosmética, es el bug que dejaba el panel ilegible: GNOME dice
    `color-scheme = prefer-dark` y el dibujo se pintaba con letras blancas, pero
    una app GTK3 no se entera sola —su `gtk-application-prefer-dark-theme` sigue
    en False— así que el menú que hace de fondo se dibujaba CLARO. Blanco sobre
    blanco, y no se leía nada.
    """
    oscuro = prefiere_oscuro()
    if oscuro is None:
        return
    try:
        Gtk.Settings.get_default().set_property("gtk-application-prefer-dark-theme", oscuro)
    except (AttributeError, TypeError):
        pass


def tema_actual() -> Tema:
    oscuro = prefiere_oscuro()
    if oscuro is not None:
        return Tema(oscuro)
    try:
        cfg = Gtk.Settings.get_default()
        if cfg.get_property("gtk-application-prefer-dark-theme"):
            return Tema(True)
        return Tema("dark" in (cfg.get_property("gtk-theme-name") or "").lower())
    except (AttributeError, TypeError):
        return Tema(True)


def familia_del_sistema() -> str:
    """La tipografía de la interfaz, sin el cuerpo que trae pegado."""
    try:
        nombre = Gtk.Settings.get_default().get_property("gtk-font-name") or ""
    except (AttributeError, TypeError):
        nombre = ""
    fd = Pango.FontDescription(nombre) if nombre else Pango.FontDescription()
    return fd.get_family() or "Cantarell"


# Se resuelven en main(), cuando Gtk ya leyó los ajustes del escritorio.
TEMA = Tema(True)
FAMILIA = "Cantarell"


# ── dibujo ───────────────────────────────────────────────────────────────
def _color(cr, c) -> None:
    cr.set_source_rgba(c[0], c[1], c[2], c[3] if len(c) > 3 else 1.0)


def _redondeado(cr, x, y, w, h, r) -> None:
    r = min(r, w / 2, h / 2)
    cr.new_sub_path()
    cr.arc(x + w - r, y + r, r, -math.pi / 2, 0)
    cr.arc(x + w - r, y + h - r, r, 0, math.pi / 2)
    cr.arc(x + r, y + h - r, r, math.pi / 2, math.pi)
    cr.arc(x + r, y + r, r, math.pi, 3 * math.pi / 2)
    cr.close_path()


class Pluma:
    """Texto en píxeles, no en puntos.

    Las medidas del panel de macOS son píxeles a 1x. Pango, si le pasás un
    cuerpo en puntos, lo convierte a 96 dpi y un 13 se vuelve 17: el panel
    entero queda un tercio más grande y los renglones se pisan. Por eso todo
    va por set_absolute_size().
    """

    def __init__(self, cr, familia: str) -> None:
        self.cr = cr
        self.familia = familia

    def caja(self, texto: str, px: float, peso=Pango.Weight.NORMAL, ancho=None,
             tabular=False, elipsis=False):
        lay = PangoCairo.create_layout(self.cr)
        fd = Pango.FontDescription()
        fd.set_family(self.familia)
        fd.set_weight(peso)
        fd.set_absolute_size(px * Pango.SCALE)
        lay.set_font_description(fd)
        if tabular:
            # Cifras de ancho fijo: sin esto el porcentaje, que va pegado al
            # borde derecho, baila un píxel cada vez que cambia un dígito.
            try:
                attrs = Pango.AttrList()
                attrs.insert(Pango.attr_font_features_new("tnum=1"))
                lay.set_attributes(attrs)
            except (AttributeError, TypeError):
                pass
        if ancho is not None:
            lay.set_width(int(ancho * Pango.SCALE))
            if elipsis:
                # Un renglón que no se puede achicar: se corta con puntos.
                # Cairo no recorta nada por su cuenta, así que sin esto un
                # nombre de perfil largo se dibuja por encima del borde de la
                # tarjeta y sale del panel.
                lay.set_single_paragraph_mode(True)
                lay.set_ellipsize(Pango.EllipsizeMode.END)
            else:
                lay.set_wrap(Pango.WrapMode.WORD_CHAR)
        lay.set_text(texto, -1)
        return lay

    def alto(self, *a, **k) -> float:
        return self.caja(*a, **k).get_pixel_size()[1]

    def ancho(self, *a, **k) -> float:
        return self.caja(*a, **k).get_pixel_size()[0]

    def escribir(self, x, y, texto, px, color, peso=Pango.Weight.NORMAL,
                 derecha=None, ancho=None, tabular=False, elipsis=False):
        lay = self.caja(texto, px, peso, ancho=ancho, tabular=tabular, elipsis=elipsis)
        w, h = lay.get_pixel_size()
        _color(self.cr, color)
        self.cr.move_to(derecha - w if derecha is not None else x, y)
        PangoCairo.show_layout(self.cr, lay)
        return h

    def linea_base(self, texto: str, px: float, peso=Pango.Weight.NORMAL) -> float:
        return self.caja(texto, px, peso).get_baseline() / Pango.SCALE


def glifo_producto(cr, producto: str, color, x: float, y: float, lado: float) -> None:
    """La marca de cada producto, dibujada: ni Claude ni Codex tienen ícono en
    ningún tema. El asterisco es la forma de la de Claude; los chevrones, código.
    """
    cx, cy = x + lado / 2, y + lado / 2
    cr.save()
    cr.set_line_width(1.3)
    cr.set_line_cap(cairo.LINE_CAP_ROUND)
    _color(cr, color)
    if producto == "opencode":
        r0 = lado * 0.34
        cr.move_to(cx, cy - r0)
        cr.line_to(cx + r0, cy)
        cr.line_to(cx, cy + r0)
        cr.line_to(cx - r0, cy)
        cr.close_path()
    elif producto == "codex":
        a, hueco = lado * 0.30, lado * 0.20
        cr.move_to(cx - hueco, cy - a)
        cr.line_to(cx - hueco - a * 0.85, cy)
        cr.line_to(cx - hueco, cy + a)
        cr.move_to(cx + hueco, cy - a)
        cr.line_to(cx + hueco + a * 0.85, cy)
        cr.line_to(cx + hueco, cy + a)
    else:
        r0 = lado * 0.36
        for k in range(3):
            ang = k * math.pi / 3
            cr.move_to(cx + r0 * math.cos(ang), cy + r0 * math.sin(ang))
            cr.line_to(cx - r0 * math.cos(ang), cy - r0 * math.sin(ang))
    cr.stroke()
    cr.restore()


# ── lo que se dibuja de cada cuenta ──────────────────────────────────────
class VistaCuenta:
    """Una cuenta del panel, en su tarjeta: cabecera, un renglón por barra, la
    curva pegada a la que frena, y el ritmo. Mide primero y dibuja después,
    porque el menú necesita el alto antes de que exista nada.
    """

    # Un renglón de barra = nombre (18) + medidor (11) + pie (16). Si esto no
    # coincide con lo que dibuja pintar(), los renglones se pisan.
    ALTO_BARRA = 45
    # 18 de curva + 16 de rótulos.
    ALTO_CURVA = 34

    def __init__(self, p: dict, indice_color: int) -> None:
        cuota = p.get("cuota") or {}
        self.producto = p.get("producto") or "claude"
        self.indice_color = indice_color
        self.titulo = corto(p.get("perfil") or "?")
        partes = [x for x in (p.get("cuenta"), p.get("plan")) if x]
        self.sub = "   ·   ".join(partes)
        self.hay_numero = cuota.get("estado") == "ok"
        self.frase = None if self.hay_numero else (cuota.get("frase") or "sin cuota")
        self.historia = [
            (m["t"], m["porcentaje"])
            for m in (cuota.get("historia") or [])
            if "t" in m and "porcentaje" in m
        ]
        frena = cuota.get("frena")
        self.clave_frena = frena.get("nombre") if frena else None
        proy = p.get("proyeccion")
        sube = bool(proy and proy.get("estado") == "sube")
        choca = bool(sube and proy.get("chocasAntesDelReinicio"))
        edad = cuota.get("edadSegundos")

        self.barras = []
        for v in (cuota.get("mostrar") or []) if self.hay_numero else []:
            pie = reinicio(faltan(v.get("reinicia")))
            es_la_que_frena = bool(frena and v.get("clave") == frena.get("clave"))
            self.barras.append({
                "nombre": nombre_ventana(v),
                "pct": v.get("porcentaje", 0),
                "nivel": nivel_de(v.get("porcentaje", 0),
                                  v.get("preocupa", False) or (choca and es_la_que_frena)),
                "activa": bool(v.get("activa")),
                "pie": pie,
            })

        self.ritmo = None
        if sube:
            seg = faltan(proy.get("techo"))
            # Una proyección con el techo en el pasado ya no proyecta nada: se
            # leía «100 % en vencido», que no quiere decir nada. Cuando ya
            # tocaste el techo la pregunta es cuándo te liberás, y ésa la
            # contesta la cabecera.
            if seg is not None and seg > 0:
                self.ritmo = (f"{proy.get('ritmoPuntosPorHora', 0):.1f} pts/h · 100 % en "
                              f"{duracion(seg)}"
                              + (" — antes del reinicio" if choca else ""))
        self.ritmo_rojo = choca

        # El presupuesto diario: cuánto por día para que la ventana larga
        # llegue entera al reinicio, y cuánto de eso queda hoy. La cuenta
        # —incluido CUÁL ventana se reparte— viene hecha del núcleo.
        self.presupuesto = []
        if self.hay_numero:
            self.presupuesto = renglones_presupuesto(p.get("presupuesto") or {})

        # Cada cuánto se lee ESTA cuenta y cuándo fue la última: la pregunta
        # «¿este número de cuándo es?» no se contesta con un porcentaje.
        self.lecturas = None
        if self.hay_numero:
            partes = []
            cada = cada_cuanto(self.historia)
            if cada is not None:
                partes.append(f"cada ~{duracion(int(cada))}")
            if edad is not None:
                partes.append(f"última hace {duracion(edad)}"
                              + (" · viejo" if edad >= VIEJO_SEGUNDOS else ""))
            self.lecturas = "lecturas:  " + "   ·   ".join(partes) if partes else None

        # Por qué esta cuenta quedó al fondo y no encabeza. El núcleo ya lo
        # resolvió y lo escribió en palabras; acá sólo se dibuja. Una cuenta
        # que cambia de lugar sin decir por qué es indistinguible de un bug.
        rel = p.get("relevancia") or {}
        self.dormida = None
        if rel.get("dormida"):
            self.dormida = "dormida:  " + "   ·   ".join(rel.get("porque") or [])

    @staticmethod
    def _ancho_contenido() -> float:
        return ANCHO_PANEL - 2 * MARGEN - 2 * PAD_TARJETA

    def medir(self, pluma: Pluma) -> float:
        alto = PAD_TARJETA + 20 + (17 if self.sub else 0) + 6
        if self.frase is not None:
            return alto + pluma.alto(self.frase, 11.5, ancho=self._ancho_contenido()) + PAD_TARJETA
        alto += len(self.barras) * self.ALTO_BARRA
        if self.clave_frena and len(self.historia) >= 3:
            alto += self.ALTO_CURVA
        if self.ritmo:
            alto += 20
        if self.presupuesto:
            # 16 por renglón, y 4 de aire arriba del bloque.
            alto += 4 + 16 * len(self.presupuesto)
        if self.lecturas:
            alto += 17
        if self.dormida:
            alto += 17
        return alto + PAD_TARJETA - 4

    def _curva(self, cr, pluma, caja, color) -> None:
        """Las muestras recientes, dibujadas. El eje Y va del mínimo al máximo
        de la serie y no de 0 a 100: lo que interesa acá es la PENDIENTE, y a
        escala completa una subida de tres puntos se ve plana."""
        x0, y0, w, h = caja
        ts = [m[0] for m in self.historia]
        ps = [float(m[1]) for m in self.historia]
        t_min, t_max = min(ts), max(ts)
        p_min, p_max = min(ps), max(ps)
        if t_max <= t_min:
            return
        rango = max(1.0, p_max - p_min)
        px = lambda t: x0 + w * (t - t_min) / (t_max - t_min)
        py = lambda p: y0 + h - h * (p - p_min) / rango

        cr.move_to(px(ts[0]), y0 + h)
        for t, p in zip(ts, ps):
            cr.line_to(px(t), py(p))
        cr.line_to(px(ts[-1]), y0 + h)
        cr.close_path()
        _color(cr, color[:3] + (0.16,))
        cr.fill()

        cr.set_line_width(1.5)
        cr.set_line_join(cairo.LINE_JOIN_ROUND)
        cr.move_to(px(ts[0]), py(ps[0]))
        for t, p in list(zip(ts, ps))[1:]:
            cr.line_to(px(t), py(p))
        _color(cr, color)
        cr.stroke()

        cr.arc(px(ts[-1]), py(ps[-1]), 2.5, 0, 2 * math.pi)
        _color(cr, color)
        cr.fill()

        horas = (t_max - t_min) / 3_600_000
        pluma.escribir(x0, y0 + h + 2, f"{p_min:.0f}%", 9.5, TEMA.terciario)
        pluma.escribir(0, y0 + h + 2,
                       f"últimas {horas:.1f} h" if horas >= 1 else "última hora",
                       9.5, TEMA.terciario, derecha=x0 + w)

    def pintar(self, cr, pluma: Pluma, arriba: float) -> float:
        alto = self.medir(pluma)
        # La tarjeta: así agrupa GNOME, con una caja redondeada y un fondo
        # apenas distinto, en vez de la línea de pelo de macOS.
        _redondeado(cr, MARGEN + 0.5, arriba + 0.5,
                    ANCHO_PANEL - 2 * MARGEN - 1, alto - 1, RADIO_TARJETA)
        _color(cr, TEMA.tarjeta)
        cr.fill_preserve()
        _color(cr, TEMA.borde_tarjeta)
        cr.set_line_width(1)
        cr.stroke()

        ix = MARGEN + PAD_TARJETA
        ancho = self._ancho_contenido()
        der = ix + ancho
        y = arriba + PAD_TARJETA

        glifo_producto(cr, self.producto, TEMA.color_cuenta(self.indice_color), ix, y + 2, 14)
        pluma.escribir(ix + 21, y, self.titulo, 13.5, TEMA.etiqueta, Pango.Weight.BOLD,
                       ancho=ancho - 21, elipsis=True)
        y += 20
        if self.sub:
            pluma.escribir(ix + 21, y, self.sub, 11, TEMA.terciario,
                           ancho=ancho - 21, elipsis=True)
            y += 17
        y += 6

        if self.frase is not None:
            pluma.escribir(ix, y, self.frase, 11.5, TEMA.secundario, ancho=ancho)
            return arriba + alto

        for b in self.barras:
            nombre = f"{b['nombre']}  ▸" if b["activa"] else b["nombre"]
            cifra = f"{b['pct']:.0f}%"
            # El nombre cede: el número es el dato y nunca se recorta.
            hueco = ancho - pluma.ancho(cifra, 12, Pango.Weight.BOLD, tabular=True) - 12
            pluma.escribir(ix, y, nombre, 11.5,
                           TEMA.etiqueta if b["activa"] else TEMA.secundario,
                           Pango.Weight.MEDIUM if b["activa"] else Pango.Weight.NORMAL,
                           ancho=hueco, elipsis=True)
            pluma.escribir(0, y - 0.5, cifra, 12, TEMA.etiqueta,
                           Pango.Weight.BOLD, derecha=der, tabular=True)
            y += 18
            # El medidor: pista tenue y relleno con el color del estado.
            _redondeado(cr, ix, y, ancho, 5, 2.5)
            _color(cr, TEMA.pista)
            cr.fill()
            lleno = max(5.0, ancho * max(0.0, min(100.0, b["pct"])) / 100.0)
            _redondeado(cr, ix, y, lleno, 5, 2.5)
            _color(cr, TEMA.nivel(b["nivel"]))
            cr.fill()
            y += 11
            if b["pie"]:
                pluma.escribir(ix, y, b["pie"], 10.5, TEMA.terciario, ancho=ancho, elipsis=True)
            y += 16
            # La curva va pegada a la barra que frena: es de ella.
            if b["nombre"] == self.clave_frena and len(self.historia) >= 3:
                self._curva(cr, pluma, (ix, y - 2, ancho, 18), TEMA.nivel(b["nivel"]))
                y += self.ALTO_CURVA

        if self.ritmo:
            y += 4
            pluma.escribir(ix, y, self.ritmo, 11,
                           TEMA.nivel("critico") if self.ritmo_rojo else TEMA.terciario,
                           Pango.Weight.MEDIUM if self.ritmo_rojo else Pango.Weight.NORMAL,
                           ancho=ancho, elipsis=True)
            y += 16
        # El ritmo dice hacia dónde vas; el presupuesto, a cuánto tendrías que
        # ir para que la cuota llegue al reinicio. Van pegados.
        if self.presupuesto:
            if not self.ritmo:
                y += 4
            for renglon in self.presupuesto:
                pluma.escribir(ix, y, renglon, 11, TEMA.secundario,
                               ancho=ancho, elipsis=True)
                y += 16
        if self.lecturas:
            if not self.ritmo and not self.presupuesto:
                y += 4
            pluma.escribir(ix, y, self.lecturas, 10.5, TEMA.terciario, ancho=ancho, elipsis=True)
            y += 17
        if self.dormida:
            if not self.ritmo and not self.presupuesto and not self.lecturas:
                y += 4
            pluma.escribir(ix, y, self.dormida, 10.5, TEMA.terciario, ancho=ancho, elipsis=True)
        return arriba + alto


class VistaSinCuota:
    """Las cuentas que todavía no tienen número DE CUOTA, juntas en una tarjeta.

    Cada una ocupaba una tarjeta entera para decir la misma frase, y el panel
    —que en una pantalla de 768 px ya no entra— gastaba doscientos píxeles en
    repetirla. Juntas además se leen mejor: no son tres misterios distintos,
    es un hecho con varios nombres.

    Sin cuota NO es sin dato. El consumo local se sabe —se lee del disco, sin
    red y sin credencial— y la terminal siempre lo dijo; el panel lo tiraba.
    Una cuenta que gastó seis millones de tokens esta semana aparecía acá
    exactamente igual que una que no se tocó desde junio, y eso no es «no hay
    porcentaje»: es borrar lo único que sí se puede afirmar. El número va
    pegado al nombre, y sólo cuando hay algo que contar: un «0» al lado de cada
    cuenta dormida sería ruido con la misma forma que un dato.
    """

    def __init__(self, cuentas: list[tuple[str, str, int]]) -> None:
        # Agrupadas por frase y en el orden en que aparecieron: dos cuentas
        # pueden estar calladas por motivos distintos, y ahí la frase importa.
        self.grupos: list[tuple[str, list[str]]] = []
        for nombre, frase, tokens in cuentas:
            etiqueta = f"{nombre} {tokens_corto(tokens)}" if tokens > 0 else nombre
            for f, nombres in self.grupos:
                if f == frase:
                    nombres.append(etiqueta)
                    break
            else:
                self.grupos.append((frase, [etiqueta]))

    @staticmethod
    def _ancho_contenido() -> float:
        return ANCHO_PANEL - 2 * MARGEN - 2 * PAD_TARJETA

    def medir(self, pluma: Pluma) -> float:
        alto = PAD_TARJETA
        for frase, nombres in self.grupos:
            alto += 18 + pluma.alto(frase, 10.5, ancho=self._ancho_contenido()) + 8
        return alto + PAD_TARJETA - 8

    def pintar(self, cr, pluma: Pluma, arriba: float) -> float:
        alto = self.medir(pluma)
        _redondeado(cr, MARGEN + 0.5, arriba + 0.5,
                    ANCHO_PANEL - 2 * MARGEN - 1, alto - 1, RADIO_TARJETA)
        _color(cr, TEMA.tarjeta)
        cr.fill_preserve()
        _color(cr, TEMA.borde_tarjeta)
        cr.set_line_width(1)
        cr.stroke()

        ix = MARGEN + PAD_TARJETA
        y = arriba + PAD_TARJETA
        for frase, nombres in self.grupos:
            pluma.escribir(ix, y, "   ·   ".join(nombres), 11.5, TEMA.secundario,
                           Pango.Weight.MEDIUM, ancho=self._ancho_contenido(), elipsis=True)
            y += 18
            y += pluma.escribir(ix, y, frase, 10.5, TEMA.terciario,
                                ancho=self._ancho_contenido())
            y += 8
        return arriba + alto


class VistaResumen:
    """La cabecera: la respuesta de una línea. La misma pregunta que contesta el
    héroe del tablero —qué me frena primero, en toda la máquina— y que si no
    está acá hay que sacarla comparando las cuentas a ojo."""

    def __init__(self, cuenta: str, barra: str, pct: float, nivel: str, reinicia) -> None:
        self.cuenta, self.barra, self.pct = cuenta, barra, pct
        self.nivel, self.reinicia = nivel, reinicia

    @staticmethod
    def desde(datos: dict) -> "VistaResumen | None":
        """Lee quién encabeza del JSON. NO lo vuelve a decidir.

        Acá adentro había un `for` que se quedaba con el `frena` de porcentaje
        más alto. Decía lo mismo que el CLI sólo por casualidad, y dejó de
        decirlo el día que el criterio cambió: una cuenta dormida en 100 % ya no
        encabeza, y esta copia no se había enterado. La misma elección estaba
        escrita seis veces, una por pantalla.

        CONTRIBUTING.md lo dice así: una regla que un renderer tiene que
        reimplementar es un bug del CLI. Ahora el CLI la emite en
        `frenaPrimero` y esto sólo la busca.
        """
        lider = datos.get("frenaPrimero")
        if not lider:
            return None
        v = lider.get("ventana")
        if not v:
            return None
        # El perfil completo, para la proyección. Si no aparece —no debería—
        # igual se dibuja la cabecera con lo que vino.
        p = next((x for x in datos.get("perfiles", [])
                  if x.get("perfil") == lider.get("perfil")), {})
        proy = p.get("proyeccion")
        choca = bool(proy and proy.get("estado") == "sube" and proy.get("chocasAntesDelReinicio"))
        nombre = p.get("perfil") or lider.get("perfil") or "?"
        return VistaResumen(corto(nombre), nombre_ventana(v), v["porcentaje"],
                            nivel_de(v["porcentaje"], v.get("preocupa", False) or choca),
                            v.get("reinicia"))

    def pintar(self, cr, pluma: Pluma, arriba: float) -> float:
        color = TEMA.nivel(self.nivel)
        lado = 46.0
        izq = MARGEN + 6
        centro = (izq + lado / 2, arriba + ALTO_CABECERA / 2 - 2)
        radio = lado / 2 - 3

        cr.set_line_width(5.5)
        cr.set_line_cap(cairo.LINE_CAP_BUTT)
        cr.arc(centro[0], centro[1], radio, 0, 2 * math.pi)
        _color(cr, color[:3] + (0.20,))
        cr.stroke()

        frac = max(0.0, min(100.0, self.pct)) / 100.0
        if frac > 0:
            cr.set_line_cap(cairo.LINE_CAP_ROUND)
            cr.arc(centro[0], centro[1], radio, -math.pi / 2, -math.pi / 2 + 2 * math.pi * frac)
            _color(cr, color)
            cr.stroke()

        x = izq + lado + 14
        pluma.escribir(x, arriba + 12, "Lo primero que te frena", 10.5, TEMA.terciario,
                       Pango.Weight.SEMIBOLD, ancho=ANCHO_PANEL - MARGEN - x, elipsis=True)
        cifra = f"{self.pct:.0f}%"
        y_cifra = arriba + 26
        ancho_cifra = pluma.ancho(cifra, 22, Pango.Weight.BOLD, tabular=True)
        pluma.escribir(x, y_cifra, cifra, 22, TEMA.etiqueta, Pango.Weight.BOLD, tabular=True)
        # El nombre va a la derecha de la cifra, sobre su misma línea de base.
        corrimiento = (pluma.linea_base(cifra, 22, Pango.Weight.BOLD)
                       - pluma.linea_base("x", 12))
        pluma.escribir(x + ancho_cifra + 8, y_cifra + corrimiento,
                       f"{self.cuenta} · {self.barra}", 12, TEMA.secundario,
                       ancho=ANCHO_PANEL - MARGEN - (x + ancho_cifra + 8), elipsis=True)

        seg = faltan(self.reinicia)
        if seg is None:
            texto, urgente = "sin reinicio informado", False
        elif self.pct >= 95:
            # Cuando ya te frenó, lo que importa no es cuándo «reinicia»: es
            # cuándo volvés a poder trabajar. Misma fecha, otra pregunta.
            texto, urgente = f"libre en {duracion(seg)}", True
        else:
            texto, urgente = reinicio(seg), False
        pluma.escribir(x, arriba + 54, texto, 11, color if urgente else TEMA.terciario,
                       Pango.Weight.MEDIUM if urgente else Pango.Weight.NORMAL,
                       ancho=ANCHO_PANEL - MARGEN - x, elipsis=True)
        return arriba + ALTO_CABECERA


# ── el item de la barra, dibujado ────────────────────────────────────────
# Un medidor vertical por cuenta, en el orden del menú, lleno hasta la SESIÓN de
# 5 h y pintado por severidad. Es el mismo dibujo que el item de la barra de
# macOS (bin/qm-barra.swift, medidores()) y con las mismas medidas: tres cuentas
# entran en el ancho de una palabra.
#
# Entra en la barra de GNOME por una puerta que la extensión deja abierta sin
# documentar: si el nombre del ícono empieza con «/» lo toma como un archivo, y
# si esa imagen es ANCHA —`width >= height * 1.5`— la dibuja a lo ancho en vez
# de encajarla en el cuadrado de 16 px de un ícono. Abajo de esa proporción se
# vuelve un ícono cuadrado y los medidores quedan ilegibles, así que el ancho
# se rellena hasta cruzarla.
ALTO_ITEM = 22
ALTO_MEDIDOR = 15
ANCHO_MEDIDOR = 3
ENTRE_GRUPOS = 5
LADO_GLIFO = 9
AIRE_GLIFO = 2
AIRE_NUMERO = 3
# La proporción que separa «imagen ancha» de «ícono cuadrado», con un margen
# para no quedar justo en el filo.
PROPORCION_ANCHA = 1.6


def _numero_de(t: dict) -> str | None:
    """El número de cada cuenta es el de la SESIÓN de 5 h: es el que contesta
    «¿puedo seguir trabajando ahora?». La semanal se sigue viendo —es el
    medidor, con su color— sin gastar dígitos.

    Sin marca de cache viejo: un `~` pegado al número obliga a saber qué
    significa para poder leer el número, y la edad del cache ya está escrita con
    todas las letras en el panel, que es donde se la va a buscar.
    """
    if t["sesion"] is None:
        return None
    return f"{t['sesion']:.0f}"


def piezas_de(datos, avisar=None) -> list[dict]:
    """Una pieza por cuenta con número, en el orden del panel.

    Sólo entran las cuentas que tienen un número. Una cuenta sin cuota no se
    dibuja como un medidor vacío —eso se leería como «0 %, todo bien»—: su
    frase está en el panel.
    """
    piezas: list[dict] = []
    if not isinstance(datos, dict):
        return piezas
    for p in datos.get("perfiles", []):
        cuota = p.get("cuota") or {}
        frena = cuota.get("frena") if cuota.get("estado") == "ok" else None
        if frena is None:
            continue
        proy = p.get("proyeccion")
        chocas = bool(proy and proy["estado"] == "sube" and proy["chocasAntesDelReinicio"])
        # Una cuenta dormida no alarma. El `!` del item y la notificación de
        # escritorio existen para avisarte de algo que te va a frenar; una
        # cuenta que nadie usa, en 100 % desde hace semanas, no te frena nada y
        # el aviso es puro ruido — el mismo ruido que hizo que alguien quisiera
        # esconderla, que es lo que este repo no quiere que haga falta.
        dormida = bool((p.get("relevancia") or {}).get("dormida"))

        def alerta(v, _frena=frena, _chocas=chocas, _dormida=dormida) -> bool:
            if not v or _dormida:
                return False
            return bool(v.get("preocupa")) or (_chocas and v.get("clave") == _frena.get("clave"))

        ses, sem = cuota.get("sesion"), cuota.get("semanal")
        diario = pct_diario(p.get("presupuesto"))
        nombre = corto(p["perfil"])
        piezas.append({
            "nombre": nombre,
            "perfil": p["perfil"],
            "producto": p.get("producto") or "claude",
            "indice": len(piezas),
            "sesion": ses.get("porcentaje") if ses else None,
            "sesion_alerta": alerta(ses),
            "semanal": sem.get("porcentaje") if sem else None,
            "semanal_alerta": alerta(sem),
            # Cuánto del presupuesto de HOY ya se gastó: es lo que llena el
            # medidor. None deja la pista vacía.
            "diario": diario,
            # Cuándo se reinicia cada una. Lo usa `calentar()` para saber si el
            # número que tiene es de una ventana que ya cerró.
            "reinicia_sesion": ses.get("reinicia") if ses else None,
            "reinicia_semanal": sem.get("reinicia") if sem else None,
            # Cuándo se usó esta cuenta por última vez. Es lo que distingue una
            # cuenta al 2 % que está quieta de una al 2 % que estás gastando
            # ahora mismo: el número de la segunda se mueve, el de la primera no.
            "ultimo_uso": p.get("ultimoUso"),
            "viejo": (cuota.get("edadSegundos") or 0) >= VIEJO_SEGUNDOS,
        })
        if avisar is not None and not dormida:
            # Todas las barras, no sólo la que frena: la semanal puede estar
            # tranquila mientras la de sesión te para, y al revés.
            #
            # Salvo si la cuenta está dormida. Una notificación de escritorio
            # que dice «codex llegó al 95 %» por una cuenta free que nadie toca
            # hace semanas no avisa de nada: interrumpe. Es el mismo ruido que
            # hace que alguien termine escondiendo la cuenta, y esconderla es lo
            # que este cambio existe para que no haga falta.
            avisar(nombre, cuota.get("mostrar") or [], frena, proy, chocas)
    return piezas


def dibujar_item(piezas: list[dict], destino: str, escala: float = 1.0) -> tuple[int, int, str]:
    """Deja el PNG en `destino` y devuelve (ancho, alto, descripción accesible).

    `escala` multiplica los píxeles del archivo sin tocar las medidas que
    devuelve: a 3 salen los mismos 99×22 de siempre, dibujados sobre 297×66
    píxeles. Sirve para mostrarlo grande sin agrandar un bitmap chico, que es
    interpolar los bordes de un medidor de 3 px de ancho y verlo todo blando.
    """
    superficie = cairo.ImageSurface(cairo.FORMAT_ARGB32, 1, 1)
    pluma = Pluma(cairo.Context(superficie), FAMILIA)

    anchos = []
    for t in piezas:
        n = _numero_de(t)
        ancho = LADO_GLIFO + AIRE_GLIFO + ANCHO_MEDIDOR
        if n is not None:
            ancho += AIRE_NUMERO + math.ceil(pluma.ancho(n, 10, Pango.Weight.MEDIUM, tabular=True))
        anchos.append(ancho)
    # Un par de píxeles al final: sin eso el último dígito termina exactamente
    # en el borde de la imagen y el antialias se lo come.
    total = sum(anchos) + max(0, len(piezas) - 1) * ENTRE_GRUPOS + 2
    ancho_total = max(int(math.ceil(total)), int(ALTO_ITEM * PROPORCION_ANCHA))

    superficie = cairo.ImageSurface(cairo.FORMAT_ARGB32,
                                    int(ancho_total * escala), int(ALTO_ITEM * escala))
    cr = cairo.Context(superficie)
    cr.scale(escala, escala)
    pluma = Pluma(cr, FAMILIA)
    base = (ALTO_ITEM - ALTO_MEDIDOR) / 2
    radio = ANCHO_MEDIDOR / 2

    def medidor(x: float, pct, color) -> None:
        _redondeado(cr, x, base, ANCHO_MEDIDOR, ALTO_MEDIDOR, radio)
        _color(cr, TEMA.pista)
        cr.fill()
        if pct is None:
            return
        # Crece desde abajo, como el de macOS: lleno es «no te queda nada».
        alto = max(ANCHO_MEDIDOR, ALTO_MEDIDOR * max(0.0, min(100.0, pct)) / 100.0)
        _redondeado(cr, x, base + ALTO_MEDIDOR - alto, ANCHO_MEDIDOR, alto, radio)
        _color(cr, color)
        cr.fill()

    if not piezas:
        medidor((ancho_total - ANCHO_MEDIDOR) / 2, None, None)

    x = 0.0
    for i, t in enumerate(piezas):
        # El glifo dice QUÉ suscripción es: la forma, el producto; el color,
        # cuál de ellas. La identidad va acá y nunca en los medidores, que
        # están reservados para el estado.
        glifo_producto(cr, t["producto"], TEMA.color_cuenta(t["indice"]),
                       x, (ALTO_ITEM - LADO_GLIFO) / 2, LADO_GLIFO)
        xb = x + LADO_GLIFO + AIRE_GLIFO
        # El medidor es la SESIÓN: es la ventana que te frena AHORA, la única
        # que se mueve dentro del rato que estás mirando la barra. La semanal se
        # mueve dos píxeles por día —a media semana está siempre por la mitad—
        # y el presupuesto del día tiene su frase entera en el panel. Si la
        # cuenta no informa sesión queda la pista vacía: mejor un hueco honesto
        # que dibujar otra cosa.
        medidor(xb, t["sesion"],
                TEMA.nivel(nivel_de(t["sesion"], t["sesion_alerta"])) if t["sesion"] is not None else None)
        n = _numero_de(t)
        if n is not None:
            # El número es la sesión, así que lleva el estado DE LA SESIÓN. Se
            # tiñe recién cuando aprieta: si se pintara siempre, el color
            # dejaría de querer decir algo.
            nivel = nivel_de(t["sesion"], t["sesion_alerta"])
            color = TEMA.nivel(nivel) if nivel in ("aviso", "critico") else TEMA.etiqueta
            alto_n = pluma.alto(n, 10, Pango.Weight.MEDIUM, tabular=True)
            pluma.escribir(xb + ANCHO_MEDIDOR + AIRE_NUMERO, (ALTO_ITEM - alto_n) / 2,
                           n, 10, color, Pango.Weight.MEDIUM, tabular=True)
        x += anchos[i] + ENTRE_GRUPOS

    superficie.write_to_png(destino)
    return ancho_total, ALTO_ITEM, "; ".join(
        f"{t['nombre']}: "
        + (f"hoy {t['diario']:.0f} por ciento del día" if t["diario"] is not None
           else "el día todavía no se puede medir")
        + ", "
        + (f"sesión {t['sesion']} por ciento" if t["sesion"] is not None else "sin sesión")
        + ", "
        + (f"semana {t['semanal']} por ciento" if t["semanal"] is not None else "sin semanal")
        + (", con aviso" if t["sesion_alerta"] or t["semanal_alerta"] else "")
        for t in piezas
    )


# ── el panel, dibujado ───────────────────────────────────────────────────
# Vive afuera del widget a propósito: `--captura` dibuja esto mismo sobre una
# superficie de archivo, así que lo que se ve en el PNG es lo que se ve en
# pantalla y no una segunda implementación que se parece.
def modelo_panel(datos):
    if not isinstance(datos, dict):
        return None, []
    perfiles = datos.get("perfiles", [])
    vistas, calladas, i = [], [], 0
    for p in perfiles:
        cuota = p.get("cuota") or {}
        if cuota.get("estado") != "ok":
            calladas.append((corto(p.get("perfil") or "?"),
                             cuota.get("frase") or "sin cuota",
                             int((p.get("local") or {}).get("tokens") or 0)))
            continue
        vistas.append(VistaCuenta(p, i))
        # El índice de color sólo avanza con las cuentas que tienen número, para
        # que dos cuentas con barras nunca compartan color.
        i += 1
    if calladas:
        vistas.append(VistaSinCuota(calladas))
    return VistaResumen.desde(datos), vistas


def _pluma_de_medir() -> Pluma:
    return Pluma(cairo.Context(cairo.ImageSurface(cairo.FORMAT_ARGB32, 1, 1)), FAMILIA)


def medir_panel(datos, pie: bool = False) -> int:
    pluma = _pluma_de_medir()
    if isinstance(datos, str):
        return int(MARGEN * 2 + pluma.alto(datos, 11.5, ancho=ANCHO_PANEL - 2 * MARGEN))
    cabecera, vistas = modelo_panel(datos)
    alto = ALTO_CABECERA if cabecera else MARGEN
    for v in vistas:
        alto += v.medir(pluma) + ENTRE_TARJETAS
    if vistas:
        alto -= ENTRE_TARJETAS
    return int(alto + MARGEN + (ALTO_PIE_LECTURA if pie else 0))


def dibujar_panel(cr, datos, alto: float, proxima: float | None = None) -> None:
    pluma = Pluma(cr, FAMILIA)
    if isinstance(datos, str):
        # Silencio es el bug: si no hay número, hay una frase.
        pluma.escribir(MARGEN, MARGEN, datos, 11.5, TEMA.secundario,
                       ancho=ANCHO_PANEL - 2 * MARGEN)
        return
    cabecera, vistas = modelo_panel(datos)
    y = cabecera.pintar(cr, pluma, 0.0) if cabecera else float(MARGEN)
    for v in vistas:
        y = v.pintar(cr, pluma, y) + ENTRE_TARJETAS
    if proxima is not None:
        # Cada cuenta dice de cuándo es su número; esto dice cuándo deja de
        # serlo. Es la otra mitad de la misma pregunta.
        y += 4
        pluma.escribir(MARGEN + PAD_TARJETA, y,
                       f"próxima lectura en {cuenta_regresiva(proxima)}",
                       10.5, TEMA.terciario)


def fondo_panel(cr, ancho: float, alto: float) -> None:
    """Sólo para la captura: en pantalla el fondo lo pone el menú de GTK."""
    cr.save()
    cr.set_operator(cairo.OPERATOR_SOURCE)
    cr.set_source_rgba(0, 0, 0, 0)
    cr.paint()
    cr.restore()
    _redondeado(cr, 0.5, 0.5, ancho - 1, alto - 1, 12)
    _color(cr, _hex("#242424") if TEMA.oscuro else _hex("#ffffff"))
    cr.fill_preserve()
    _color(cr, TEMA.borde_tarjeta)
    cr.set_line_width(1)
    cr.stroke()


def capturar(datos, ruta: str, proxima: float | None = None) -> int:
    """El panel a un PNG, sin abrir nada. Para mirarlo sin tener la barra
    adelante, para que un cambio de dibujo se revise en una imagen, y para que
    lo muestre la extensión de GNOME.

    Devuelve el alto dibujado. Hay que usar ESE número y no volver a medir por
    fuera: medir con el renglón de «próxima lectura» y dibujar sin él daba una
    imagen de 1034 px declarada como 1060, y la diferencia se ve como un hueco.
    """
    alto = medir_panel(datos, proxima is not None)
    superficie = cairo.ImageSurface(cairo.FORMAT_ARGB32, ANCHO_PANEL, alto)
    cr = cairo.Context(superficie)
    fondo_panel(cr, ANCHO_PANEL, alto)
    dibujar_panel(cr, datos, alto, proxima)
    superficie.write_to_png(ruta)
    return alto


# ── el panel, en pantalla ────────────────────────────────────────────────
# En texto y no en bytes: load_from_data() quiere bytes, pero un literal b"" no
# admite un solo carácter fuera de ASCII, y un comentario en castellano adentro
# rompe el archivo entero.
CSS_PANEL = """
menu.qm { padding: 6px 0; }
menuitem.qm-lienzo { padding: 0; background: none; background-color: transparent; }
menuitem.qm-lienzo:hover { background: none; background-color: transparent; }
/* Insensible no quiere decir apagado: el dibujo se pinta con sus propios
   colores y no tiene que perder opacidad por no ser un botón. */
menuitem.qm-lienzo:disabled { opacity: 1; color: inherit; }
menuitem.qm-lienzo:disabled drawingarea { opacity: 1; }
""".encode("utf-8")


class Panel:
    """El panel adentro de un menú de GTK propio.

    No es una ventana suelta, y la razón se midió: en este escritorio ninguna
    ventana sostiene el foco. Se probaron los cuatro tipos —UTILITY, NORMAL,
    DIALOG, POPUP_MENU— y las cuatro lo pierden solas entre 0,15 s y 4,6 s
    después de abrir, sin que nadie toque nada: mutter se lo devuelve al lado
    Wayland. O sea que «cerrar al perder el foco» cerraba el panel solo, y
    agarrar el asiento a mano no alcanzaba porque un agarre de XWayland no ve
    los clicks que caen sobre una ventana Wayland.

    Un menú de GTK no tiene ninguno de esos problemas: agarra el puntero como lo
    agarra cualquier menú de cualquier app del escritorio, así que se cierra con
    un click afuera y con Escape sin que haya que programarlo. Y de yapa la caja
    redondeada, la sombra y el fondo los pone el tema, con lo cual el panel se ve
    como se ve todo lo demás en vez de como una ventana ajena.

    Sigue haciendo falta X11 para una sola cosa: `popup_at_rect()` contra la
    ventana raíz, que es lo que lo pega arriba a la derecha.
    """

    def __init__(self, al_actualizar, cuanto_falta=None) -> None:
        self.al_actualizar = al_actualizar
        # Una función y no un número: así la cuenta regresiva de abajo baja sola
        # mientras el panel está abierto, en vez de congelarse en el valor que
        # tenía cuando se abrió.
        self.cuanto_falta = cuanto_falta or (lambda: None)
        self.tictac: int | None = None
        self.datos: dict | str | None = None
        self.alto = 0
        self.cerrado = 0

        self.menu = Gtk.Menu()
        self.menu.get_style_context().add_class("qm")
        self.menu.set_reserve_toggle_size(False)

        # Un item por tarjeta, y no una sola superficie gigante.
        #
        # Un Gtk.Menu rueda ITEM por item: con un único item más alto que la
        # pantalla no hay nada que rodar, y el menú directamente no abre. Se vio
        # con un panel de 946 px en un monitor cuyo área útil son 728 — antes
        # medía 740 y entraba raspando, así que el bug apareció recién cuando el
        # panel creció. Partido en tarjetas, cada item entra y GTK pone las
        # flechas de rodar solo.
        self.css = Gtk.CssProvider()
        self.css.load_from_data(CSS_PANEL)
        self.menu.get_style_context().add_provider(
            self.css, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        self.filas: list[Gtk.MenuItem] = []

        self.menu.realize()
        # Si el compositor le rompe el agarre —pasa cuando el foco se va al lado
        # Wayland— el menú tiene que cerrarse, no quedarse colgado arriba de
        # todo sin forma de sacarlo.
        self.menu.connect("grab-broken-event", self._agarre_roto)
        self.menu.connect("unmap", self._al_cerrar)
        # Cuándo se abrió, para poder decir cuánto duró. Un panel que vive 40 ms
        # no es lo mismo que uno que el usuario cerró, y desde afuera se ven igual.
        self.abierto_en = 0

    @property
    def abierto(self) -> bool:
        """Si el menú está mapeado, y no lo que crea una bandera nuestra.

        Antes esto era un booleano que se prendía en «map» y se apagaba en
        «unmap», y se quedó pegado en True: el menú se cerró sin que llegara el
        unmap, así que cada click siguiente llamaba a popdown() sobre algo ya
        cerrado y el panel no volvía a abrir nunca. Preguntarle al widget no se
        puede desincronizar.
        """
        try:
            return bool(self.menu.get_mapped())
        except (AttributeError, TypeError):
            return False

    def _agarre_roto(self, *_):
        """El compositor le sacó el agarre al menú.

        Es la firma del panel que «se cierra solo»: si esto llega a los pocos
        milisegundos de abrir, el panel no lo cerró el usuario.
        """
        registrar("panel.agarre-roto", vivio_ms=self._vivio_ms())
        self.menu.popdown()
        return False

    def _vivio_ms(self) -> int | None:
        if not self.abierto_en:
            return None
        return int((GLib.get_monotonic_time() - self.abierto_en) / 1000)

    def _al_cerrar(self, *_) -> None:
        registrar("panel.cerrado", vivio_ms=self._vivio_ms())
        self.abierto_en = 0
        self.cerrado = GLib.get_monotonic_time()
        if self.tictac is not None:
            GLib.source_remove(self.tictac)
            self.tictac = None

    def _tic(self) -> bool:
        """Sólo redibuja: la medida no cambia, así que no hay que volver a
        medir ni a mover nada."""
        if not self.abierto:
            self.tictac = None
            return False
        for fila in self.filas:
            fila.get_child().queue_draw()
        return True

    def _fila(self, dibujo, alto: float) -> Gtk.MenuItem:
        """Un renglón del menú que se dibuja solo."""
        lienzo = Gtk.DrawingArea()
        lienzo.set_size_request(ANCHO_PANEL, int(alto))
        lienzo.connect("draw", lambda _w, cr, d=dibujo: (d(cr), False)[1])
        fila = Gtk.MenuItem()
        # Insensible a propósito, y es lo único que hace que el panel se pueda
        # usar: en un menú de GTK un item se ACTIVA al soltar el botón encima, y
        # activar un item cierra el menú. Con las tarjetas sensibles, tocar el
        # panel para rodarlo lo cerraba en el acto — el dibujo no es un botón,
        # es contenido. Los renglones de acción de abajo sí quedan sensibles.
        fila.set_sensitive(False)
        fila.get_style_context().add_class("qm-lienzo")
        fila.get_style_context().add_provider(
            self.css, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        fila.add(lienzo)
        return fila

    def _armar(self) -> None:
        # Todo se construye de nuevo, incluidos el separador y «Actualizar».
        # Sacar un widget de un contenedor de GTK lo DESTRUYE, así que guardarlo
        # para reusarlo en la próxima vuelta deja un objeto muerto: el menú se
        # armaba una vez, se cerraba, y de ahí en adelante no abría nunca más.
        for hijo in self.menu.get_children():
            self.menu.remove(hijo)
        self.filas = []

        pluma = _pluma_de_medir()
        if isinstance(self.datos, str):
            # Silencio es el bug: si no hay número, hay una frase.
            alto = pluma.alto(self.datos, 11.5, ancho=ANCHO_PANEL - 2 * MARGEN) + 2 * MARGEN
            texto = self.datos
            self.filas.append(self._fila(
                lambda cr, t=texto: Pluma(cr, FAMILIA).escribir(
                    MARGEN, MARGEN, t, 11.5, TEMA.secundario,
                    ancho=ANCHO_PANEL - 2 * MARGEN), alto))
        else:
            cabecera, vistas = modelo_panel(self.datos)
            if cabecera:
                self.filas.append(self._fila(
                    lambda cr, v=cabecera: v.pintar(cr, Pluma(cr, FAMILIA), 0.0),
                    ALTO_CABECERA))
            for v in vistas:
                self.filas.append(self._fila(
                    lambda cr, v=v: v.pintar(cr, Pluma(cr, FAMILIA), 0.0),
                    v.medir(pluma) + ENTRE_TARJETAS))
            if self.cuanto_falta() is not None:
                self.filas.append(self._fila(self._pintar_lectura, ALTO_PIE_LECTURA))

        for fila in self.filas:
            self.menu.append(fila)
        self.menu.append(Gtk.SeparatorMenuItem())
        actualizar = Gtk.MenuItem(label="Actualizar ahora")
        actualizar.connect("activate", lambda _: self.al_actualizar())
        self.menu.append(actualizar)
        self.menu.show_all()

    def _pintar_lectura(self, cr) -> None:
        falta = self.cuanto_falta()
        if falta is None:
            return
        # Cada cuenta dice de cuándo es su número; esto dice cuándo deja de
        # serlo. Es la otra mitad de la misma pregunta.
        Pluma(cr, FAMILIA).escribir(
            MARGEN + PAD_TARJETA, 4, f"próxima lectura en {cuenta_regresiva(falta)}",
            10.5, TEMA.terciario)

    @staticmethod
    def _area():
        disp = Gdk.Display.get_default()
        mon = None
        try:
            _, px, py = disp.get_default_seat().get_pointer().get_position()
            mon = disp.get_monitor_at_point(px, py)
        except (AttributeError, TypeError):
            pass
        mon = mon or disp.get_primary_monitor() or disp.get_monitor(0)
        return mon.get_workarea()

    @staticmethod
    def _disparo(raiz):
        """El evento que GTK pide para popear un menú.

        Acá no hay ninguno: el panel lo abre un mensaje de DBus, no un click que
        haya pasado por este proceso. Sin evento GTK avisa «no trigger event for
        menu popup» y el agarre que toma después se rompe solo a
        los pocos segundos: el menú se cerraba sin que nadie tocara nada.

        El tiempo va en CURRENT_TIME a propósito. Preguntarle la hora al
        servidor X con x11_get_server_time() sobre la ventana raíz **cuelga el
        proceso**: esa función escribe una propiedad y se queda esperando un
        PropertyNotify que la raíz nunca manda, y el bucle principal no vuelve.
        Para agarrar el puntero, CURRENT_TIME quiere decir «ahora» y alcanza.
        """
        ev = Gdk.Event.new(Gdk.EventType.BUTTON_PRESS)
        ev.window = raiz
        ev.send_event = True
        ev.button = 1
        asiento = Gdk.Display.get_default().get_default_seat()
        puntero = asiento.get_pointer()
        try:
            ev.set_device(puntero)
            _, x, y = puntero.get_position()
            ev.x_root, ev.y_root = float(x), float(y)
        except (AttributeError, TypeError):
            pass
        ev.time = Gdk.CURRENT_TIME
        return ev

    def mostrar(self, datos) -> None:
        """Abre —o redibuja, si ya estaba abierto— el panel con estos datos."""
        global TEMA
        # Cada vez, no una sola al arrancar: el tema del escritorio se cambia
        # mientras el programa corre y el dibujo tiene que seguirlo.
        TEMA = Tema.desde(self.menu)
        self.datos = datos
        self.alto = medir_panel(datos, self.cuanto_falta() is not None)
        if self.abierto:
            # Con el menú abierto no se reconstruyen los items —eso lo cerraría—
            # así que sólo se repintan.
            for fila in self.filas:
                fila.get_child().queue_draw()
            return
        self._armar()
        # Arriba a la derecha del área útil, que ya excluye la barra.
        area = self._area()
        donde = Gdk.Rectangle()
        donde.x, donde.y, donde.width, donde.height = area.x + area.width - 6, area.y, 1, 1
        raiz = Gdk.get_default_root_window()
        if raiz is None:  # sin X11 no hay dónde anclarlo; que lo ubique GTK
            registrar("panel.abierto", donde="puntero", raiz="sin-x11")
            self.abierto_en = GLib.get_monotonic_time()
            self.menu.popup_at_pointer(None)
            return
        registrar("panel.abierto", donde="arriba-derecha", alto=self.alto)
        self.abierto_en = GLib.get_monotonic_time()
        self.menu.popup_at_rect(raiz, donde, Gdk.Gravity.NORTH_EAST,
                                Gdk.Gravity.NORTH_EAST, self._disparo(raiz))
        if self.tictac is None:
            self.tictac = GLib.timeout_add_seconds(1, self._tic)

    def alternar(self, datos) -> None:
        """Abre o cierra.

        El margen no es paranoia: el click del medio sobre la barra cierra el
        menú antes de que el evento llegue hasta acá, así que sin él el click
        que tenía que cerrarlo lo vuelve a abrir.
        """
        if self.abierto or (GLib.get_monotonic_time() - self.cerrado) < 300_000:
            self.menu.popdown()
        else:
            self.mostrar(datos)


# ── avisos ───────────────────────────────────────────────────────────────
class Avisos:
    """Notificaciones sin repetir.

    La clave incluye el instante de reinicio: cuando la ventana se reinicia,
    la clave cambia sola y el mismo umbral puede volver a avisar. Sin eso, o
    spameás cada minuto o avisás una sola vez en la vida.
    """

    def __init__(self) -> None:
        self.bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)
        self.ruta = Path(
            os.environ.get("XDG_CACHE_HOME", str(Path.home() / ".cache"))
        ) / "quartermaster" / "avisados.json"
        try:
            self.vistos = set(json.loads(self.ruta.read_text()))
        except (OSError, ValueError):
            self.vistos = set()
        # Sólo para el registro: qué avisos repetidos ya se dijeron en ESTE
        # proceso. No se persiste — al reiniciar conviene volver a decirlo una
        # vez, porque el registro nuevo arranca vacío.
        self.repetidos_dichos: set[str] = set()

    def guardar(self) -> None:
        try:
            self.ruta.parent.mkdir(parents=True, exist_ok=True)
            self.ruta.write_text(json.dumps(sorted(self.vistos)))
        except OSError:
            pass  # sin memoria de avisos se avisa de más, no de menos

    def avisar(self, clave: str, titulo: str, cuerpo: str, urgente: bool) -> None:
        """Una vez por clave y nunca más."""
        if clave in self.vistos:
            # Que un aviso NO salga por repetido es una decisión, no un
            # no-evento: explica «no me avisó» cuando el aviso sí correspondía.
            #
            # Pero esto se evalúa en CADA refresco, o sea cada pocos segundos
            # mientras la barra siga alta. Registrarlo siempre son tres líneas
            # iguales cada veinte segundos hasta que la ventana se reinicie: el
            # registro deja de leerse y el evento que importa queda enterrado.
            # Se dice una vez por clave y por proceso, que es cuando aporta.
            if clave not in self.repetidos_dichos:
                self.repetidos_dichos.add(clave)
                registrar("aviso.repetido", clave=clave)
            return
        self.vistos.add(clave)
        self.guardar()
        registrar("aviso", clave=clave, urgente=urgente)
        self.notificar(titulo, cuerpo, urgente)

    def notificar(self, titulo: str, cuerpo: str, urgente: bool) -> None:
        """Sin memoria: para lo que sí tiene que volver a avisar cada vez que
        pasa, como un reinicio."""
        try:
            self.bus.call_sync(
                "org.freedesktop.Notifications",
                "/org/freedesktop/Notifications",
                "org.freedesktop.Notifications",
                "Notify",
                GLib.Variant(
                    "(susssasa{sv}i)",
                    (
                        "quartermaster",
                        0,
                        ICONO_GRAVE if urgente else ICONO_AVISO,
                        titulo,
                        cuerpo,
                        [],
                        {"urgency": GLib.Variant("y", 2 if urgente else 1)},
                        0 if urgente else 10_000,
                    ),
                ),
                GLib.VariantType("(u)"),
                Gio.DBusCallFlags.NONE,
                -1,
                None,
            )
        except GLib.Error as e:
            # El indicador igual funciona sin servidor de notificaciones, pero
            # «te liberaste» es el aviso más útil que da el programa: si no sale,
            # tiene que quedar dicho por qué.
            registrar("aviso.fallo", motivo=str(e).replace("\n", " ")[:100])


# ── leer a qm ────────────────────────────────────────────────────────────
def leer_qm(qm: str) -> dict | str:
    """El JSON de qm, o la frase que explica por qué no hay JSON."""
    try:
        r = subprocess.run(
            [qm, "--json", "--breve"],
            capture_output=True,
            text=True,
            timeout=20,
            check=False,
        )
    except (OSError, subprocess.TimeoutExpired) as e:
        return f"no pude correr qm: {e}"
    # 3 es «alguna barra pasó el umbral», no un error.
    if r.returncode not in (0, 3):
        lineas = (r.stderr or r.stdout or "").strip().splitlines()
        return f"qm salió {r.returncode}: {lineas[0] if lineas else 'sin detalle'}"
    try:
        return json.loads(r.stdout)
    except json.JSONDecodeError:
        return "qm no devolvió JSON"


class Previos:
    """Cuánto valía cada barra la última vez, para poder ver que se reinició.

    Un porcentaje solo no dice nada de eso: 3 % puede ser «recién empezás» o
    «acabás de salir de estar contra el techo», y la diferencia es justo lo que
    hay que avisar. Se guarda el minuto de reinicio junto al número: cuando el
    minuto cambia, la ventana es otra.
    """

    def __init__(self) -> None:
        self.ruta = CACHE / "previos.json"
        try:
            self.mapa = json.loads(self.ruta.read_text())
        except (OSError, ValueError):
            self.mapa = {}

    def ver_y_guardar(self, clave: str, minuto: str, pct: float):
        """Devuelve lo anterior (minuto, pct) o None, y anota lo de ahora."""
        antes = self.mapa.get(clave)
        self.mapa[clave] = [minuto, pct]
        if not isinstance(antes, list) or len(antes) != 2:
            return None
        return antes[0], antes[1]

    def guardar(self) -> None:
        try:
            self.ruta.parent.mkdir(parents=True, exist_ok=True)
            self.ruta.write_text(json.dumps(self.mapa))
        except OSError:
            pass  # sin memoria se avisa de más, no de menos


# ── indicador ────────────────────────────────────────────────────────────
class Indicador:
    def __init__(self, qm: str):
        self.qm = qm
        self.avisos = Avisos()
        self.previos = Previos()
        self.pendiente: int | None = None
        self.pedido_pendiente: int | None = None
        self.reinicio_pendiente: int | None = None
        self.apertura_pendiente: int | None = None
        self.menu = Gtk.Menu()
        self.ind = AppIndicator.Indicator.new(
            ID, ICONO_OK, AppIndicator.IndicatorCategory.SYSTEM_SERVICES
        )
        self.ind.set_status(AppIndicator.IndicatorStatus.ACTIVE)
        self.ind.set_title("quartermaster")
        self.ind.set_menu(self.menu)
        self.datos: dict | str | None = None
        self.piezas: list[dict] = []
        self.minutos_al_techo: float | None = None
        self.calentando = False
        # Desde cuándo. Sin esto, una bandera que se queda pegada no se puede
        # distinguir de un calentado que recién arrancó.
        self.calentando_desde: int | None = None
        # Lo último que falló de cada cosa, para anotar CAMBIOS y no repetir, y
        # para poder decir cuándo volvió a andar. Un log que repite la misma
        # falla cada dos minutos no se lee, y uno que nunca dice «volvió» deja
        # cada falla abierta para siempre: leyéndolo mañana no hay forma de
        # saber si el problema duró un minuto o duró toda la noche.
        self._fallo_calentado: str | None = None
        self._fallo_lectura: str | None = None
        self._fallo_lectura_desde: float | None = None
        # Los motivos por cuenta que qm ya explicó en esta corrida. Van una vez
        # y no tienen «volvió»: los calentados alternan entre todas las cuentas
        # y sólo las que se mueven, así que que un motivo no aparezca NO dice
        # que se arregló.
        self._motivos_calentado: set[str] = set()
        # Cuándo terminó el último calentado. Es lo que mira el vigía: la
        # pregunta no es «¿está armado el temporizador?» —eso se puede creer y
        # estar equivocado— sino «¿cuándo fue la última vez que de verdad le
        # preguntamos al servidor?».
        # Arranca con la hora de arranque y no en None: si el PRIMER calentado
        # nunca termina, un vigía que espera a tener una marca no mira nunca.
        self._ultimo_calentado: int | None = GLib.get_monotonic_time()
        self._vigia_avisado = False
        self.reloj: int | None = None
        self.proxima_lectura: int | None = None
        self.iconos = CACHE
        self.panel = Panel(self.refrescar, self.falta_para_lectura)
        self.monitores: list[Gio.FileMonitor] = []
        self.refrescar()
        self.vigilar()
        self.vigilar_extension()
        self.vigilar_tema()
        self.vigilar_version()
        # Envuelto, y devolviendo True SIEMPRE. Un callback de GLib que tira
        # deja de devolver un valor verdadero y la fuente se QUITA: una sola
        # excepción en un refresco mataba el sondeo para siempre, y con él al
        # calentado, que se rearma desde acá. El envoltorio no arregla el error
        # —lo anota— pero no deja que se lleve puesto al lazo.
        GLib.timeout_add_seconds(SEGUNDOS_SONDEO, self._sondear)
        self.programar_calentado(5)
        self.vigilar_suspension()
        GLib.timeout_add_seconds(VIGIA_SEGUNDOS, self._vigia)

    # Vigilancia de archivos ------------------------------------------------
    def vigilar(self) -> None:
        """Un monitor por .claude.json. Es donde aparece la cuota nueva."""
        casa = Path.home()
        rutas = [casa / ".claude.json"]
        rutas += [d / ".claude.json" for d in casa.glob(".claude-*") if d.is_dir()]
        for r in rutas:
            try:
                mon = Gio.File.new_for_path(str(r)).monitor_file(
                    Gio.FileMonitorFlags.NONE, None
                )
            except GLib.Error:
                continue
            mon.connect("changed", self.cambio)
            self.monitores.append(mon)

    def vigilar_extension(self) -> None:
        """Los dos archivos que escribe la extensión: el click y su presencia."""
        for ruta, accion in ((PEDIDO, self.atender_pedido),
                             (EXTENSION_VIVA, self.mandar_en_la_barra)):
            try:
                mon = Gio.File.new_for_path(str(ruta)).monitor_file(
                    Gio.FileMonitorFlags.NONE, None)
            except GLib.Error:
                continue
            mon.connect("changed", lambda *a, f=accion: f())
            self.monitores.append(mon)
        self.mandar_en_la_barra()
        # Un archivo que se quedó viejo no dispara ningún evento, así que hay
        # que ir a mirarlo.
        GLib.timeout_add_seconds(VIVA_SEGUNDOS // 2, self.mandar_en_la_barra)

    def vigilar_version(self) -> None:
        """Cuando el paquete se actualiza, este proceso sigue con el código viejo.

        `apt upgrade`, `brew upgrade` y `npm update` reemplazan los archivos y se
        van; el proceso que ya está corriendo tiene el módulo cargado en memoria
        y sigue igual hasta que alguien lo reinicie a mano — que no lo hace
        nadie, porque el indicador es justamente lo que se deja andando y se
        olvida. Así que se mira a sí mismo y se vuelve a lanzar.
        """
        try:
            mon = Gio.File.new_for_path(str(YO)).monitor_file(
                Gio.FileMonitorFlags.NONE, None)
        except GLib.Error:
            return
        mon.connect("changed", self._quizas_reiniciar)
        self.monitores.append(mon)

    def _quizas_reiniciar(self, _mon, _f, _o, evento) -> None:
        if evento not in (Gio.FileMonitorEvent.CHANGES_DONE_HINT,
                          Gio.FileMonitorEvent.CREATED,
                          Gio.FileMonitorEvent.RENAMED,
                          Gio.FileMonitorEvent.MOVED_IN):
            return
        # Un gestor de paquetes escribe en varios pasos; se espera a que pare.
        if self.reinicio_pendiente is not None:
            GLib.source_remove(self.reinicio_pendiente)
        self.reinicio_pendiente = GLib.timeout_add_seconds(3, self._reiniciar)

    def _reiniciar(self) -> bool:
        self.reinicio_pendiente = None
        # Compila antes de saltar. Si la versión nueva está rota, reiniciar deja
        # al usuario SIN indicador; quedarse con la vieja lo deja con una que
        # anda. Entre las dos, la que anda.
        # El .pyc va a un temporal de verdad: py_compile se niega a escribir en
        # /dev/null —«is a non-regular file»— y con eso el chequeo fallaba
        # SIEMPRE, así que nunca reiniciaba y parecía que la vigilancia no
        # andaba. La red de seguridad tapaba la puerta.
        try:
            with tempfile.NamedTemporaryFile(suffix=".pyc", delete=True) as tmp:
                py_compile.compile(str(YO), cfile=tmp.name, doraise=True)
        except (py_compile.PyCompileError, OSError, ValueError) as e:
            print(f"la versión nueva no compila, me quedo con ésta: {e}", file=sys.stderr)
            return False
        self.panel.menu.popdown()
        # Un proceso que se reemplaza a sí mismo en silencio explica cualquier
        # rareza posterior —contadores en cero, panel cerrado, avisos de nuevo—
        # y hasta acá no dejaba una línea.
        registrar("reinicio", motivo="el fuente cambió")
        try:
            os.execv(sys.executable, [sys.executable, str(YO), *sys.argv[1:]])
        except OSError as e:
            registrar("reinicio.fallo", error=str(e)[:80])
            print(f"no pude reiniciarme: {e}", file=sys.stderr)
        return False

    def vigilar_suspension(self) -> None:
        """Enterarse de que la máquina durmió, y refrescar al volver.

        Sin esto, volver de una suspensión es la peor pantalla que da el
        programa: los números son de antes de dormir y las ventanas que se
        reiniciaron mientras tanto salen marcadas «vencida». Todo correcto y
        todo inútil — lo que hace falta es el número de ahora.

        Y no alcanza con esperar al próximo sondeo. Los timeouts de GLib corren
        contra el reloj MONOTÓNICO, que en Linux no avanza mientras la máquina
        duerme: cuatro horas suspendida son cero segundos para el temporizador.
        El reloj de pared sí saltó, así que la lectura queda vieja de horas
        mientras el sondeo cree que recién empieza.

        logind avisa con PrepareForSleep: `true` antes de dormir, `false` al
        volver. El `false` es el que importa.

        Va en el bus del SISTEMA, no en el de sesión. Si no se puede —un
        contenedor, una máquina sin logind— se sigue sin esto, que es como
        estaba hasta hoy.
        """
        try:
            sistema = Gio.bus_get_sync(Gio.BusType.SYSTEM, None)
            sistema.signal_subscribe(
                "org.freedesktop.login1",
                "org.freedesktop.login1.Manager",
                "PrepareForSleep",
                "/org/freedesktop/login1",
                None,
                Gio.DBusSignalFlags.NONE,
                self._al_dormir_o_volver,
            )
            self.bus_sistema = sistema
        except GLib.Error as e:
            registrar("suspension.sin-logind", motivo=str(e)[:90])

    def _al_dormir_o_volver(self, _con, _emisor, _ruta, _iface, _senal, params) -> None:
        durmiendo = bool(params[0]) if params and len(params) else False
        if durmiendo:
            registrar("suspension.duerme")
            return
        registrar("suspension.vuelve")
        # La bandera se suelta a mano: si había un calentado en vuelo cuando la
        # máquina se durmió, su callback es justo el que puede no llegar.
        self.calentando = False
        self.calentando_desde = None
        # Y se pregunta YA, no en el próximo sondeo: al volver, lo que hay en
        # pantalla es de antes de dormir.
        self.programar_calentado(2)

    def vigilar_tema(self) -> None:
        """El tema del escritorio se cambia con esto andando.

        El color del número de la barra sale de TEMA, que se resolvía una sola
        vez al arrancar: pasar el escritorio a claro dejaba el número blanco
        sobre una barra clara hasta el próximo reinicio del indicador.
        """
        try:
            fuente = Gio.SettingsSchemaSource.get_default()
            esquema = fuente.lookup("org.gnome.desktop.interface", True) if fuente else None
            if esquema is None or not esquema.has_key("color-scheme"):
                return
            self.ajustes = Gio.Settings.new("org.gnome.desktop.interface")
            self.ajustes.connect("changed::color-scheme", lambda *_: self.cambio_de_tema())
        except (GLib.Error, AttributeError, TypeError):
            pass

    def cambio_de_tema(self) -> None:
        global TEMA
        alinear_tema_gtk()
        TEMA = tema_actual()
        self.refrescar()

    def atender_pedido(self) -> None:
        """Un click, una acción.

        Escribir un archivo son VARIOS eventos de inotify —se midieron tres por
        escritura: changed, changed, changes-done-hint— y sin juntarlos un solo
        click abría el panel y los dos eventos siguientes lo cerraban en el
        mismo instante. Desde afuera se veía como que el item no hacía nada.
        """
        if self.pedido_pendiente is not None:
            GLib.source_remove(self.pedido_pendiente)
        self.pedido_pendiente = GLib.timeout_add(120, self._pedido_listo)

    def _pedido_listo(self) -> bool:
        self.pedido_pendiente = None
        try:
            accion = PEDIDO.read_text().split(" ", 1)[0].strip()
        except OSError as e:
            # Un pedido que no se puede leer es un click que se perdió, y sin
            # esta línea se pierde sin dejar rastro.
            registrar("pedido.ilegible", error=str(e)[:80])
            return False
        # Saber si el click LLEGÓ es la mitad de cualquier diagnóstico de «no
        # hace nada»: separa «la extensión no pidió» de «pidió y no pasó nada».
        # Sin esto hubo que disparar el pedido a mano y mirar el mtime de
        # estado.json para saber de qué lado estaba el problema.
        registrar("pedido", accion=accion or "(vacío)")
        if accion == "alternar":
            # La extensión sólo pide esto cuando NO puede dibujar el panel ella
            # misma; si puede, abre su propio menú y no manda nada.
            self.abrir_panel()
        elif accion == "actualizar":
            self.refrescar()
        else:
            registrar("pedido.desconocido", accion=accion[:40])
        return False

    def extension_viva(self) -> bool:
        """La extensión está puesta y sigue viva.

        No alcanza con que el archivo exista: si el shell se cae sin llamar a
        disable(), queda para siempre y este item se escondería para siempre —
        ningún icono en ningún lado. La extensión le renueva la fecha cada 30 s,
        así que un archivo viejo quiere decir que del otro lado no hay nadie.
        """
        try:
            return (time.time() - EXTENSION_VIVA.stat().st_mtime) < VIVA_SEGUNDOS
        except OSError:
            return False

    def mandar_en_la_barra(self) -> bool:
        """Si la extensión está puesta, el item de AppIndicator sobra.

        No se destruye, se pone en PASSIVE: la extensión se puede apagar en
        cualquier momento y entonces este item tiene que volver, sin reiniciar
        nada y sin dejar la barra vacía en el medio.
        """
        propia = not self.extension_viva()
        self.ind.set_status(AppIndicator.IndicatorStatus.ACTIVE if propia
                            else AppIndicator.IndicatorStatus.PASSIVE)
        return True

    def cambio(self, _mon, _f, _o, evento) -> None:
        if evento not in (
            Gio.FileMonitorEvent.CHANGES_DONE_HINT,
            Gio.FileMonitorEvent.CREATED,
            Gio.FileMonitorEvent.RENAMED,
        ):
            return
        # Claude Code reescribe el archivo varias veces seguidas; una sola
        # relectura al final alcanza.
        if self.pendiente is not None:
            GLib.source_remove(self.pendiente)
        self.pendiente = GLib.timeout_add(DEBOUNCE_MS, self.disparar)

    # Calentado -------------------------------------------------------------
    # `qm --breve` lee del disco y no habla con nadie, que es lo que lo hace
    # instantáneo — pero entonces el número es tan fresco como la última vez que
    # ALGUIEN preguntó. Y Claude Code refresca su propio cache cuando quiere:
    # medido acá, 1 día y 11 horas sin tocarlo, con la semanal 14 puntos abajo
    # de la realidad. Así que el indicador pregunta él, igual que la barra de
    # macOS y la bandeja de Windows, y deja el número en el cache para que las
    # lecturas sigan siendo de disco.
    @staticmethod
    def _tope(t: dict) -> int:
        return max(t["sesion"] or 0, t["semanal"] or 0)

    @staticmethod
    def _ya_reinicio(t: dict) -> bool:
        """Si alguna de sus ventanas ya pasó su instante de reinicio.

        El número guardado es de ANTES de ese instante, así que no es viejo: es
        de otra ventana, una que ya cerró. Ahí sí hay algo nuevo que leer.
        """
        for iso in (t.get("reinicia_sesion"), t.get("reinicia_semanal")):
            seg = faltan(iso)
            if seg is not None and seg <= 0:
                return True
        return False

    @staticmethod
    def _activa_hace_poco(t: dict) -> bool:
        """Si se usó hace poco. Entonces su número se está moviendo."""
        seg = faltan(t.get("ultimo_uso"))
        return seg is not None and -ACTIVA_SEGUNDOS <= seg <= 0

    def _vale_preguntar(self, t: dict) -> bool:
        """A qué cuentas se les pregunta en el próximo calentado.

        El corte de abajo es ahorro: una cuenta al 9 % no da noticias.

        El de arriba ERA un bug. `cadencia()` tiene razón en no sondear cada
        minuto una barra en 100 —no puede subir, y el instante del reinicio ya
        lo sabemos sin preguntar— pero eso es un argumento sobre CADA CUÁNTO, y
        se había colado acá como un argumento sobre A QUIÉN. Resultado: la
        cuenta frenada quedaba excluida de todos los calentados, o sea que la
        única que no podía enterarse de que se liberó era justo la que estaba
        esperando liberarse. Y «te liberaste» es el aviso más útil que da este
        programa.

        Medido el 2026-09-13: una cuenta con weekly_all 96 % y weekly_scoped
        100 % (las dos `critical`) siguió mostrando eso nueve horas, con el
        reinicio dos horas atrás. Un solo `qm --calentar --cuentas=…` devolvió
        2 % y 0 %, las dos `normal`.

        Así que el 100 % se saltea mientras su ventana siga abierta, y entra
        apenas pasa el reinicio — que es el único momento en que tiene algo
        nuevo para contar.
        """
        if self._ya_reinicio(t):
            return True
        # Y la cuenta que estás usando AHORA, esté donde esté.
        #
        # El corte de abajo —«una cuenta al 9 % no da noticias»— es cierto de
        # una cuenta QUIETA. De una que estás gastando es exactamente al revés:
        # es la única cuyo número está cambiando, y con el corte por nivel se
        # quedaba sin preguntar hasta llegar al 40 %.
        #
        # Medido el 2026-09-13, con dos sesiones abiertas: la cuenta de teams
        # iba al 2 % y en 55 minutos la barra le preguntó al endpoint UNA vez.
        # Todos los demás calentados fueron para codex, que estaba al 85 %.
        if self._activa_hace_poco(t):
            return True
        return 40 <= self._tope(t) < 100

    def cadencia(self) -> int:
        # Una barra que ya está en 100 no puede subir: hasta el reinicio no hay
        # nada nuevo que leer, y el instante del reinicio ya lo sabemos sin
        # preguntar. Contarla como «alto» hacía que el sondeo se fuera al piso
        # de 60 s para mirar un número congelado — un pedido por minuto a un
        # endpoint que no es nuestro, para confirmar que seguís frenado.
        moviles = [self._tope(t) for t in self.piezas if self._tope(t) < 100]
        alto = max(moviles, default=0)
        seg = SEGUNDOS_SONDEO
        if alto >= 90:
            seg = MINIMO_RED
        elif alto >= 75:
            seg = 120
        elif alto >= 50:
            seg = 240
        # Si la proyección dice que el techo está cerca, el número viejo deja de
        # servir mucho antes que en el caso normal.
        m = self.minutos_al_techo
        if m is not None and m <= 30:
            seg = min(seg, MINIMO_RED)
        elif m is not None and m <= 90:
            seg = min(seg, 120)
        return max(MINIMO_RED, seg)

    def programar_calentado(self, segundos: int | None = None, forzar: bool = False) -> None:
        """Agenda el próximo calentado, y NUNCA lo aleja.

        Acá estaba el hambre. Esto rearmaba siempre, y `refrescar()` lo llama en
        cada vuelta; el sondeo corre cada SEGUNDOS_SONDEO y `cadencia()` devuelve
        exactamente eso cuando no hay nada alto —el caso normal—. Los dos
        temporizadores quedaban empatados en 300 s y el del sondeo llegaba
        primero, así que cada sondeo reiniciaba la cuenta regresiva del
        calentado justo antes de que venciera. El calentado no ocurría NUNCA.

        Medido el 2026-09-15 con 0.1.13: un solo calentado al arrancar y después
        siete horas y media sin ninguno, con `calentando` en False y un
        temporizador armado todo el tiempo —armado y reiniciado, que es distinto
        de disparado—. Y por eso forzar un `refrescar()` no lo revivía: volvía a
        correr la cuenta 300 s más allá.

        La regla es simple: una fecha que está más lejos que la que ya hay no
        reemplaza a nada. Apretar la cadencia —que es para lo que existe volver
        a llamar— sigue funcionando, porque ésa siempre es más cerca.
        """
        cuanto = self.cadencia() if segundos is None else segundos
        cuando = GLib.get_monotonic_time() + cuanto * 1_000_000
        # `forzar` es para el vigía, y no es un detalle: cuando el calentado está
        # parado, la fecha agendada YA VENCIÓ, así que cualquier fecha nueva es
        # «más lejos» y la guarda de arriba la rechazaría. La defensa contra el
        # hambre desactivaba a la defensa contra el silencio. Lo encontró el gate
        # corriendo el Swift, no leyéndolo.
        if (not forzar and self.reloj is not None and self.proxima_lectura is not None
                and cuando >= self.proxima_lectura):
            return
        if self.reloj is not None:
            GLib.source_remove(self.reloj)
        self.proxima_lectura = cuando
        self.reloj = GLib.timeout_add_seconds(cuanto, self.calentar)

    def falta_para_lectura(self) -> float | None:
        """Segundos hasta la próxima vez que se le pregunta al servidor."""
        if self.proxima_lectura is None:
            return None
        if self.calentando:
            return 0.0
        return max(0.0, (self.proxima_lectura - GLib.get_monotonic_time()) / 1_000_000)

    def _sondear(self) -> bool:
        """El refresco periódico, que NUNCA puede sacarse su propia fuente."""
        try:
            self.refrescar()
        except Exception as e:  # noqa: BLE001 — anotar y seguir, no morir callado
            registrar("sondeo.reventó", error=f"{type(e).__name__}: {e}"[:110])
        return True

    def _vigia(self) -> bool:
        """Que el calentado no pueda dejar de ocurrir en silencio.

        El 2026-09-15, con 0.1.13, este indicador dejó de preguntarle al
        endpoint a las 02:35 y estuvo siete horas y media sin escribir una sola
        línea: el proceso vivo, `estado.json` reescrito hacía un minuto y la
        cuota de hacía siete horas. Forzar un `refrescar()` —que rearma el
        calentado— no lo revivió en diez minutos, con la cadencia en un techo de
        cinco. No fue la suspensión: BOOTTIME y MONOTONIC daban lo mismo.

        La causa de fondo no es una línea, es la FORMA: el calentado se rearmaba
        desde un solo lugar —el final de `refrescar()`—, así que cualquier corte
        en esa cadena lo apagaba para toda la vida del proceso y sin ruido.

        Esto lo mira desde afuera y no se puede quedar callado: es una fuente
        que devuelve True siempre, no depende del calentado ni del sondeo, y
        pregunta lo único que importa —cuánto hace que no le preguntamos al
        servidor—. Si se pasa del plazo, lo ANOTA y lo destraba.
        """
        try:
            ahora = GLib.get_monotonic_time()
            desde = self._ultimo_calentado
            atraso = None if desde is None else ahora - desde
            if atraso is None or atraso <= VIGIA_PLAZO_US:
                self._vigia_avisado = False
                return True
            # Una vez por corte, no una por minuto: el log tiene que poder
            # leerse. Se vuelve a habilitar solo cuando el calentado vuelve.
            if not self._vigia_avisado:
                registrar("calentar.parado",
                          hace=duracion(int(atraso / 1_000_000)),
                          calentando=self.calentando,
                          desde=self.calentando_desde is not None,
                          reloj=self.reloj is not None)
                self._vigia_avisado = True
            # Y destrabarlo: la bandera pegada se suelta y se rearma ya.
            self.calentando = False
            self.calentando_desde = None
            self.programar_calentado(1, forzar=True)
        except Exception as e:  # noqa: BLE001 — el vigía no puede ser lo que se cae
            registrar("vigia.reventó", error=f"{type(e).__name__}: {e}"[:110])
        return True

    def calentar(self) -> bool:
        self.reloj = None
        if self.calentando:
            # Acá había un `return False` pelado, y eso MATABA el lazo: al
            # devolver False la fuente de GLib se quita, y como `self.reloj` ya
            # se soltó arriba, nadie la vuelve a armar. Una sola bandera pegada
            # dejaba al indicador sin volver a preguntarle al endpoint en lo que
            # le quedaba de vida — dibujando cada pocos minutos un número que no
            # se actualizaba nunca.
            #
            # Visto el 2026-09-13 después de una suspensión de 4,1 h: el proceso
            # vivo, estado.json reescrito hacía 4 minutos, y la cuota leída
            # hacía 5,2 horas.
            #
            # `calentando` sólo se apaga en el callback de wait_async. Si ese
            # callback no llega —y una suspensión en el medio es justo cuando no
            # llega— no hay nada más que lo apague. Así que además de
            # reprogramar, se le pone un plazo: pasado eso, el callback no viene
            # y la bandera se suelta.
            # `desde` en None con `calentando` en True es un estado que el
            # código no debería poder producir —se ponen juntas— y por eso
            # mismo era el único silencio posible: con el `is not None` de
            # antes, ese caso caía al `else` y se rearmaba para siempre sin
            # anotar nada. Ahora una bandera sin instante se trata como lo que
            # es: pegada.
            desde = self.calentando_desde
            pasado = desde is None or (GLib.get_monotonic_time() - desde) > CALENTADO_PLAZO_US
            if pasado:
                registrar("calentar.colgado",
                          segundos=None if desde is None else int((GLib.get_monotonic_time() - desde) / 1_000_000),
                          sin_instante=desde is None or None)
                self.calentando = False
                self.calentando_desde = None
            else:
                self.programar_calentado()
                return False
        args = [self.qm, "--calentar"]
        # Sólo las cuentas que se mueven: refrescar una que va al 9 % es gastar
        # un pedido para confirmar que no pasó nada.
        mueven = [t["perfil"] for t in self.piezas if self._vale_preguntar(t)]
        if mueven and len(mueven) != len(self.piezas):
            args.append("--cuentas=" + ",".join(mueven))
        registrar("calentar", cuentas=",".join(mueven) if mueven else "todas")
        try:
            # El stderr se PIDE, no se tira. Desde 0.1.8 `qm --calentar` explica
            # ahí por qué una cuenta no se calentó —sin credencial, token
            # vencido—, y con STDERR_SILENCE esa explicación se iba a /dev/null:
            # la barra de macOS la anota desde esa misma versión y acá se
            # perdía.
            proc = Gio.Subprocess.new(
                args, Gio.SubprocessFlags.STDOUT_SILENCE | Gio.SubprocessFlags.STDERR_PIPE
            )
        except GLib.Error as e:
            self._anotar_calentado(f"no pude correr qm: {str(e).replace(chr(10), ' ')[:110]}")
            self.programar_calentado()
            return False
        self.calentando = True
        self.calentando_desde = GLib.get_monotonic_time()
        proc.communicate_utf8_async(None, None, self._fin_calentado)
        return False

    def _anotar_calentado(self, fallo: str | None) -> None:
        """La falla del calentado, anotada cuando CAMBIA y con su vuelta."""
        if fallo == self._fallo_calentado:
            return
        if fallo is not None:
            registrar("calentar.fallo", motivo=fallo)
        else:
            registrar("calentar.volvio")
        self._fallo_calentado = fallo

    def _fin_calentado(self, proc, resultado) -> None:
        self.calentando = False
        self.calentando_desde = None
        fallo, dicho = None, ""
        try:
            _, _, dicho = proc.communicate_utf8_finish(resultado)
        except GLib.Error as e:
            # Se sigue mostrando lo viejo, con su edad a la vista — pero ahora
            # queda anotado POR QUÉ quedó viejo. Este `except` se tragaba la
            # única pista de que el refresco no estaba pasando.
            fallo = str(e).replace("\n", " ")[:120]
        else:
            # Y acá estaba el agujero: NADA de esto tira. `wait_finish` y
            # `communicate_utf8_finish` devuelven bien con el hijo saliendo 1
            # —medido: exit=1, sin excepción—, así que el código de salida hay
            # que mirarlo a mano. Un `qm --calentar` que salía 1 no dejaba una
            # sola línea. Es justo lo que pasó en 0.1.9, cuando la barra mandaba
            # `--cuentas=personal` y el CLI comparaba `.claude-personal`: en
            # macOS se vio en el log y acá no había log que ver.
            if not proc.get_if_exited():
                fallo = f"lo mató la señal {proc.get_term_sig()}"
            elif proc.get_exit_status() != 0:
                primera = [l.strip() for l in (dicho or "").splitlines() if l.strip()]
                fallo = f"salió {proc.get_exit_status()}"
                if primera:
                    fallo += f": {primera[0][:110]}"
        self._ultimo_calentado = GLib.get_monotonic_time()
        self._vigia_avisado = False
        self._anotar_calentado(fallo)
        # Los motivos por cuenta van aunque el calentado haya salido 0: que una
        # cuenta no se pueda calentar no hace fallar a las otras, y sin esto la
        # única pista de que esa cuenta quedó afuera es un número viejo.
        for m in [l.strip() for l in (dicho or "").splitlines() if l.strip()]:
            if m not in self._motivos_calentado:
                self._motivos_calentado.add(m)
                registrar("calentar.cuenta", motivo=m[:110])
        self.refrescar()

    def disparar(self) -> bool:
        self.pendiente = None
        self.refrescar()
        return False

    # Datos -----------------------------------------------------------------
    def leer(self) -> dict | str:
        return leer_qm(self.qm)

    # Dibujo ----------------------------------------------------------------
    def refrescar(self) -> bool:
        datos = self.leer()
        # `leer_qm` devuelve una FRASE cuando no pudo: se muestra en el menú y
        # hasta acá no quedaba escrita en ningún lado. Si qm falla a las tres de
        # la mañana, mañana no hay forma de saber por qué.
        if isinstance(datos, str):
            if datos != self._fallo_lectura:
                registrar("qm.sin-datos", motivo=datos[:110])
            if self._fallo_lectura_desde is None:
                self._fallo_lectura_desde = time.time()
            self._fallo_lectura = datos
        else:
            # La caída ya se anotaba; la VUELTA no, y sin ella toda falla queda
            # abierta para siempre. Leyendo el journal al otro día no había
            # forma de saber si qm estuvo caído un minuto o toda la noche, que
            # es justo lo que se va a buscar. Con el rato que duró, que es el
            # número que contesta esa pregunta.
            if self._fallo_lectura is not None:
                registrar("qm.volvio", tras=duracion(int(time.time() - (self._fallo_lectura_desde or time.time()))))
            self._fallo_lectura = None
            self._fallo_lectura_desde = None
        self.datos = datos
        for hijo in self.menu.get_children():
            self.menu.remove(hijo)

        # El menú es tres renglones y nada más. Antes repetía cada perfil con
        # cada barra en bloques `█░`, que es lo único que GNOME sabe dibujar
        # acá adentro —la extensión manda los items por DBus y del otro lado
        # hace label.set_text(), texto pelado— y era justamente lo que el panel
        # vino a reemplazar. Un muro de texto feo delante del dibujo bueno es
        # peor que no tener menú.
        abrir = Gtk.MenuItem(label="Panel de cuota      ·      click del medio")
        abrir.connect("activate", lambda _: self.abrir_panel())
        self.menu.append(abrir)
        # El click del medio abre el panel sin pasar por el menú, que es lo más
        # parecido al click único de macOS que deja hacer GNOME (el izquierdo se
        # lo queda la extensión para el menú, y el AboutToShow que manda ni
        # siquiera llega hasta acá).
        #
        # El objetivo tiene que ser un item que VIVA dentro del menú y esté
        # visible: con un widget suelto, libayatana descarta el evento sin decir
        # nada. Y como el menú se reconstruye en cada refresco, hay que volver a
        # apuntarlo cada vez o el click deja de hacer efecto en silencio.
        abrir.show()
        self.ind.set_secondary_activate_target(abrir)

        if isinstance(datos, str):
            # Un estado que no produce número tiene que producir una frase.
            self.ind.set_label("qm ?", "qm")
            self.ind.set_icon_full(ICONO_AVISO, "qm sin datos")
            self.item(datos)
        else:
            self.pintar(datos)

        # «Actualizar» ya está adentro del panel, que es donde se mira el
        # número: repetirlo acá sólo agrega un renglón que hay que saltear.
        self.menu.append(Gtk.SeparatorMenuItem())
        salir = Gtk.MenuItem(label="Salir")
        salir.connect("activate", lambda _: Gtk.main_quit())
        self.menu.append(salir)
        self.menu.show_all()
        if self.panel.abierto:
            self.panel.mostrar(datos)
        self.programar_calentado()
        return True

    def abrir_panel(self) -> None:
        """Un respiro antes de abrir.

        Cuando esto lo dispara el renglón «Panel de cuota» del menú de GNOME, el
        click que lo activó todavía no terminó: el shell está cerrando su propio
        menú y soltando su agarre, y el button-release de ese mismo click llega
        DESPUÉS de que nuestro menú ya se agarró el puntero. Un menú de GTK
        interpreta ese release como «soltaron afuera» y se cierra en el acto —
        desde afuera se ve como que el panel parpadea y desaparece sin que
        puedas hacer nada.

        Esperar a que el evento original se consuma lo arregla. No se nota:
        menos de dos décimas.
        """
        if self.apertura_pendiente is not None:
            GLib.source_remove(self.apertura_pendiente)
        self.apertura_pendiente = GLib.timeout_add(180, self._abrir_ya)

    def _abrir_ya(self) -> bool:
        self.apertura_pendiente = None
        self.panel.alternar(self.datos)
        return False

    def item(self, texto: str) -> None:
        it = Gtk.MenuItem(label=texto)
        it.set_sensitive(False)
        self.menu.append(it)

    def pintar(self, datos: dict) -> None:
        piezas = piezas_de(datos, self.revisar_avisos)
        self.piezas = piezas
        techos = []
        for p in datos.get("perfiles", []):
            proy = p.get("proyeccion") or {}
            if proy.get("estado") == "sube" and proy.get("chocasAntesDelReinicio"):
                seg = faltan(proy.get("techo"))
                if seg is not None:
                    techos.append(seg / 60)
        self.minutos_al_techo = min(techos) if techos else None
        if not piezas:
            # Sin una sola cuenta con número no hay nada que medir, y un dibujo
            # vacío sería un item mudo. Ahí sí sirve el ícono con nombre.
            self.ind.set_label("sin cuota", "qm")
            self.ind.set_icon_full(ICONO_AVISO, "sin cuota")
            return

        # Cada refresco estrena nombre de archivo, con un sello del reloj.
        #
        # El shell cachea la textura por ruta y sólo suelta la entrada vieja
        # cuando su propio GFileMonitor le avisa que el archivo cambió: ese
        # aviso llega DESPUÉS de que la extensión ya leyó estado.json y pintó,
        # y no vuelve a pintar solo. Reescribir siempre la misma ruta dejaba el
        # item clavado en el dibujo viejo —parecía que la cuota no se mueve—,
        # pero turnarse entre DOS nombres tampoco alcanza: uno de cada dos
        # refrescos vuelve a caer sobre una ruta que el cache ya tiene.
        #
        # Del lado del usuario eso se veía como que los números cambian cuando
        # le pasás el mouse por arriba. No los cambia el hover: el hover
        # recalcula el estilo, obliga a releer el archivo y recién ahí aparece
        # la cifra de verdad, que estuvo tapada todo el tiempo por el dibujo
        # cacheado. Una ruta que el shell nunca vio no puede tener una entrada
        # vieja en el cache, así que el sello va en el nombre.
        sello = sello_nuevo()
        destino = self.iconos / f"barra-{sello}.png"
        try:
            self.iconos.mkdir(parents=True, exist_ok=True)
            ancho, alto, descripcion = dibujar_item(piezas, str(destino))
        except (OSError, MemoryError) as e:
            self.ind.set_icon_full(ICONO_AVISO, f"no pude dibujar el item: {e}")
            return
        # El dibujo ya dice todo lo que decía el texto. Dejar los dos es repetir
        # el mismo número en dos idiomas y ocupar el doble de barra.
        self.ind.set_label("", "")
        self.ind.set_icon_full(str(destino), descripcion)
        self.publicar(destino, ancho, alto, descripcion, sello)

    def publicar(self, ruta: Path, ancho: int, alto: int, descripcion: str,
                 sello: int) -> None:
        """Deja escrito qué dibujó, para la extensión de GNOME Shell."""
        panel = {}
        try:
            # Mismo sello que el item, y por lo mismo: sin un nombre que el
            # shell nunca haya visto, el panel que se abre es el de hace un rato.
            destino = self.iconos / f"panel-{sello}.png"
            # Un nombre propio, y no `alto` otra vez: pisar el parámetro dejaba
            # escrito que el ICONO de la barra medía lo que mide el PANEL —
            # 576 px de alto para un dibujo de 22. La extensión le cree al
            # archivo y arma el item de ese tamaño.
            alto_panel = capturar(self.datos, str(destino), self.falta_para_lectura())
            panel = {"panel": str(destino), "panelAncho": ANCHO_PANEL, "panelAlto": alto_panel}
        except (OSError, MemoryError):
            pass  # sin panel dibujado la extensión sigue mostrando el item
        try:
            ESTADO.write_text(json.dumps({
                "icono": str(ruta), "ancho": ancho, "alto": alto,
                "descripcion": descripcion, **panel,
            }))
        except OSError:
            pass  # sin extensión instalada esto no le importa a nadie
        self.barrer()

    def barrer(self) -> None:
        """Borra los dibujos que ya nadie mira.

        Como el nombre lleva un sello y no se repite nunca, sin esto el
        directorio de cache junta un PNG por refresco para siempre. El panel
        pesa ~100 kB, así que no es una molestia teórica.
        """
        for prefijo in ("barra", "panel"):
            try:
                # Por (largo, texto) y no alfabético a secas: el sufijo es un
                # número, y así `barra-0.png` de una versión vieja queda
                # primero en vez de colarse entre los sellos.
                viejos = sorted(self.iconos.glob(f"{prefijo}-*.png"),
                                key=lambda p: (len(p.stem), p.stem))
            except OSError:
                continue
            for viejo in viejos[:-DIBUJOS_QUE_QUEDAN]:
                try:
                    viejo.unlink()
                except OSError:
                    pass  # el próximo barrido lo vuelve a intentar

    def revisar_avisos(self, perfil: str, ventanas: list, frena: dict | None,
                       proy: dict | None, chocas: bool) -> None:
        for v in ventanas:
            nombre = nombre_ventana(v)
            minuto = al_minuto(v.get("reinicia"))
            pct = v["porcentaje"]
            # El reinicio va en la clave: cuando la ventana se reinicia, el
            # mismo umbral vuelve a poder avisar. Va redondeado al minuto porque
            # el servidor manda microsegundos y no siempre los mismos entre
            # lecturas (se vieron .117894 y .118092 en la misma respuesta): con
            # el valor crudo, cada jitter estrena clave y vuelve a notificar lo
            # mismo.
            base = f"{perfil}|{nombre}|{minuto}"
            for u in UMBRALES:
                if pct >= u:
                    seg = faltan(v.get("reinicia"))
                    cola = f" Se reinicia en {duracion(seg)}." if seg is not None else ""
                    self.avisos.avisar(
                        f"{base}|{u}",
                        f"{perfil}: {pct:.0f}% de {nombre}",
                        f"Pasaste el {u}%.{cola}",
                        urgente=u >= 95,
                    )
            self.revisar_liberada(perfil, nombre, minuto, pct)

        if chocas and proy and frena:
            seg = faltan(proy["techo"])
            self.avisos.avisar(
                f"{perfil}|{nombre_ventana(frena)}|{al_minuto(frena.get('reinicia'))}|choque",
                f"{perfil}: a este ritmo llegás al 100%",
                f"{proy['ritmoPuntosPorHora']:.1f} pts/h — tocás el techo en "
                f"{duracion(faltan(proy['techo']) or 0)}, antes de que la ventana se reinicie.",
                urgente=True,
            )
        self.previos.guardar()

    def revisar_liberada(self, perfil: str, nombre: str, minuto: str, pct: float) -> None:
        """El aviso que faltaba: ya podés volver a trabajar.

        Todo lo demás avisa cuando subís. Este avisa cuando la ventana se
        reinicia habiendo estado contra el techo, que es el único momento en
        que la noticia sirve para hacer algo distinto ahora mismo — y es
        justamente cuando dejaste de mirar la barra, porque no había nada que
        mirar.
        """
        antes = self.previos.ver_y_guardar(f"{perfil}|{nombre}", minuto, pct)
        if antes is None:
            return
        minuto_antes, pct_antes = antes
        if minuto == minuto_antes or pct_antes < 80 or pct >= pct_antes:
            return
        self.avisos.notificar(
            f"{perfil}: se reinició {nombre}",
            f"Estabas {pct_antes:.0f} % y ahora vas {pct:.0f} %.",
            urgente=False,
        )


NOMBRE_BUS = "ai.legios.quartermaster"
_nombre_tomado = None


def soy_el_unico() -> bool:
    """Un indicador por sesión, y el segundo se va.

    Sin esto, arrancarlo dos veces —el arranque automático más un `make
    indicador` a mano, que es lo más fácil del mundo— deja DOS items en la
    barra, abre DOS paneles con un solo click, y los dos procesos se pisan
    escribiendo el mismo PNG y el mismo estado.json. Medido, no supuesto.

    El candado es un nombre en el bus de sesión y no un archivo: si el proceso
    muere de cualquier forma, el bus suelta el nombre solo. Un archivo con el
    PID hay que limpiarlo, y nunca se limpia en el caso que importa.
    """
    global _nombre_tomado
    resultado = {"mio": None}
    bucle = GLib.MainLoop()

    def adquirido(*_):
        resultado["mio"] = True
        bucle.quit()

    def perdido(*_):
        resultado["mio"] = False
        bucle.quit()

    _nombre_tomado = Gio.bus_own_name(
        Gio.BusType.SESSION, NOMBRE_BUS, Gio.BusNameOwnerFlags.DO_NOT_QUEUE,
        None, adquirido, perdido)
    # Si el bus no contesta, seguir es mejor que quedarse esperando para siempre.
    GLib.timeout_add_seconds(3, lambda: (bucle.quit(), False)[1])
    bucle.run()
    return resultado["mio"] is not False


def buscar_qm() -> str | None:
    """qm en el PATH; si no, el hermano de este archivo.

    El arranque automático de la sesión no pasa por el .zshrc del usuario, así
    que ~/.local/bin puede no estar en el PATH ahí aunque sí lo esté en una
    terminal. El hermano siempre está donde este script.
    """
    encontrado = shutil.which("qm")
    if encontrado:
        return encontrado
    vecino = Path(__file__).resolve().parent / "qm"
    return str(vecino) if vecino.is_file() else None


def leer_desde(ruta: str) -> dict:
    """El JSON de un archivo en vez del de qm.

    Existe para el gate de dibujo: con una entrada fija, lo que sale es
    comparable entre corridas y entre máquinas. Si el archivo no se puede leer
    se levanta, no se devuelve una frase: una frase se dibujaría como un panel
    chiquito y perfectamente válido, y el gate lo daría por bueno.
    """
    return json.loads(pathlib.Path(ruta).read_text())


ARRANQUE = Path(os.environ.get("XDG_CONFIG_HOME", str(Path.home() / ".config"))) \
    / "autostart" / "quartermaster.desktop"


def instalar_arranque() -> int:
    """Que el item arranque solo al iniciar sesión.

    Vive acá y no sólo en el Makefile porque quien instaló por apt o por npm no
    tiene un Makefile: el .deb deja bin/qm-indicator en /usr/lib/quartermaster y
    nada más, así que el item quedaba a un comando que hay que saber. Es el
    mismo agujero que en macOS tapó `qm-barra --instalar-arranque`, y `qm` lo
    ofrece en la primera corrida por el mismo camino.

    El Exec apunta a ESTE archivo resuelto, no a `qm-indicator` a secas: el
    arranque de la sesión no pasa por el .zshrc del usuario, así que ~/.local/bin
    puede no estar en su PATH.
    """
    try:
        ARRANQUE.parent.mkdir(parents=True, exist_ok=True)
        ARRANQUE.write_text(
            "[Desktop Entry]\n"
            "Type=Application\n"
            "Name=quartermaster\n"
            "Comment=Cuota de Claude Code en la barra de arriba\n"
            f"Exec={YO}\n"
            "Icon=utilities-system-monitor-symbolic\n"
            "Terminal=false\n"
            "X-GNOME-Autostart-enabled=true\n",
            encoding="utf-8")
    except OSError as e:
        print(f"no pude escribir {ARRANQUE}: {e}", file=sys.stderr)
        return 1
    print(f"{ARRANQUE} escrito")
    return 0


def quitar_arranque() -> int:
    """Lo contrario, porque instalar sin poder desinstalar no es una opción."""
    try:
        ARRANQUE.unlink()
    except FileNotFoundError:
        print(f"{ARRANQUE} no estaba")
        return 0
    except OSError as e:
        print(f"no pude borrar {ARRANQUE}: {e}", file=sys.stderr)
        return 1
    print(f"{ARRANQUE} borrado")
    return 0


EXTENSION_UUID = "quartermaster@legios"
EXTENSIONES = Path(os.environ.get("XDG_DATA_HOME", str(Path.home() / ".local/share"))) \
    / "gnome-shell" / "extensions"
#: De dónde sale la extensión: al lado del paquete, sea un clone, el .deb o npm.
EXTENSION_RAIZ = YO.parent.parent / "extension"


def fuente_extension() -> Path:
    """Cuál de las dos copias de la extensión corresponde a este GNOME.

    GNOME 45 cambió la forma de cargar extensiones —módulos ESM y una clase que
    extiende Extension— y la 43 y la 44 usan `imports.gi` con una función
    `init()` suelta. No son dos sintaxis que convivan en un archivo, así que el
    mismo item vive dos veces y acá se elige.

    Importa en Debian 12, que trae la 43 y va a seguir soportada años. Instalar
    ahí la de 45 deja la extensión en ERROR, el item cae al camino de
    AppIndicator, y entonces pasan las dos cosas que esta extensión existe para
    evitar: el medidor entra en una casilla cuadrada de 16 px y se ve minúsculo,
    y el click se lo queda el menú del shell, que le rompe el agarre al menú de
    GTK — el panel aparece y desaparece en el mismo instante.

    Se pregunta acá y no en el Makefile porque quien instaló por npm o por apt
    no tiene un Makefile, que es la misma razón por la que la instalación entera
    se mudó a este archivo. Sin poder saber la versión se elige la nueva, que es
    la que corresponde a todo lo que no sea Debian estable.
    """
    vieja = EXTENSION_RAIZ / "gnome43" / EXTENSION_UUID
    if _shell_es_vieja() and vieja.is_dir():
        return vieja
    return EXTENSION_RAIZ / EXTENSION_UUID


def _shell_es_vieja() -> bool:
    """GNOME 44 o anterior. False si no se puede saber."""
    try:
        dicho = subprocess.run(["gnome-shell", "--version"], capture_output=True,
                               text=True, timeout=5, check=True).stdout
    except (OSError, subprocess.SubprocessError):
        return False
    numeros = "".join(c if c.isdigit() else " " for c in dicho).split()
    return bool(numeros) and int(numeros[0]) <= 44


def _habilitadas() -> list[str] | None:
    """La lista de `enabled-extensions`, o None si no hay gsettings."""
    try:
        dicho = subprocess.run(
            ["gsettings", "get", "org.gnome.shell", "enabled-extensions"],
            capture_output=True, text=True, timeout=5, check=True).stdout.strip()
    except (OSError, subprocess.SubprocessError):
        return None
    # `@as []` para la lista vacía, `['a', 'b']` para el resto.
    if dicho.startswith("@as"):
        dicho = dicho[3:].strip()
    return [x.strip().strip("'\"") for x in dicho.strip("[]").split(",") if x.strip()]


def instalar_extension() -> int:
    """El item propio en la barra: un click abre el panel.

    Sin ella el item lo hospeda AppIndicator y el click izquierdo cae al menú de
    GTK, que no sostiene el agarre y se cierra apenas lo tocás — el síntoma que
    la extensión existe para evitar, escrito en su propio extension.js.

    Vive acá y no sólo en el Makefile por lo mismo que `--instalar-arranque`:
    quien instaló por npm o por apt no tiene un Makefile.

    Salidas: 0 habilitada y andando ya, 2 instalada pero GNOME la carga recién
    en la próxima sesión, 1 no se pudo. El 2 no es un error y no se puede
    esconder: decir «listo» de algo que no se ve hasta cerrar sesión es
    exactamente la mentira que este programa no comete.
    """
    fuente = fuente_extension()
    if not fuente.is_dir():
        print(f"no encuentro la extensión en {fuente}", file=sys.stderr)
        return 1
    destino = EXTENSIONES / EXTENSION_UUID
    try:
        EXTENSIONES.mkdir(parents=True, exist_ok=True)
        if destino.exists():
            shutil.rmtree(destino)
        shutil.copytree(fuente, destino)
    except OSError as e:
        print(f"no pude copiarla a {destino}: {e}", file=sys.stderr)
        return 1

    # Anotarla en la lista de habilitadas ANTES de pedir el enable: en Wayland
    # GNOME no carga una extensión recién copiada, así que `gnome-extensions
    # enable` falla con «doesn't exist» y sin esta anotación no quedaría puesta
    # tampoco para la próxima sesión.
    lista = _habilitadas()
    if lista is not None and EXTENSION_UUID not in lista:
        nueva = "[" + ", ".join(f"'{x}'" for x in [*lista, EXTENSION_UUID]) + "]"
        try:
            subprocess.run(["gsettings", "set", "org.gnome.shell", "enabled-extensions", nueva],
                           capture_output=True, timeout=5, check=True)
        except (OSError, subprocess.SubprocessError) as e:
            print(f"no pude anotarla en enabled-extensions: {e}", file=sys.stderr)
            return 1

    try:
        ok = subprocess.run(["gnome-extensions", "enable", EXTENSION_UUID],
                            capture_output=True, timeout=5).returncode == 0
    except OSError:
        ok = False
    if ok:
        print(f"{EXTENSION_UUID} habilitada")
        return 0
    print(f"{EXTENSION_UUID} instalada y anotada. GNOME no carga extensiones "
          "nuevas en Wayland: cerrá sesión y volvé a entrar una vez.")
    return 2


def quitar_extension() -> int:
    """Saca el item propio y devuelve el de AppIndicator."""
    try:
        subprocess.run(["gnome-extensions", "disable", EXTENSION_UUID],
                       capture_output=True, timeout=5)
    except OSError:
        pass
    destino = EXTENSIONES / EXTENSION_UUID
    try:
        if destino.exists():
            shutil.rmtree(destino)
        (CACHE / "extension-viva").unlink(missing_ok=True)
    except OSError as e:
        print(f"no pude borrarla: {e}", file=sys.stderr)
        return 1
    print(f"{EXTENSION_UUID} quitada")
    return 0


def main() -> int:
    # Antes que nada: ninguna de las dos necesita sesión gráfica ni un qm en el
    # PATH, y `qm` llama a la primera desde una terminal.
    if "--instalar-arranque" in sys.argv:
        return instalar_arranque()
    if "--quitar-arranque" in sys.argv:
        return quitar_arranque()
    if "--instalar-extension" in sys.argv:
        return instalar_extension()
    if "--quitar-extension" in sys.argv:
        return quitar_extension()

    fijo = None
    if "--desde" in sys.argv:
        i = sys.argv.index("--desde")
        if i + 1 >= len(sys.argv):
            print("--desde necesita una ruta", file=sys.stderr)
            return 1
        fijo = sys.argv[i + 1]

    qm = buscar_qm()
    if qm is None and fijo is None:
        print("qm no está en el PATH. Corré `make instalar` en el repo.", file=sys.stderr)
        return 1
    global TEMA, FAMILIA
    try:
        CACHE.mkdir(parents=True, exist_ok=True)
    except OSError:
        pass
    alinear_tema_gtk()
    TEMA = tema_actual()
    FAMILIA = familia_del_sistema()
    if "--claro" in sys.argv:
        TEMA = Tema(False)
    if "--oscuro" in sys.argv:
        TEMA = Tema(True)

    # `--captura ruta.png` dibuja el panel y sale. Es la forma de revisar un
    # cambio de dibujo sin tener que abrir la barra y sacar una foto.
    for bandera, dibujo in (("--captura", "panel"), ("--captura-item", "item")):
        if bandera not in sys.argv:
            continue
        i = sys.argv.index(bandera)
        if i + 1 >= len(sys.argv):
            print(f"{bandera} necesita una ruta", file=sys.stderr)
            return 1
        try:
            datos = leer_desde(fijo) if fijo is not None else leer_qm(qm)
        except (OSError, json.JSONDecodeError) as e:
            print(f"no pude leer {fijo}: {e}", file=sys.stderr)
            return 1
        if dibujo == "panel":
            capturar(datos, sys.argv[i + 1])
        else:
            dibujar_item(piezas_de(datos), sys.argv[i + 1])  # devuelve medidas, no se usan acá
        print(sys.argv[i + 1])
        return 0

    if not soy_el_unico():
        print("ya hay un quartermaster corriendo en esta sesión.", file=sys.stderr)
        return 0

    # La primera línea del journal la pone systemd y dice el scope, no dice
    # QUÉ arrancó: ni qué qm encontró —puede haber uno en ~/.local/bin y otro
    # del paquete—, ni con qué tema, ni con qué pid. Leyendo el log de ayer eso
    # es lo primero que hace falta. La barra de macOS lo anota desde 0.1.8.
    registrar("arranca", qm=qm, pid=os.getpid(), tema="oscuro" if TEMA.oscuro else "claro")
    Indicador(qm)
    Gtk.main()
    return 0


if __name__ == "__main__":
    sys.exit(main())
