#!/bin/sh
# Lanzador de qm.
#
# Existe por una razón concreta: qm se lee directo del TypeScript, y eso pide
# Node >= 22.6. En una máquina donde `node` es un 20 —lo normal si el sistema
# trae uno y las versiones nuevas viven en nvm, que sólo se carga en shells
# interactivos— el shebang de siempre falla con un error de sintaxis que no le
# dice nada a nadie. Así que acá se busca un Node que sirva antes de arrancar.
#
# Orden: $QM_NODE, el del PATH, y después lo que hayan guardado los manejadores
# de versiones —nvm, fnm y volta— de mayor a menor.

set -e

sirve() {
  [ -x "$1" ] || return 1
  v=$("$1" -e 'const [a,b]=process.versions.node.split(".").map(Number); process.stdout.write(a>22||(a===22&&b>=6)?"si":"no")' 2>/dev/null) || return 1
  [ "$v" = "si" ]
}

NODO=""

# Cada manejador de versiones guarda los Node con una forma distinta:
#
#   nvm     $NVM_DIR/versions/node/v22.22.2/bin/node
#   fnm     $FNM_DIR/node-versions/v22.22.2/installation/bin/node
#   volta   $VOLTA_HOME/tools/image/node/22.22.2/bin/node
#
# Se recorren de mayor a menor VERSIÓN y no alfabéticamente, para que v9 no le
# gane a v22. La `v` del nombre se saca antes de ordenar porque volta no la
# pone, y después se prueban las dos formas del nombre.
#
# Acá faltaban fnm y volta, y el README decía que estaban. Se notó de la peor
# manera posible: el indicador de GNOME arranca desde el autostart, que NO tiene
# el PATH de un shell interactivo —ahí es donde fnm se carga—, así que no
# encontraba Node, se quedaba mostrando los números de la sesión anterior, y lo
# único que lo decía era un renglón en el journal.
buscar_en() {
  raiz=$1
  medio=$2
  [ -d "$raiz" ] || return 1
  for d in $(ls -1 "$raiz" 2>/dev/null | sed 's/^v//' | sort -t. -k1,1n -k2,2n -k3,3n -r); do
    for nombre in "v$d" "$d"; do
      if sirve "$raiz/$nombre$medio"; then
        NODO="$raiz/$nombre$medio"
        return 0
      fi
    done
  done
  return 1
}

if [ -n "$QM_NODE" ] && sirve "$QM_NODE"; then
  NODO="$QM_NODE"
elif sirve "$(command -v node 2>/dev/null)"; then
  NODO="$(command -v node)"
else
  buscar_en "${NVM_DIR:-$HOME/.nvm}/versions/node" "/bin/node" \
    || buscar_en "${FNM_DIR:-$HOME/.local/share/fnm}/node-versions" "/installation/bin/node" \
    || buscar_en "$HOME/Library/Application Support/fnm/node-versions" "/installation/bin/node" \
    || buscar_en "${VOLTA_HOME:-$HOME/.volta}/tools/image/node" "/bin/node" \
    || true
fi

# `src/adapters/opencode.ts` usa node:sqlite, que es experimental, así que Node
# escribe DOS renglones en stderr en cada corrida de qm:
#
#   (node:56893) ExperimentalWarning: SQLite is an experimental feature…
#   (Use `node --trace-warnings ...` to show where the warning was created)
#
# Eso no es un mensaje de qm y no es para quien lo corre, pero sale por el mismo
# canal por el que qm explica las cosas: desde 0.1.8 `qm --calentar` dice por ahí
# por qué una cuenta no se calentó, y la barra de macOS y el indicador de GNOME
# anotan esos renglones en el log. Medido el 2026-09-14 con Node 22 en Debian:
# el journal del indicador quedaba con dos renglones de warning por cada pid de
# node, y el motivo de verdad enterrado entre ellos. Un monitor cuyo canal de
# explicaciones viene con ruido de fábrica no se puede leer.
#
# Se apaga SÓLO esa clase de warning, no todas: una deprecación de verdad tiene
# que seguir saliendo. La bandera existe desde Node 21.3 y el piso de este repo
# es 22.6, así que siempre está.
SIN_EXPERIMENTAL="--disable-warning=ExperimentalWarning"

if [ -z "$NODO" ]; then
  echo "qm necesita Node >= 22.6 y no encontré ninguno." >&2
  echo "Lee TypeScript sin paso de build, y eso recién existe desde 22.6." >&2
  echo "" >&2
  echo "  nvm install 22        # o fnm install 22, o como prefieras" >&2
  echo "  QM_NODE=/ruta/a/node qm   # o decile cuál usar" >&2
  exit 1
fi

# La ruta real de este script, siguiendo symlinks: se instala enlazado desde
# ~/.local/bin y necesita encontrar el src/ del repo igual.
AQUI=$0
while [ -L "$AQUI" ]; do
  DESTINO=$(readlink "$AQUI")
  case $DESTINO in
    /*) AQUI=$DESTINO ;;
    *) AQUI=$(dirname "$AQUI")/$DESTINO ;;
  esac
done
RAIZ=$(cd "$(dirname "$AQUI")/.." && pwd)

# dist/ si está, src/ si no. No es una optimización: Node se NIEGA a hacer type
# stripping de archivos bajo node_modules, y un `npm install -g` deja el paquete
# justo ahí. El tarball de npm lleva dist/ y ninguna de las otras vías lo lleva,
# así que un clone, `make instalar`, el .deb y brew siguen leyendo el TypeScript
# directo como siempre.
if [ -f "$RAIZ/dist/cli/qm.js" ]; then
  # Un dist/ viejo TAPA al src/ en silencio. Se edita el TypeScript, se corre
  # qm, no cambia nada, y no hay un solo aviso de por qué: `dist/` está en el
  # .gitignore, así que queda de una corrida anterior y nadie se acuerda.
  #
  # Pasó, y costó: `qm --diagnostico` contestaba «opción desconocida» con la
  # bandera ya mergeada en main, porque el dist/ del disco era de diez horas
  # antes.
  #
  # Sólo se comprueba cuando hay un src/ al lado: el tarball de npm no lleva
  # src/cli, así que quien instaló por npm no tiene nada que reconstruir y no
  # tiene por qué ver esto. Y avisa, no falla — el dist/ igual funciona, sólo
  # que no es lo que está escrito.
  if [ -f "$RAIZ/src/cli/qm.ts" ] && [ "$RAIZ/src/cli/qm.ts" -nt "$RAIZ/dist/cli/qm.js" ] 2>/dev/null; then
    echo "qm: dist/ es más viejo que src/, y dist/ es el que se ejecuta." >&2
    echo "    Tus cambios en src/ NO se están viendo. Corré \`npm run construir\`," >&2
    echo "    o borrá dist/ para volver a leer el TypeScript directo." >&2
  fi
  exec "$NODO" $SIN_EXPERIMENTAL "$RAIZ/dist/cli/qm.js" "$@"
fi

exec "$NODO" $SIN_EXPERIMENTAL "$RAIZ/src/cli/qm.ts" "$@"
